@@ -0,0 +1,370 @@
+//! The shell around OxiCloud's verified kernel (`oxicloud-kernel`, proven in
+//! Lean in h5i-app-bench). For one decision it reads the rows the kernel's
+//! scans can match from PostgreSQL into the kernel's `Db`, then lets
+//! `oxicloud_kernel::acl::check` decide. The `lpath` trigger, the effective
+//! policy view and its JSON decoding stay in the database and here.
+
+use std::collections::HashMap;
+use std::convert::Infallible;
+
+use h5i_app::{Kernel, TenantId};
+use oxicloud_kernel::{acl, model as k};
+use sqlx::PgPool;
+use uuid::Uuid;
+
+use crate::common::errors::DomainError;
+use crate::domain::entities::drive::DrivePolicies;
+use crate::domain::entities::subject_group::INTERNAL_GROUP_ID;
+use crate::domain::services::authorization::{Permission, Resource, Role, Subject};
+
+/// UUIDs as the kernel's `u64` ids, for one decision. The internal group is 1.
+pub(crate) struct Ids {
+    to: HashMap<Uuid, u64>,
+    from: Vec<Uuid>,
+}
+
+impl Ids {
+    fn new() -> Self {
+        let mut to = HashMap::new();
+        to.insert(INTERNAL_GROUP_ID, acl::INTERNAL_GROUP_ID);
+        Ids {
+            to,
+            from: vec![Uuid::nil(), INTERNAL_GROUP_ID],
+        }
+    }
+
+    fn id(&mut self, u: Uuid) -> u64 {
+        if let Some(&i) = self.to.get(&u) {
+            return i;
+        }
+        let i = self.from.len() as u64;
+        self.from.push(u);
+        self.to.insert(u, i);
+        i
+    }
+
+    fn uuid(&self, i: u64) -> Uuid {
+        self.from[i as usize]
+    }
+
+    fn subject(&mut self, s: Subject) -> k::Subject {
+        match s {
+            Subject::User(u) => k::Subject::User(self.id(u)),
+            Subject::Group(u) => k::Subject::Group(self.id(u)),
+            Subject::Token(u) => k::Subject::Token(self.id(u)),
+        }
+    }
+
+    fn resource(&mut self, r: Resource) -> k::Resource {
+        match r {
+            Resource::Folder(u) => k::Resource::Folder(self.id(u)),
+            Resource::File(u) => k::Resource::File(self.id(u)),
+            Resource::Drive(u) => k::Resource::Drive(self.id(u)),
+            Resource::Calendar(u) => k::Resource::Calendar(self.id(u)),
+            Resource::AddressBook(u) => k::Resource::AddressBook(self.id(u)),
+            Resource::Playlist(u) => k::Resource::Playlist(self.id(u)),
+        }
+    }
+}
+
+pub(crate) fn permission(p: Permission) -> k::Permission {
+    match p {
+        Permission::Read => k::Permission::Read,
+        Permission::Create => k::Permission::Create,
+        Permission::Share => k::Permission::Share,
+        Permission::Comment => k::Permission::Comment,
+        Permission::Delete => k::Permission::Delete,
+        Permission::Update => k::Permission::Update,
+        Permission::Manage => k::Permission::Manage,
+    }
+}
+
+pub(crate) fn role(r: Role) -> k::Role {
+    match r {
+        Role::Owner => k::Role::Owner,
+        Role::Editor => k::Role::Editor,
+        Role::Contributor => k::Role::Contributor,
+        Role::Commenter => k::Role::Commenter,
+        Role::Viewer => k::Role::Viewer,
+    }
+}
+
+fn db_err(what: &str, e: sqlx::Error) -> DomainError {
+    DomainError::internal_error("PgAcl", format!("{what}: {e}"))
+}
+
+/// The rows one decision reads, and the clock. Times are microseconds, the
+/// precision of `timestamptz`, so `expires_at > NOW()` compares exactly.
+pub(crate) struct Snapshot {
+    pub(crate) ids: Ids,
+    pub(crate) db: k::Db,
+    pub(crate) now: i64,
+}
+
+impl Snapshot {
+    fn empty() -> Self {
+        Snapshot {
+            ids: Ids::new(),
+            db: k::Db {
+                users: Vec::new(),
+                memberships: Vec::new(),
+                grants: Vec::new(),
+                drives: Vec::new(),
+                folders: Vec::new(),
+                files: Vec::new(),
+            },
+            now: 0,
+        }
+    }
+
+    /// `storage.folders` rows by id, with the `lpath` labels as ids.
+    async fn add_folders(&mut self, pool: &PgPool, ids: &[Uuid]) -> Result<(), DomainError> {
+        if ids.is_empty() {
+            return Ok(());
+        }
+        let rows: Vec<(Uuid, Uuid, String)> =
+            sqlx::query_as("SELECT id, drive_id, lpath::text FROM storage.folders WHERE id = ANY($1)")
+                .bind(ids)
+                .fetch_all(pool)
+                .await
+                .map_err(|e| db_err("load folders", e))?;
+        for (id, drive_id, lpath) in rows {
+            let mut path = Vec::new();
+            for label in lpath.split('.').filter(|l| !l.is_empty()) {
+                let u = Uuid::parse_str(&label.replace('_', "-"))
+                    .map_err(|e| DomainError::internal_error("PgAcl", format!("lpath label: {e}")))?;
+                path.push(self.ids.id(u));
+            }
+            let folder = k::Folder {
+                id: self.ids.id(id),
+                drive_id: self.ids.id(drive_id),
+                lpath: path,
+            };
+            if !self.db.folders.iter().any(|f| f.id == folder.id) {
+                self.db.folders.push(folder);
+            }
+        }
+        Ok(())
+    }
+
+    async fn add_drive(&mut self, pool: &PgPool, id: Uuid) -> Result<(), DomainError> {
+        let eff: Option<serde_json::Value> =
+            sqlx::query_scalar("SELECT effective_policies FROM storage.drives_effective WHERE id = $1")
+                .bind(id)
+                .fetch_optional(pool)
+                .await
+                .map_err(|e| db_err("load drive policies", e))?;
+        if let Some(eff) = eff {
+            let p = DrivePolicies::from_value(&eff);
+            self.db.drives.push(k::Drive {
+                id: self.ids.id(id),
+                // `check` does not read the kind.
+                kind: k::DriveKind::Shared,
+                policies: k::DrivePolicies {
+                    read_only: p.read_only,
+                    forbid_sharing: p.forbid_sharing,
+                    forbid_external_sharing: p.forbid_external_sharing,
+                    forbid_public_links: p.forbid_public_links,
+                    forbid_owner_role_change: p.forbid_owner_role_change,
+                },
+            });
+        }
+        Ok(())
+    }
+}
+
+/// Everything `acl::check(subject, _, resource)` can read: the caller's
+/// `auth.users` row and the membership table, the grants whose subject is
+/// in the caller's match set, the resource's file and folder rows, the
+/// folders those grants name, and the drive's effective policies.
+pub(crate) async fn load(
+    pool: &PgPool,
+    with_groups: bool,
+    subject: Subject,
+    resource: Resource,
+) -> Result<Snapshot, DomainError> {
+    let mut s = Snapshot::empty();
+    s.now = sqlx::query_scalar("SELECT (extract(epoch FROM NOW()) * 1000000)::bigint")
+        .fetch_one(pool)
+        .await
+        .map_err(|e| db_err("read clock", e))?;
+
+    if let Subject::User(uid) = subject {
+        let ext: Option<bool> = sqlx::query_scalar("SELECT is_external FROM auth.users WHERE id = $1")
+            .bind(uid)
+            .fetch_optional(pool)
+            .await
+            .map_err(|e| db_err("lookup is_external", e))?;
+        if let Some(is_external) = ext {
+            s.db.users.push(k::User {
+                id: s.ids.id(uid),
+                is_external,
+            });
+        }
+        if with_groups {
+            let rows: Vec<(Uuid, Option<Uuid>, Option<Uuid>)> = sqlx::query_as(
+                "SELECT group_id, member_user_id, member_group_id FROM auth.subject_group_members",
+            )
+            .fetch_all(pool)
+            .await
+            .map_err(|e| db_err("groups_for_user", e))?;
+            for (group, user, member_group) in rows {
+                let member = match (user, member_group) {
+                    (Some(u), _) => k::Member::User(s.ids.id(u)),
+                    (None, Some(g)) => k::Member::Group(s.ids.id(g)),
+                    (None, None) => continue,
+                };
+                let group_id = s.ids.id(group);
+                s.db.memberships.push(k::Membership { group_id, member });
+            }
+        }
+    }
+
+    let ksubject = s.ids.subject(subject);
+    let (types, ids) = acl::subject_match_set(&s.db, ksubject);
+    let types: Vec<&str> = types
+        .iter()
+        .map(|t| match t {
+            0 => "user",
+            1 => "group",
+            _ => "token",
+        })
+        .collect();
+    let ids: Vec<Uuid> = ids.iter().map(|i| s.ids.uuid(*i)).collect();
+    type Row = (Uuid, String, Uuid, String, Uuid, String, Uuid, Option<i64>);
+    let rows: Vec<Row> = sqlx::query_as(
+        "SELECT id, subject_type, subject_id, resource_type, resource_id, role::text, granted_by,
+                (extract(epoch FROM expires_at) * 1000000)::bigint
+           FROM storage.role_grants
+          WHERE subject_type = ANY($1) AND subject_id = ANY($2)",
+    )
+    .bind(&types)
+    .bind(&ids)
+    .fetch_all(pool)
+    .await
+    .map_err(|e| db_err("load grants", e))?;
+    let mut grant_folders = Vec::new();
+    for (id, st, sid, rt, rid, role_str, granted_by, expires_at) in rows {
+        let (Some(sub), Some(res), Some(r)) = (
+            Subject::from_parts(&st, sid),
+            Resource::from_parts(&rt, rid),
+            Role::parse(&role_str),
+        ) else {
+            continue;
+        };
+        if let Resource::Folder(f) = res {
+            grant_folders.push(f);
+        }
+        let g = k::Grant {
+            id: s.ids.id(id),
+            subject: s.ids.subject(sub),
+            resource: s.ids.resource(res),
+            role: role(r),
+            granted_by: s.ids.id(granted_by),
+            expires_at,
+        };
+        s.db.grants.push(g);
+    }
+
+    let mut folders = grant_folders;
+    let drive = match resource {
+        Resource::Folder(id) => {
+            folders.push(id);
+            sqlx::query_scalar::<_, Uuid>("SELECT drive_id FROM storage.folders WHERE id = $1")
+                .bind(id)
+                .fetch_optional(pool)
+                .await
+                .map_err(|e| db_err("folder drive", e))?
+        }
+        Resource::File(id) => {
+            let row: Option<(Uuid, Option<Uuid>)> =
+                sqlx::query_as("SELECT drive_id, folder_id FROM storage.files WHERE id = $1")
+                    .bind(id)
+                    .fetch_optional(pool)
+                    .await
+                    .map_err(|e| db_err("file drive", e))?;
+            row.map(|(drive_id, folder_id)| {
+                let file = k::File {
+                    id: s.ids.id(id),
+                    drive_id: s.ids.id(drive_id),
+                    folder_id: folder_id.map(|f| s.ids.id(f)),
+                };
+                s.db.files.push(file);
+                folders.extend(folder_id);
+                drive_id
+            })
+        }
+        Resource::Drive(id) => Some(id),
+        _ => None,
+    };
+    s.add_folders(pool, &folders).await?;
+    if let Some(d) = drive {
+        s.add_drive(pool, d).await?;
+    }
+    Ok(s)
+}
+
+/// `check_inner` as an h5i-app kernel: the snapshot is the rows above, the
+/// command one question. Nothing is written.
+pub(crate) struct AclCheck;
+
+#[derive(Clone)]
+pub(crate) struct Question {
+    pub(crate) migration_readonly: bool,
+    pub(crate) now: i64,
+    pub(crate) subject: k::Subject,
+    pub(crate) permission: k::Permission,
+    pub(crate) resource: k::Resource,
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct Tables(pub(crate) Option<k::Db>);
+
+impl Kernel for AclCheck {
+    type Principal = ();
+    type Snapshot = Tables;
+    type Command = Question;
+    type WriteSet = ();
+    type Reply = bool;
+    type Error = Infallible;
+
+    fn tenant(_: &()) -> TenantId {
+        TenantId(0)
+    }
+
+    fn transition(_: &(), snap: &Tables, q: &Question) -> Result<((), bool), Infallible> {
+        let allowed = match &snap.0 {
+            Some(db) => acl::check(db, q.migration_readonly, q.now, q.subject, q.permission, q.resource),
+            None => false,
+        };
+        Ok(((), allowed))
+    }
+
+    fn apply(snap: &Tables, _: &()) -> Tables {
+        snap.clone()
+    }
+}
+
+/// Load, then ask the kernel.
+pub(crate) async fn check(
+    pool: &PgPool,
+    with_groups: bool,
+    migration_readonly: bool,
+    subject: Subject,
+    permission: Permission,
+    resource: Resource,
+) -> Result<bool, DomainError> {
+    let mut snap = load(pool, with_groups, subject, resource).await?;
+    let q = Question {
+        migration_readonly,
+        now: snap.now,
+        subject: snap.ids.subject(subject),
+        permission: self::permission(permission),
+        resource: snap.ids.resource(resource),
+    };
+    let tables = Tables(Some(snap.db));
+    match AclCheck::transition(&(), &tables, &q) {
+        Ok(((), allowed)) => Ok(allowed),
+        Err(never) => match never {},
+    }
+}
