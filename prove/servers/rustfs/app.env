# rustfs/rustfs; the server crate needs protoc (PROTOC) and runs under cargo-nextest, as upstream's CI does
COMMIT=e870a6d
PORT=rustfs
KERNEL=rustfs-kernel
TEST="cargo nextest run -p rustfs-policy -p rustfs-iam -p rustfs --lib --bins --tests --no-fail-fast"
BUILD="cargo build -p rustfs --bin rustfs"
