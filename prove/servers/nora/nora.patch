+// SPDX-License-Identifier: MIT
+
+//! The shell around nora's verified kernel (`nora-kernel`, proven in Lean in
+//! h5i-app-bench). The functions it covers convert nora's state and request to
+//! the kernel's types, let the kernel decide, and apply what it writes.
+//! Hashing, JWT signatures, the filesystem and the clocks stay here.
+
+use std::convert::Infallible;
+use std::sync::OnceLock;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+use h5i_app::{Kernel, TenantId};
+pub use nora_kernel as k;
+
+use crate::config::{OidcProvider, ScopeEnforcement};
+use crate::tokens::Role;
+
+static EPOCH: OnceLock<Instant> = OnceLock::new();
+
+/// The kernel's `Instant`: monotonic nanoseconds since the first call.
+pub fn mono_now() -> u64 {
+    EPOCH.get_or_init(Instant::now).elapsed().as_nanos() as u64
+}
+
+pub fn unix_now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+}
+
+pub fn ip(a: std::net::IpAddr) -> k::net::IpAddr {
+    match a {
+        std::net::IpAddr::V4(v) => k::net::IpAddr::V4(u32::from(v)),
+        std::net::IpAddr::V6(v) => k::net::IpAddr::V6(u128::from(v)),
+    }
+}
+
+pub fn std_ip(a: k::net::IpAddr) -> std::net::IpAddr {
+    match a {
+        k::net::IpAddr::V4(v) => std::net::IpAddr::V4(v.into()),
+        k::net::IpAddr::V6(v) => std::net::IpAddr::V6(v.into()),
+    }
+}
+
+pub fn role(r: &Role) -> k::Role {
+    match r {
+        Role::Read => k::Role::Read,
+        Role::Write => k::Role::Write,
+        Role::Admin => k::Role::Admin,
+    }
+}
+
+pub fn from_role(r: k::Role) -> Role {
+    match r {
+        k::Role::Read => Role::Read,
+        k::Role::Write => Role::Write,
+        k::Role::Admin => Role::Admin,
+    }
+}
+
+pub fn mode(m: ScopeEnforcement) -> k::ScopeEnforcement {
+    match m {
+        ScopeEnforcement::Enforce => k::ScopeEnforcement::Enforce,
+        ScopeEnforcement::Audit => k::ScopeEnforcement::Audit,
+    }
+}
+
+pub fn from_mode(m: k::ScopeEnforcement) -> ScopeEnforcement {
+    match m {
+        k::ScopeEnforcement::Enforce => ScopeEnforcement::Enforce,
+        k::ScopeEnforcement::Audit => ScopeEnforcement::Audit,
+    }
+}
+
+pub fn bytes(v: &[String]) -> Vec<Vec<u8>> {
+    v.iter().map(|s| s.as_bytes().to_vec()).collect()
+}
+
+/// The kernel only cuts UTF-8 input at ASCII bytes, so this never replaces.
+pub fn string(b: Vec<u8>) -> String {
+    String::from_utf8(b).unwrap_or_else(|e| String::from_utf8_lossy(e.as_bytes()).into_owned())
+}
+
+pub fn strings(v: Vec<Vec<u8>>) -> Vec<String> {
+    v.into_iter().map(string).collect()
+}
+
+pub fn provider(p: &OidcProvider) -> k::OidcProvider {
+    k::OidcProvider {
+        max_token_lifetime_secs: p.max_token_lifetime_secs,
+        role_rules: p
+            .role_rules
+            .iter()
+            .map(|r| k::OidcRoleRule {
+                pattern: r.pattern.as_bytes().to_vec(),
+                role: r.role.as_bytes().to_vec(),
+                namespace_scope: r.namespace_scope.as_deref().map(bytes),
+            })
+            .collect(),
+        namespace_scope: bytes(&p.namespace_scope),
+        namespace_scope_enforcement: mode(p.namespace_scope_enforcement),
+    }
+}
+
+pub fn empty_crypto() -> k::oracle::Crypto {
+    k::oracle::Crypto {
+        sha256: Vec::new(),
+        argon2_ok: Vec::new(),
+        bcrypt_ok: Vec::new(),
+        base64: Vec::new(),
+        utf8_ok: Vec::new(),
+    }
+}
+
+/// `auth_middleware` as an h5i-app kernel.
+pub struct NoraAuth;
+
+/// What the caller presented, with the shell's verdicts on it: the oracle
+/// tables for its credentials and the JWT signature check.
+#[derive(Clone)]
+pub struct Presented {
+    pub crypto: k::oracle::Crypto,
+    pub jwt: Option<k::middleware::Jwt>,
+}
+
+/// What the middleware reads: the configuration, the token store and the
+/// failure tracker, restricted to the entries this request can touch.
+#[derive(Clone)]
+pub struct AuthState {
+    pub cfg: k::middleware::Config,
+    pub failures: Vec<k::lockout::FailureEntry>,
+}
+
+impl Default for AuthState {
+    fn default() -> Self {
+        AuthState {
+            cfg: k::middleware::Config {
+                enabled: false,
+                anonymous_read: false,
+                public_web_ui: false,
+                public_metrics: false,
+                docker_anon_pull: false,
+                htpasswd: None,
+                tokens: None,
+                oidc: None,
+                trusted_proxies: k::net::TrustedProxies {
+                    entries: Vec::new(),
+                },
+                tracker: k::lockout::AuthFailureTracker {
+                    max_failures: 5,
+                    max_lockout_secs: 900,
+                },
+            },
+            failures: Vec::new(),
+        }
+    }
+}
+
+impl Kernel for NoraAuth {
+    type Principal = Presented;
+    type Snapshot = AuthState;
+    type Command = k::middleware::Request;
+    type WriteSet = Vec<k::middleware::Write>;
+    type Reply = k::middleware::Outcome;
+    type Error = Infallible;
+
+    fn tenant(_: &Presented) -> TenantId {
+        TenantId(0)
+    }
+
+    fn transition(
+        actor: &Presented,
+        snap: &AuthState,
+        req: &k::middleware::Request,
+    ) -> Result<(Self::WriteSet, Self::Reply), Infallible> {
+        Ok(k::middleware::auth_middleware(
+            &snap.cfg,
+            &snap.failures,
+            &actor.crypto,
+            &actor.jwt,
+            req,
+        ))
+    }
+
+    fn apply(snap: &AuthState, ws: &Self::WriteSet) -> AuthState {
+        use k::middleware::Write;
+        use k::tokens::TokenWrite;
+        let mut s = snap.clone();
+        for w in ws {
+            match w {
+                Write::ClearFailures(ip) => s.failures.retain(|e| e.ip != *ip),
+                Write::PutFailures(e) => {
+                    s.failures.retain(|x| x.ip != e.ip);
+                    s.failures.push(*e);
+                }
+                Write::Token(TokenWrite::CacheInsert(c)) => {
+                    if let Some(store) = &mut s.cfg.tokens {
+                        store.cache.retain(|x| x.key != c.key);
+                        store.cache.push(c.clone());
+                    }
+                }
+                // `last_used` and the rehash live outside the kernel's state.
+                Write::Token(_) => {}
+            }
+        }
+        s
+    }
+}
