--- /dev/null
+++ b/src/service/rooms/state_accessor/h5i.rs
@@ -0,0 +1,287 @@
+//! The shell around tuwunel's verified kernel (`tuwunel-kernel`, proven in
+//! Lean in h5i-app-bench). A visibility decision reads the facts upstream
+//! reads (the event's state hash, history visibility and memberships at it,
+//! the room's current state, the membership indexes) into a kernel snapshot
+//! of one room, and the kernel decides.
+//!
+//! Ids are numbers for one decision: the room is 1, events are numbered in
+//! the order they are read, and a user is `server * 1000 + n`, its server
+//! numbered by first appearance. A server with more than 999 users in one
+//! decision has no kernel form; the caller then evaluates upstream's way.
+
+use std::collections::HashMap;
+
+use ruma::{
+	EventId, OwnedEventId, OwnedServerName, OwnedUserId, RoomId, ServerName, UserId,
+	events::{
+		StateEventType,
+		room::{
+			history_visibility::{HistoryVisibility, RoomHistoryVisibilityEventContent},
+			member::{MembershipState, RoomMemberEventContent},
+		},
+	},
+};
+use tuwunel_core::{implement, matrix::Event};
+pub(super) use tuwunel_kernel as k;
+
+use crate::rooms::short::ShortStateHash;
+
+pub(super) const ROOM: u64 = 1;
+
+pub(super) struct Facts {
+	pub(super) s: k::Snapshot,
+	events: HashMap<OwnedEventId, u64>,
+	servers: HashMap<OwnedServerName, (u64, u64)>,
+	users: HashMap<OwnedUserId, u64>,
+	hashes: HashMap<ShortStateHash, u64>,
+}
+
+impl Facts {
+	pub(super) fn new() -> Self {
+		Self {
+			s: k::Snapshot {
+				rooms: vec![k::Room { id: ROOM, short: 1, state: k::StateRef::None }],
+				pdus: Vec::new(),
+				states: Vec::new(),
+				joined: Vec::new(),
+				invited: Vec::new(),
+				knocked: Vec::new(),
+				left: Vec::new(),
+				once_joined: Vec::new(),
+				relations: Vec::new(),
+				thread_activity: Vec::new(),
+				thread_latest: Vec::new(),
+				thread_participants: Vec::new(),
+				ignored: Vec::new(),
+				config: k::Config {
+					server_name: 0,
+					forbidden_remote_server_names: Vec::new(),
+					allowed_remote_server_names: Vec::new(),
+				},
+				current_count: 0,
+			},
+			events: HashMap::new(),
+			servers: HashMap::new(),
+			users: HashMap::new(),
+			hashes: HashMap::new(),
+		}
+	}
+
+	pub(super) fn server(&mut self, s: &ServerName) -> u64 {
+		let next = self.servers.len() as u64 + 1;
+		self.servers.entry(s.to_owned()).or_insert((next, 0)).0
+	}
+
+	pub(super) fn user(&mut self, u: &UserId) -> Option<u64> {
+		if let Some(&n) = self.users.get(u) {
+			return Some(n);
+		}
+		self.server(u.server_name());
+		let (server, count) = self.servers.get_mut(u.server_name())?;
+		if *count >= 999 {
+			return None;
+		}
+		*count += 1;
+		let n = *server * 1000 + *count;
+		self.users.insert(u.to_owned(), n);
+		Some(n)
+	}
+
+	pub(super) fn event(&mut self, e: &EventId) -> u64 {
+		let next = self.events.len() as u64 + 1;
+		*self.events.entry(e.to_owned()).or_insert(next)
+	}
+
+	pub(super) fn hash(&mut self, h: ShortStateHash) -> u64 {
+		let next = self.hashes.len() as u64 + 1;
+		*self.hashes.entry(h).or_insert(next)
+	}
+
+	fn has_pdu(&self, id: u64) -> bool { self.s.pdus.iter().any(|p| p.event_id == id) }
+
+	fn entry(&mut self, hash: u64, kind: k::Kind, state_key: u64, event_id: u64) {
+		let entry = k::StateEntry { kind, state_key, event_id };
+		match self.s.states.iter_mut().find(|s| s.hash == hash) {
+			| Some(set) =>
+				if !set.entries.contains(&entry) {
+					set.entries.push(entry);
+				},
+			| None => self.s.states.push(k::StateSet { hash, entries: vec![entry] }),
+		}
+	}
+
+	fn state_pdu(&mut self, id: u64, kind: k::Kind, state_key: u64) -> k::Pdu {
+		k::Pdu {
+			event_id: id,
+			room: ROOM,
+			sender: 0,
+			kind,
+			has_state_key: true,
+			state_key,
+			membership: k::MemberField::Absent,
+			history_visibility: k::HvField::Absent,
+			relates_to: k::Relates::None,
+			has_url: false,
+			outlier: true,
+			count: 0,
+			state: k::StateRef::None,
+		}
+	}
+}
+
+fn hv(v: &HistoryVisibility) -> k::HistoryVisibility {
+	match v {
+		| HistoryVisibility::WorldReadable => k::HistoryVisibility::WorldReadable,
+		| HistoryVisibility::Shared => k::HistoryVisibility::Shared,
+		| HistoryVisibility::Invited => k::HistoryVisibility::Invited,
+		| HistoryVisibility::Joined => k::HistoryVisibility::Joined,
+		| _ => k::HistoryVisibility::Custom(0),
+	}
+}
+
+fn membership(m: &MembershipState) -> k::Membership {
+	match m {
+		| MembershipState::Join => k::Membership::Join,
+		| MembershipState::Invite => k::Membership::Invite,
+		| MembershipState::Leave => k::Membership::Leave,
+		| MembershipState::Ban => k::Membership::Ban,
+		| MembershipState::Knock => k::Membership::Knock,
+		| _ => k::Membership::Custom(0),
+	}
+}
+
+/// The event's recorded state and timeline count (`pdu_shortstatehash`,
+/// `get_pdu_count`), and the history visibility at that state.
+#[implement(super::Service)]
+pub(super) async fn h5i_event(&self, f: &mut Facts, event_id: &EventId) -> Option<ShortStateHash> {
+	let hash = self
+		.services
+		.state
+		.pdu_shortstatehash(event_id)
+		.await
+		.ok()?;
+	let count = self
+		.services
+		.timeline
+		.get_pdu_count(event_id)
+		.await;
+	let id = f.event(event_id);
+	let h = f.hash(hash);
+	f.s.pdus.push(k::Pdu {
+		event_id: id,
+		room: ROOM,
+		sender: 0,
+		kind: k::Kind::Message,
+		has_state_key: false,
+		state_key: 0,
+		membership: k::MemberField::Absent,
+		history_visibility: k::HvField::Absent,
+		relates_to: k::Relates::None,
+		has_url: false,
+		outlier: count.is_err(),
+		count: count.map_or(0, |c| c.into_signed()),
+		state: k::StateRef::Hash(h),
+	});
+	self.h5i_history_visibility(f, hash).await;
+	Some(hash)
+}
+
+/// The `m.room.history_visibility` event in a state, if any.
+#[implement(super::Service)]
+pub(super) async fn h5i_history_visibility(&self, f: &mut Facts, hash: ShortStateHash) {
+	let Ok(pdu) = self
+		.state_get(hash, &StateEventType::RoomHistoryVisibility, "")
+		.await
+	else {
+		return;
+	};
+	let id = f.event(pdu.event_id());
+	let h = f.hash(hash);
+	if !f.has_pdu(id) {
+		let mut p = f.state_pdu(id, k::Kind::HistoryVisibility, 0);
+		p.history_visibility = pdu
+			.get_content::<RoomHistoryVisibilityEventContent>()
+			.map_or(k::HvField::Absent, |c| k::HvField::Is(hv(&c.history_visibility)));
+		f.s.pdus.push(p);
+	}
+	f.entry(h, k::Kind::HistoryVisibility, 0, id);
+}
+
+/// The user's `m.room.member` event in a state, if any.
+#[implement(super::Service)]
+pub(super) async fn h5i_member(
+	&self,
+	f: &mut Facts,
+	hash: ShortStateHash,
+	user_id: &UserId,
+) -> Option<()> {
+	let user = f.user(user_id)?;
+	let Ok(pdu) = self
+		.state_get(hash, &StateEventType::RoomMember, user_id.as_str())
+		.await
+	else {
+		return Some(());
+	};
+	let id = f.event(pdu.event_id());
+	let h = f.hash(hash);
+	if !f.has_pdu(id) {
+		let mut p = f.state_pdu(id, k::Kind::Member, user);
+		p.membership = pdu
+			.get_content::<RoomMemberEventContent>()
+			.map_or(k::MemberField::Absent, |c| k::MemberField::Is(membership(&c.membership)));
+		f.s.pdus.push(p);
+	}
+	f.entry(h, k::Kind::Member, user, id);
+	Some(())
+}
+
+/// The room's current state (`get_room_shortstatehash`) and its history
+/// visibility.
+#[implement(super::Service)]
+pub(super) async fn h5i_room_state(&self, f: &mut Facts, room_id: &RoomId) {
+	let Ok(hash) = self
+		.services
+		.state
+		.get_room_shortstatehash(room_id)
+		.await
+	else {
+		return;
+	};
+	let h = f.hash(hash);
+	f.s.rooms[0].state = k::StateRef::Hash(h);
+	self.h5i_history_visibility(f, hash).await;
+}
+
+/// Which membership indexes hold the user. `userroomid_leftstate` and
+/// `roomuserid_leftcount` are one table in the kernel: `left_count` reads the
+/// count (`get_left_count`), otherwise the row stands for `is_left`.
+#[implement(super::Service)]
+pub(super) async fn h5i_indexes(
+	&self,
+	f: &mut Facts,
+	user_id: &UserId,
+	room_id: &RoomId,
+	left_count: bool,
+) -> Option<()> {
+	let user = f.user(user_id)?;
+	let cache = &self.services.state_cache;
+	let row = || k::UserRoom { user, room: ROOM };
+	if cache.is_joined(user_id, room_id).await {
+		f.s.joined.push(row());
+	}
+	if cache.is_invited(user_id, room_id).await {
+		f.s.invited.push(row());
+	}
+	if cache.once_joined(user_id, room_id).await {
+		f.s.once_joined.push(row());
+	}
+	let left = if left_count {
+		cache.get_left_count(room_id, user_id).await.ok()
+	} else {
+		cache.is_left(user_id, room_id).await.then_some(0)
+	};
+	if let Some(count) = left {
+		f.s.left.push(k::LeftRow { user, room: ROOM, count });
+	}
+	Some(())
+}
