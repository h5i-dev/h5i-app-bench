import KanidmKernel
open Aeneas Aeneas.Std Result kanidm_kernel
namespace kanidm_kernel.Verified.SchemaTags
def partial_acceptsAllowed : schema_tags.Syntax → List U16
  | .Utf8String => [7#u16]
  | .Utf8StringInsensitive => [5#u16]
  | .Uuid => [3#u16]
  | .Boolean => [0#u16]
  | .SyntaxId => [1#u16]
  | .IndexId => [2#u16]
  | .ReferenceUuid => [4#u16]
  | .JsonFilter => [8#u16]
  | .Credential => [9#u16]
  | .SecretUtf8String => [10#u16]
  | .SshKey => [11#u16]
  | .SecurityPrincipalName => [12#u16]
  | .Uint32 => [13#u16]
  | .Cid => [16#u16]
  | .Utf8StringIname => [6#u16]
  | .NsUniqueId => [17#u16]
  | .DateTime => [18#u16]
  | .EmailAddress => [19#u16]
  | .Url => [20#u16]
  | .OauthScope => [21#u16]
  | .OauthScopeMap => [4#u16]
  | .PrivateBinary => [24#u16]
  | .IntentToken => [25#u16]
  | .Passkey => [26#u16]
  | .AttestedPasskey => [27#u16]
  | .Session => [4#u16]
  | .JwsKeyEs256 => [5#u16]
  | .JwsKeyRs256 => [5#u16]
  | .Oauth2Session => [4#u16]
  | .UiHint => [28#u16]
  | .TotpSecret => [7#u16]
  | .ApiToken => [4#u16]
  | .AuditLogString => [7#u16]
  | .EcKeyPrivate => [10#u16]
  | .Image => [7#u16]
  | .CredentialType => [29#u16]
  | .WebauthnAttestationCaList => []
  | .OauthClaimMap => [5#u16, 4#u16, 22#u16, 23#u16]
  | .KeyInternal => [30#u16]
  | .HexString => [30#u16]
  | .Certificate => [30#u16]
  | .ApplicationPassword => [3#u16, 4#u16]
  | .Json => []
  | .Message => []
  | .Sha256 => [31#u16]
  | .Int64 => [14#u16]
  | .Uint64 => [15#u16]
theorem partial_accepts_spec (syn : schema_tags.Syntax) (tag : U16) :
    schema_tags.partial_accepts syn tag =
      ok (decide (tag ∈ partial_acceptsAllowed syn)) := by
  cases syn <;> simp [schema_tags.partial_accepts, partial_acceptsAllowed, Bool.or_comm, Bool.or_left_comm] <;> (repeat' split) <;> simp_all

