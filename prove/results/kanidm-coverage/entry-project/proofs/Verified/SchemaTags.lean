theorem value_accepts_spec (syn : schema_tags.Syntax) (tag : U16) (valid : Bool) :
    schema_tags.value_accepts syn tag valid =
      ok (valid && decide (tag ∈ value_acceptsAllowed syn)) := by
  cases valid <;> cases syn <;> simp [schema_tags.value_accepts, value_acceptsAllowed, Bool.or_comm, Bool.or_left_comm] <;> (repeat' split) <;> simp_all

/-- Exact cardinality, syn identity and intrinsic validity conditions. -/
theorem ava_accepts_spec (multi : Bool) (count : Usize) (expected actual : U16) (valid : Bool) :
    schema_tags.ava_accepts multi count expected actual valid =
      ok (decide (multi = true ∨ count.val ≤ 1) && decide (expected = actual) && valid) := by
  cases multi <;> by_cases hc : count > 1#usize <;> by_cases he : expected = actual <;>
    simp_all [schema_tags.ava_accepts]
end kanidm_kernel.Verified.SchemaTags
