  else
    if is_available
    then
      let b1 ← handlers.no_password req.password
      ok
        {
          data := d.data,
          title := d.metadata.title,
          can_delete := b,
          is_available := true,
          no_store := encrypted,
          cache_put := b1
        }
    else
      ok
        {
          data := d.data,
          title := d.metadata.title,
          can_delete := b,
          is_available := false,
          no_store := encrypted,
          cache_put := false
