def delegation.load_link_facts
  (env : delegation.DelegationEnv) (lid : Slice Std.U8) :
  Result delegation.LinkFacts
  := do
  let s := alloc.vec.Vec.deref env.links
  let o ← delegation.find_link s lid
  match o with
  | none =>
    delegation.from_rows none none (alloc.vec.Vec.new (alloc.vec.Vec Std.U8))
  | some link =>
    let s1 := alloc.vec.Vec.deref env.installations
    let s2 := alloc.vec.Vec.deref link.installation_id
    let installation ← delegation.find_installation s1 s2
    let (installation1, orgs) ←
      match installation with
      | none => ok (none, alloc.vec.Vec.new (alloc.vec.Vec Std.U8))
      | some i =>
        do
        let orgs1 ←
          alloc.vec.CloneVec.clone (core.clone.CloneallocvecVec
            core.clone.CloneU8) i.served_orgs
        ok (installation, orgs1)
    delegation.from_rows o installation1 orgs

/-- [openobserve_kernel::delegation::validate_delegated]:
    Source: 'prove/ports/openobserve/kernel/src/delegation.rs', lines 528:0-570:1
    Visibility: public -/
def delegation.validate_delegated
  (env : delegation.DelegationEnv) (o : delegation.VerifyOracle)
  (now : Std.I64) (token : Slice Std.U8) (path : Slice Std.U8)
  (path_prefix : Slice Std.U8) (method : delegation.Method) :
  Result (core.result.Result delegation.Delegated delegation.AuthError)
  := do
  let s := alloc.vec.Vec.deref env.disabled_orgs
  let r ← delegation.verified_claims token env.slack_on env.keys_ok o now s
  match r with
  | core.result.Result.Ok c =>
    let r1 ← delegation.check_route path path_prefix method c
    match r1 with
    | core.result.Result.Ok _ =>
      if env.store_ok
      then
        let s1 := alloc.vec.Vec.deref c.lid
        let facts ← delegation.load_link_facts env s1
        let r2 ← delegation.admit facts c
        match r2 with
        | core.result.Result.Ok _ =>
          let s2 := alloc.vec.Vec.deref env.members
          let s3 := alloc.vec.Vec.deref c.org
          let s4 := alloc.vec.Vec.deref c.sub
          let o1 ← delegation.find_member s2 s3 s4
          match o1 with
          | none =>
            ok (core.result.Result.Err (delegation.AuthError.Forbidden
              delegation.Forbidden.NotMember))
          | some u =>
            if u.is_external
            then
              let s5 := alloc.vec.Vec.deref env.denied
              let s6 := alloc.vec.Vec.deref u.email
              let b ← bytes.contains s5 s6
              if b
              then
                ok (core.result.Result.Err (delegation.AuthError.Forbidden
                  delegation.Forbidden.Blocked))
              else
                ok (core.result.Result.Ok
                  {
                    user_email := c.sub,
                    user_role := u.role,
                    is_internal_user := (¬ true),
                    link_id := c.lid,
                    installation_id := facts.installation_id,
                    org := c.org,
                    jti := c.jti,
                    scope := c.scope
                  })
            else
              ok (core.result.Result.Ok
                {
                  user_email := c.sub,
                  user_role := u.role,
                  is_internal_user := (¬ false),
                  link_id := c.lid,
                  installation_id := facts.installation_id,
                  org := c.org,
                  jti := c.jti,
                  scope := c.scope
                })
        | core.result.Result.Err e => ok (core.result.Result.Err e)
      else ok (core.result.Result.Err delegation.AuthError.Unavailable)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | core.result.Result.Err e => ok (core.result.Result.Err e)

