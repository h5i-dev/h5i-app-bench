def delegation.seg_matches
  (pat : delegation.Seg) (col : Slice Std.U8) : Result Bool := do
  match pat with
  | delegation.Seg.Lit lit =>
    let s := alloc.vec.Vec.deref lit
    bytes.bytes_eq col s
  | delegation.Seg.Param => let i := Slice.len col
                            ok (i > 0#usize)
  | delegation.Seg.Stream =>
    let i := Slice.len col
    if i > 0#usize
    then
      let v ← tables.reserved_stream_slots
      let s := alloc.vec.Vec.deref v
      let b ← bytes.contains s col
      ok (¬ b)
    else ok false
  | delegation.Seg.AlertId =>
    let i := Slice.len col
    if i > 0#usize
    then
      let v ← tables.alert_id_literals
      let s := alloc.vec.Vec.deref v
      let b ← bytes.contains s col
      ok (¬ b)
    else ok false

