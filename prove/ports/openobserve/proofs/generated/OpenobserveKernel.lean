/-- [openobserve_kernel::delegation::from_rows]:
    Source: 'prove/ports/openobserve/kernel/src/delegation.rs', lines 377:0-403:1
    Visibility: public -/
def delegation.from_rows
  (link : Option delegation.LinkRow)
  (installation : Option delegation.Installation)
  (orgs : alloc.vec.Vec (alloc.vec.Vec Std.U8)) :
  Result delegation.LinkFacts
  := do
  match link with
  | none => delegation.refused delegation.Refusal.UnknownLink
  | some link1 =>
    if link1.revoked
    then
      ok
        {
          installation_id := link1.installation_id,
          user_email := link1.user_email,
          refusal := (some delegation.Refusal.LinkRevoked),
          orgs,
          last_used_at := link1.last_used_at
        }
    else
      match installation with
      | none =>
        ok
          {
            installation_id := link1.installation_id,
            user_email := link1.user_email,
            refusal := (some delegation.Refusal.InstallationRevoked),
            orgs,
            last_used_at := link1.last_used_at
          }
      | some i =>
        if i.revoked
        then
          ok
            {
              installation_id := link1.installation_id,
              user_email := link1.user_email,
              refusal := (some delegation.Refusal.InstallationRevoked),
              orgs,
              last_used_at := link1.last_used_at
            }
        else
          ok
            {
              installation_id := link1.installation_id,
              user_email := link1.user_email,
              refusal := none,
              orgs,
              last_used_at := link1.last_used_at
            }

/-- [openobserve_kernel::delegation::admit]:
    Source: 'prove/ports/openobserve/kernel/src/delegation.rs', lines 406:0-422:1
    Visibility: public -/
def delegation.admit
  (facts : delegation.LinkFacts) (claims : delegation.Claims) :
  Result (core.result.Result Unit delegation.AuthError)
  := do
  match facts.refusal with
  | none =>
    let s := alloc.vec.Vec.deref facts.user_email
    let s1 := alloc.vec.Vec.deref claims.sub
    let b ← bytes.bytes_eq s s1
    if b
    then
      let s2 := alloc.vec.Vec.deref facts.orgs
      let s3 := alloc.vec.Vec.deref claims.org
      let b1 ← bytes.contains s2 s3
      if b1
      then ok (core.result.Result.Ok ())
      else
        ok (core.result.Result.Err (delegation.AuthError.Forbidden
          delegation.Forbidden.OrgNotConnected))
    else
      ok (core.result.Result.Err (delegation.AuthError.Forbidden
        delegation.Forbidden.NotLinkedUser))
  | some r =>
    match r with
    | delegation.Refusal.UnknownLink =>
      ok (core.result.Result.Err (delegation.AuthError.Forbidden
        delegation.Forbidden.UnknownLink))
    | delegation.Refusal.LinkRevoked =>
      ok (core.result.Result.Err (delegation.AuthError.Forbidden
        delegation.Forbidden.LinkRevoked))
    | delegation.Refusal.InstallationRevoked =>
      ok (core.result.Result.Err (delegation.AuthError.Forbidden
        delegation.Forbidden.InstallationRevoked))

