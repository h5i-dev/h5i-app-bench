/-- [openobserve_kernel::delegation::check_claims]:
    Source: 'prove/ports/openobserve/kernel/src/delegation.rs', lines 99:0-113:1
    Visibility: public -/
def delegation.check_claims
  (claims : delegation.Claims) (now : Std.I64) :
  Result (core.result.Result delegation.Claims delegation.DelegationError)
  := do
  if claims.v != delegation.TOKEN_VERSION
  then
    ok (core.result.Result.Err (delegation.DelegationError.UnsupportedVersion
      claims.v))
  else
    if claims.exp <= now
    then ok (core.result.Result.Err delegation.DelegationError.Expired)
    else
      let i ← now + delegation.MAX_IAT_SKEW_SECS
      if claims.iat > i
      then
        ok (core.result.Result.Err (delegation.DelegationError.Malformed
          delegation.Malformed.IssuedInFuture))
      else
        let i1 ← claims.exp - claims.iat
        if i1 > delegation.MAX_LIFETIME_SECS
        then
          ok (core.result.Result.Err (delegation.DelegationError.Malformed
            delegation.Malformed.LifetimeOverAnHour))
        else ok (core.result.Result.Ok claims)

/-- [openobserve_kernel::delegation::verify]:
    Source: 'prove/ports/openobserve/kernel/src/delegation.rs', lines 116:0-141:1
    Visibility: public -/
def delegation.verify
  (token : Slice Std.U8) (o : delegation.VerifyOracle) (now : Std.I64) :
  Result (core.result.Result delegation.Claims delegation.DelegationError)
  := do
  let s ←
    lift (Array.to_slice
      (Array.make 5#usize [ 111#u8, 50#u8, 100#u8, 116#u8, 46#u8 ]))
  let o1 ← bytes.strip_prefix token s
  match o1 with
  | none =>
    ok (core.result.Result.Err (delegation.DelegationError.Malformed
      delegation.Malformed.Shape))
  | some rest =>
    let s1 := alloc.vec.Vec.deref rest
    let o2 ← bytes.split_once s1 46#u8
    match o2 with
    | none =>
      ok (core.result.Result.Err (delegation.DelegationError.Malformed
        delegation.Malformed.Shape))
    | some _ =>
      match o.given_mac with
      | none =>
        ok (core.result.Result.Err (delegation.DelegationError.Malformed
          delegation.Malformed.MacEncoding))
      | some given =>
        let s2 := alloc.vec.Vec.deref o.mac_current
        let s3 := alloc.vec.Vec.deref given
        let current_ok ← bytes.constant_time_eq s2 s3
        let previous_ok ←
          match o.mac_previous with
          | none => ok false
          | some m =>
            let s4 := alloc.vec.Vec.deref m
            let s5 := alloc.vec.Vec.deref given
            bytes.constant_time_eq s4 s5
        if current_ok
        then
          match o.claims with
          | none =>
            ok (core.result.Result.Err (delegation.DelegationError.Malformed
              delegation.Malformed.ClaimsEncoding))
          | some claims =>
            let c ← delegation.Claims.Insts.CoreCloneClone.clone claims
            delegation.check_claims c now
        else
          if previous_ok
          then
            match o.claims with
            | none =>
              ok (core.result.Result.Err (delegation.DelegationError.Malformed
                delegation.Malformed.ClaimsEncoding))
            | some claims =>
              let c ← delegation.Claims.Insts.CoreCloneClone.clone claims
              delegation.check_claims c now
          else
            ok (core.result.Result.Err delegation.DelegationError.BadSignature)

