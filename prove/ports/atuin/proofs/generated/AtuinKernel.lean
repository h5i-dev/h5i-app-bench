def apply_write (s : Snapshot) (w : Write) : Result Snapshot := do
  match w with
  | Write.AddUser u =>
    let v ← push_user s.users u
    let v1 ← alloc.vec.CloneVec.clone Session.Insts.CoreCloneClone s.sessions
    let v2 ←
      alloc.vec.CloneVec.clone HistoryRow.Insts.CoreCloneClone s.history
    let v3 ← alloc.vec.CloneVec.clone StoreRow.Insts.CoreCloneClone s.store
    if u.id >= s.next_user_id
    then
      if u.id < core.num.U64.MAX
      then
        let i ← u.id + 1#u64
        ok
          {
            s
              with
              users := v,
              sessions := v1,
              history := v2,
              store := v3,
              next_user_id := i
          }
      else ok { s with users := v, sessions := v1, history := v2, store := v3 }
    else ok { s with users := v, sessions := v1, history := v2, store := v3 }
  | Write.AddSession x =>
    let v ← alloc.vec.CloneVec.clone User.Insts.CoreCloneClone s.users
    let v1 ← push_session s.sessions x
    let v2 ←
      alloc.vec.CloneVec.clone HistoryRow.Insts.CoreCloneClone s.history
    let v3 ← alloc.vec.CloneVec.clone StoreRow.Insts.CoreCloneClone s.store
    if x.id >= s.next_session_id
    then
      if x.id < core.num.U64.MAX
      then
        let i ← x.id + 1#u64
        ok
          {
            s
              with
              users := v,
              sessions := v1,
              history := v2,
              store := v3,
              next_session_id := i
          }
      else ok { s with users := v, sessions := v1, history := v2, store := v3 }
    else ok { s with users := v, sessions := v1, history := v2, store := v3 }
  | Write.SetPassword user_id hash =>
    let v ← with_password s.users user_id hash
    let v1 ← alloc.vec.CloneVec.clone Session.Insts.CoreCloneClone s.sessions
    let v2 ←
      alloc.vec.CloneVec.clone HistoryRow.Insts.CoreCloneClone s.history
    let v3 ← alloc.vec.CloneVec.clone StoreRow.Insts.CoreCloneClone s.store
    ok { s with users := v, sessions := v1, history := v2, store := v3 }
  | Write.DeleteUser id =>
    let v ← without_user s.users id
    let v1 ← without_user_sessions s.sessions id
    let v2 ← without_user_history s.history id
    let v3 ← without_user_store s.store id
    ok { s with users := v, sessions := v1, history := v2, store := v3 }
  | Write.InsertRecord r =>
    let v ← alloc.vec.CloneVec.clone User.Insts.CoreCloneClone s.users
    let v1 ← alloc.vec.CloneVec.clone Session.Insts.CoreCloneClone s.sessions
    let v2 ←
      alloc.vec.CloneVec.clone HistoryRow.Insts.CoreCloneClone s.history
    let b ← store_conflict s.store r
    if b
    then
      let v3 ← alloc.vec.CloneVec.clone StoreRow.Insts.CoreCloneClone s.store
      ok { s with users := v, sessions := v1, history := v2, store := v3 }
    else
      let v3 ← push_row s.store r
      ok { s with users := v, sessions := v1, history := v2, store := v3 }
  | Write.DeleteStore id =>
    let v ← alloc.vec.CloneVec.clone User.Insts.CoreCloneClone s.users
    let v1 ← alloc.vec.CloneVec.clone Session.Insts.CoreCloneClone s.sessions
    let v2 ←
      alloc.vec.CloneVec.clone HistoryRow.Insts.CoreCloneClone s.history
    let v3 ← without_user_store s.store id
    ok { s with users := v, sessions := v1, history := v2, store := v3 }

