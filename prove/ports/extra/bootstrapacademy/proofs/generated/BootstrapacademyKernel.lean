  Result ((core.result.Result Login Error) × Ctx)
  := do
  let o ← repo.get_refresh_token_hash ctx.db session_id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound, ctx)
  | some h =>
    let o1 ← repo.get_session ctx.db session_id
    match o1 with
    | none => ok (core.result.Result.Err Error.NotFound, ctx)
    | some s =>
      let o2 ← repo.get_composite ctx.db s.user_id
      match o2 with
      | none => ok (core.result.Result.Err Error.NotFound, ctx)
      | some u =>
        if u.user.enabled
        then
          let ctx1 ← access.invalidate c ctx env h
          let (tokens, ctx2) ←
            access.issue_tokens ctx1 u.user session_id s.mfa_verified
          let b ← repo.session_update_applies ctx2.db s.id
          if b
          then
            let ctx3 ←
              db_write ctx2 (Write.UpdateSessionUpdatedAt s.id env.now)
            let ctx4 ←
              db_write ctx3 (Write.SaveRefreshTokenHash s.id
                tokens.refresh_token_hash)
            ok (core.result.Result.Ok
              {
                user_composite := u,
                session := { s with updated_at := env.now },
                access_token := tokens.access_token,
                refresh_token := tokens.refresh_token
              }, ctx4)
          else ok (core.result.Result.Err Error.NotFound, ctx2)
        else ok (core.result.Result.Err Error.NotFound, ctx)

