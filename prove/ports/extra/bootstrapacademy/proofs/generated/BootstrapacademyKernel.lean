def mfa.confirm
  (ctx : Ctx) (env : Env) (totp_device : TotpDevice) (code : Std.U64) :
  Result ((core.result.Result TotpDevice Error) × Ctx)
  := do
  let o ← repo.get_totp_device_secret ctx.db totp_device.id
  match o with
  | none => ok (core.result.Result.Err Error.Internal, ctx)
  | some s =>
    let tc ← mfa.totp_check env code s
    match tc with
    | TotpCheck.Ok =>
      let ctx1 ←
        db_write ctx (Write.UpdateTotpDeviceEnabled totp_device.id true)
      ok (core.result.Result.Ok { totp_device with enabled := true }, ctx1)
    | TotpCheck.InvalidCode =>
      ok (core.result.Result.Err Error.InvalidCode, ctx)
    | TotpCheck.RecentlyUsed =>
      ok (core.result.Result.Err Error.InvalidCode, ctx)

