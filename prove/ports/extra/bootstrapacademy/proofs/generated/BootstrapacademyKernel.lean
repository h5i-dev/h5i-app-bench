  (declaration : Declaration) :
  Result ((core.result.Result Reply Error) × Ctx)
  := do
  let o ← heart.text_version declaration
  match o with
  | none => ok (core.result.Result.Err Error.WithdrawalConsentMissing, ctx)
  | some v =>
    let r ← access.authenticate ctx env token
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let hearts ← heart.heart_get c ctx env val.user_id
      if hearts.hearts >= c.hearts_max
      then ok (core.result.Result.Ok (Reply.Hearts hearts), ctx)
      else
        let i ← lift (UScalar.hcast .I64 c.hearts_refill_price)
        let price ← lift (core.num.I64.wrapping_sub 0#i64 i)
        let v1 ← heart.hearts_description
        let (r1, ctx1) ←
          coin.service_add_coins ctx env val.user_id price false (some v1)
            false
        match r1 with
        | core.result.Result.Ok _ =>
          let (hearts1, ctx2) ←
            heart.heart_add c ctx1 env val.user_id c.hearts_max
          let (_, ctx3) ← heart.record ctx2 env val.user_id v
          let ctx4 ← commit ctx3
          ok (core.result.Result.Ok (Reply.Hearts hearts1), ctx4)
        | core.result.Result.Err e =>
          match e with
          | Error.InvalidToken =>
            ok (core.result.Result.Err Error.InvalidToken, ctx1)
          | Error.Admin => ok (core.result.Result.Err Error.Admin, ctx1)
          | Error.AdminMfa => ok (core.result.Result.Err Error.AdminMfa, ctx1)
          | Error.EmailVerified =>
            ok (core.result.Result.Err Error.EmailVerified, ctx1)
          | Error.NotFound => ok (core.result.Result.Err Error.NotFound, ctx1)
          | Error.UserNotFound =>
            ok (core.result.Result.Err Error.UserNotFound, ctx1)
          | Error.InvalidCredentials =>
            ok (core.result.Result.Err Error.InvalidCredentials, ctx1)
          | Error.MfaFailed =>
            ok (core.result.Result.Err Error.MfaFailed, ctx1)
          | Error.UserDisabled =>
            ok (core.result.Result.Err Error.UserDisabled, ctx1)
          | Error.Recaptcha =>
            ok (core.result.Result.Err Error.Recaptcha, ctx1)
          | Error.TooManyFailedAttempts _ =>
            ok (core.result.Result.Err e, ctx1)
          | Error.InvalidRefreshToken =>
            ok (core.result.Result.Err Error.InvalidRefreshToken, ctx1)
          | Error.AlreadyEnabled =>
            ok (core.result.Result.Err Error.AlreadyEnabled, ctx1)
          | Error.NotInitialized =>
            ok (core.result.Result.Err Error.NotInitialized, ctx1)
          | Error.InvalidCode =>
            ok (core.result.Result.Err Error.InvalidCode, ctx1)
          | Error.NotEnabled =>
            ok (core.result.Result.Err Error.NotEnabled, ctx1)
          | Error.CreditNotAuthorized =>
            ok (core.result.Result.Err Error.CreditNotAuthorized, ctx1)
          | Error.NotEnoughCoins =>
            ok (core.result.Result.Err Error.NotEnoughCoins, ctx1)
          | Error.WithdrawalConsentMissing =>
            ok (core.result.Result.Err Error.WithdrawalConsentMissing, ctx1)
          | Error.Internal => ok (core.result.Result.Err Error.Internal, ctx1)
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r1 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Reply (core.convert.FromSame Error) residual
      ok (r1, ctx)

