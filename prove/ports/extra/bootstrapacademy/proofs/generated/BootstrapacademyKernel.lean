def access.authenticate
  (ctx : Ctx) (env : Env) (token : Option Authentication) :
  Result (core.result.Result Authentication Error)
  := do
  match token with
  | none => ok (core.result.Result.Err Error.InvalidToken)
  | some a =>
    let b ← access.is_invalidated ctx env a.refresh_token_hash
    if b
    then ok (core.result.Result.Err Error.InvalidToken)
    else
      let o ← repo.get_composite ctx.db a.user_id
      match o with
      | none => ok (core.result.Result.Err Error.InvalidToken)
      | some u =>
        if u.user.enabled
        then
          let o1 ← repo.get_by_refresh_token_hash ctx.db a.refresh_token_hash
          match o1 with
          | none => ok (core.result.Result.Err Error.InvalidToken)
          | some s =>
            if s.id = a.session_id
            then
              if s.user_id = a.user_id
              then
                ok (core.result.Result.Ok
                  {
                    a
                      with
                      admin := u.user.admin,
                      email_verified := u.user.email_verified,
                      mfa_verified := s.mfa_verified
                  })
              else ok (core.result.Result.Err Error.InvalidToken)
            else ok (core.result.Result.Err Error.InvalidToken)
        else ok (core.result.Result.Err Error.InvalidToken)

