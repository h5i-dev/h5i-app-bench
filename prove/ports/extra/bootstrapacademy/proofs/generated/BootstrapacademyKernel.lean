def coin.repo_add_coins
  (ctx : Ctx) (user_id : Std.U64) (coins : Std.I64) (withhold : Bool) :
  Result ((core.result.Result Balance Error) × Ctx)
  := do
  let (coins1, withheld_coins) ←
    if withhold
    then ok (0#i64, coins)
    else ok (coins, 0#i64)
  let o ← repo.get_coins ctx.db user_id
  match o with
  | none =>
    if coins1 < 0#i64
    then ok (core.result.Result.Err Error.NotEnoughCoins, ctx)
    else
      if withheld_coins < 0#i64
      then ok (core.result.Result.Err Error.NotEnoughCoins, ctx)
      else
        let ctx1 ←
          db_write ctx (Write.AddCoins user_id coins1 withheld_coins)
        let b ← coin.balance coins1 withheld_coins
        ok (core.result.Result.Ok b, ctx1)
  | some r =>
    let o1 ← lift (I64.checked_add r.coins coins1)
    match o1 with
    | none => ok (core.result.Result.Err Error.Internal, ctx)
    | some a =>
      let o2 ← lift (I64.checked_add r.withheld_coins withheld_coins)
      match o2 with
      | none => ok (core.result.Result.Err Error.Internal, ctx)
      | some b =>
        if a < 0#i64
        then ok (core.result.Result.Err Error.NotEnoughCoins, ctx)
        else
          if b < 0#i64
          then ok (core.result.Result.Err Error.NotEnoughCoins, ctx)
          else
            let ctx1 ←
              db_write ctx (Write.AddCoins user_id coins1 withheld_coins)
            let b1 ← coin.balance a b
            ok (core.result.Result.Ok b1, ctx1)

