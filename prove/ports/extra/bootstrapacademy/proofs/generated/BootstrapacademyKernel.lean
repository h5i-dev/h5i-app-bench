def sessions.impersonate
  (ctx : Ctx) (env : Env) (token : Option Authentication) (user_id : Std.U64) :
  Result ((core.result.Result Reply Error) × Ctx)
  := do
  let r ← access.authenticate ctx env token
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let r1 ← access.ensure_admin val
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      let o ← repo.get_composite ctx.db user_id
      match o with
      | none => ok (core.result.Result.Err Error.NotFound, ctx)
      | some u =>
        if u.user.enabled
        then
          let (r2, ctx1) ← sessions.create ctx env u none false false
          let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
          match cf2 with
          | core.ops.control_flow.ControlFlow.Continue val1 =>
            let ctx2 ← commit ctx1
            ok (core.result.Result.Ok (Reply.Login val1), ctx2)
          | core.ops.control_flow.ControlFlow.Break residual =>
            let r3 ←
              core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                Reply (core.convert.FromSame Error) residual
            ok (r3, ctx1)
        else ok (core.result.Result.Err Error.NotFound, ctx)
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r2 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Reply (core.convert.FromSame Error) residual
      ok (r2, ctx)
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Reply (core.convert.FromSame Error) residual
    ok (r1, ctx)

