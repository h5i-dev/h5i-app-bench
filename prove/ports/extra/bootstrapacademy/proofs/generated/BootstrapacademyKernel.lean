  | core.ops.control_flow.ControlFlow.Continue _ =>
    let failed_login_attempts ←
      throttle.failed_auth_get ctx env cmd.name_or_email
    if failed_login_attempts >= c.login_fails_before_captcha
    then
      if env.captcha_ok
      then
        let o ← sessions.get_composite_by_name_or_email ctx cmd.name_or_email
        match o with
        | none =>
          let ctx1 ← throttle.failed_auth_increment ctx env cmd.name_or_email
          let noe ← NameOrEmail.Insts.CoreCloneClone.clone cmd.name_or_email
          let one ← alloc.vec.Vec.push (alloc.vec.Vec.new NameOrEmail) noe
          let ctx2 ← sessions.record_failed_attempt c ctx1 env one
          ok (core.result.Result.Err Error.InvalidCredentials, ctx2)
        | some u =>
          let logins ← sessions.logins_of u
          let s := alloc.vec.Vec.deref cmd.password
          let r1 ← access.authenticate_by_password ctx env u.user.id s
          match r1 with
          | core.result.Result.Ok _ =>
            if u.mfa_enabled
            then
              let (r2, ctx1) ← mfa.authenticate c ctx env u.user.id cmd.mfa
              match r2 with
              | core.result.Result.Ok r3 =>
                let (b, mfa_verified) ←
                  match r3 with
                  | mfa.MfaAuthenticateResult.Disabled => ok (true, false)
                  | mfa.MfaAuthenticateResult.Ok => ok (true, true)
                  | mfa.MfaAuthenticateResult.Reset => ok (false, false)
                let ctx2 ← sessions.reset_logins ctx1 logins
                ok (core.result.Result.Ok ({ u with mfa_enabled := b },
                  mfa_verified), ctx2)
              | core.result.Result.Err _ =>
                let ctx2 ←
                  sessions.increment_failed_login_attempts c ctx1 env logins
                ok (core.result.Result.Err Error.MfaFailed, ctx2)
            else
              let ctx1 ← sessions.reset_logins ctx logins
              ok (core.result.Result.Ok (u, false), ctx1)
          | core.result.Result.Err _ =>
            let ctx1 ←
              sessions.increment_failed_login_attempts c ctx env logins
            ok (core.result.Result.Err Error.InvalidCredentials, ctx1)
      else ok (core.result.Result.Err Error.Recaptcha, ctx)
    else
      let o ← sessions.get_composite_by_name_or_email ctx cmd.name_or_email
      match o with
      | none =>
        let ctx1 ← throttle.failed_auth_increment ctx env cmd.name_or_email
        let noe ← NameOrEmail.Insts.CoreCloneClone.clone cmd.name_or_email
        let one ← alloc.vec.Vec.push (alloc.vec.Vec.new NameOrEmail) noe
        let ctx2 ← sessions.record_failed_attempt c ctx1 env one
