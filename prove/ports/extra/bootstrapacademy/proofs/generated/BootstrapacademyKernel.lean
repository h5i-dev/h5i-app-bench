        db_write ctx4 (Write.UpdateLastLogin user_composite.user.id env.now)
      ok (core.result.Result.Ok
        {
          user_composite :=
            {
              user_composite
                with
                user :=
                  { user_composite.user with last_login := (some env.now) }
            },
          session :=
            {
              id,
              user_id := user_composite.user.id,
              device_name,
              created_at := env.now,
              updated_at := env.now,
