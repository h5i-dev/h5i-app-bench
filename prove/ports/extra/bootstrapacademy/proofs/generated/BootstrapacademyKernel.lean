/-- [bootstrapacademy_kernel::run]:
    Source: 'src/lib.rs', lines 427:0-452:1 -/
def run
  (s : Snapshot) (env : Env) (ctx : Ctx) (req : Request) :
  Result ((core.result.Result Reply Error) × Ctx)
  := do
  match req.cmd with
  | Command.GetCurrentSession => sessions.get_current_session ctx env req.token
  | Command.ListSessions user_id =>
    sessions.list_by_user ctx env req.token user_id
  | Command.CreateSession cmd => sessions.create_session s.config ctx env cmd
  | Command.ProveRecipient cmd => sessions.prove_recipient s.config ctx env cmd
  | Command.Impersonate user_id =>
    sessions.impersonate ctx env req.token user_id
  | Command.RefreshSession refresh_token =>
    sessions.refresh_session s.config ctx env refresh_token
  | Command.DeleteSession user_id session_id =>
    sessions.delete_session s.config ctx env req.token user_id session_id
  | Command.DeleteCurrentSession =>
    sessions.delete_current_session s.config ctx env req.token
  | Command.DeleteSessionsByUser user_id =>
    sessions.delete_by_user s.config ctx env req.token user_id
  | Command.MfaInitialize user_id => mfa.initialize ctx env req.token user_id
  | Command.MfaEnable user_id code => mfa.enable ctx env req.token user_id code
  | Command.MfaDisable user_id =>
    mfa.disable_mfa s.config ctx env req.token user_id
  | Command.GetBalance user_id => coin.get_balance ctx env req.token user_id
  | Command.AddCoins user_id coins description include_in_credit_note =>
    coin.add_coins ctx env req.token user_id coins description
      include_in_credit_note
  | Command.GetHearts user_id => heart.get s.config ctx env req.token user_id
  | Command.RefillHearts declaration =>
    heart.refill s.config ctx env req.token declaration

