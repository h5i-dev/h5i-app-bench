/-- [oxicloud_kernel::subjectgroup::alphanumeric]:
    Source: 'prove/ports/oxicloud/kernel/src/subjectgroup.rs', lines 18:0-20:1 -/
def subjectgroup.alphanumeric (b : Std.U8) : Result Bool := do
  if b >= 97#u8
  then
    if b <= 122#u8
    then ok true
    else
      if b >= 65#u8
      then
        if b <= 90#u8
        then ok true
        else if b >= 48#u8
             then ok (b <= 57#u8)
             else ok false
      else if b >= 48#u8
           then ok (b <= 57#u8)
           else ok false
  else
    if b >= 65#u8
    then
      if b <= 90#u8
      then ok true
      else if b >= 48#u8
           then ok (b <= 57#u8)
           else ok false
    else if b >= 48#u8
         then ok (b <= 57#u8)
         else ok false

