@[rust_loop_body]
def policydefaults.validate_loop.body
  (kind : model.DriveKind) (keys : Slice (alloc.vec.Vec Std.U8))
  (i : Std.Usize) :
  Result (ControlFlow Std.Usize policydefaults.Validation)
  := do
  let i1 := Slice.len keys
  if i < i1
