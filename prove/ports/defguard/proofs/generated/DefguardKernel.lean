    Source: 'prove/ports/defguard/kernel/src/token.rs', lines 54:0-71:1
    Visibility: public -/
def token.start_session
  (t : token.Token) (now : Std.I64) (timeout_ns : Std.I64) :
  Result (token.Token × (core.result.Result Std.I64 token.TokenError))
  := do
  let b ← token.is_expired t now
  if b
  then
    let t1 ← token.same t
    ok (t1, core.result.Result.Err token.TokenError.TokenExpired)
  else
    match t.used_at with
    | none =>
      let i ← now + timeout_ns
      ok ({ t with used_at := (some now) }, core.result.Result.Ok i)
    | some u =>
      let b1 ← token.is_session_valid t now timeout_ns
      if b1
      then
        let t1 ← token.same t
        let i ← u + timeout_ns
        ok (t1, core.result.Result.Ok i)
      else
        let t1 ← token.same t
        ok (t1, core.result.Result.Err token.TokenError.TokenUsed)

/-- [defguard_kernel::token::validate_session]:
    Source: 'prove/ports/defguard/kernel/src/token.rs', lines 75:0-83:1
    Visibility: public -/
def token.validate_session
  (t : token.Token) (now : Std.I64) (timeout_ns : Std.I64) :
  Result (core.result.Result Std.U64 token.TokenError)
  := do
  if t.enrollment_type
  then
    let b ← token.is_session_valid t now timeout_ns
    if b
    then ok (core.result.Result.Ok t.user_id)
    else ok (core.result.Result.Err token.TokenError.SessionExpired)
  else ok (core.result.Result.Err token.TokenError.WrongType)

