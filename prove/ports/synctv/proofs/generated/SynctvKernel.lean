  (u : policy.MemberUpdate) (current_exists : Bool) (current_role : perms.Role)
  (room_exists : Bool) (room_created_by : Std.I64) :
  Result (core.result.Result policy.MemberUpdatePlan policy.PolicyError)
  := do
  let r ←
    policy.validate_admin_override_bits u.admin_added_permissions
      u.admin_removed_permissions
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue _ =>
    if current_exists
    then
      let effective_role ←
        policy.effective_role_of u.has_role u.role current_role
      let effective_is_admin ←
        perms.Role.Insts.CoreCmpPartialEqRole.eq effective_role
          perms.Role.Admin
      if u.apply_permission_update
      then
        let r1 ←
          policy.validate_override_bits_for_role effective_role
            u.added_permissions u.removed_permissions
        let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
        match cf1 with
        | core.ops.control_flow.ControlFlow.Continue _ =>
          if u.has_role
          then
            let r2 ← policy.validate_role_can_be_assigned u.role
            let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
            match cf2 with
            | core.ops.control_flow.ControlFlow.Continue _ =>
              if room_exists
              then
                let r3 ←
                  policy.validate_creator_member_role_update room_created_by
                    u.actor_id u.target_user_id
                let cf3 ← core.result.Result.Insts.CoreOpsTry.branch r3
                match cf3 with
                | core.ops.control_flow.ControlFlow.Continue _ =>
                  let r4 ←
                    policy.validate_member_permission_override_channel
                      effective_is_admin u.added_permissions
                      u.removed_permissions u.admin_added_permissions
                      u.admin_removed_permissions
                  let cf4 ← core.result.Result.Insts.CoreOpsTry.branch r4
                  match cf4 with
                  | core.ops.control_flow.ControlFlow.Continue _ =>
                    ok (core.result.Result.Ok
                      {
                        effective_role,
                        effective_is_admin,
                        needs_manage_member_permissions := true
                      })
                  | core.ops.control_flow.ControlFlow.Break residual =>
                    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                      policy.MemberUpdatePlan (core.convert.FromSame
                      policy.PolicyError) residual
                | core.ops.control_flow.ControlFlow.Break residual =>
                  core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                    policy.MemberUpdatePlan (core.convert.FromSame
                    policy.PolicyError) residual
              else ok (core.result.Result.Err policy.PolicyError.NotFound)
            | core.ops.control_flow.ControlFlow.Break residual =>
              core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                policy.MemberUpdatePlan (core.convert.FromSame
                policy.PolicyError) residual
          else
            let r2 ←
              policy.validate_member_permission_override_channel
                effective_is_admin u.added_permissions u.removed_permissions
                u.admin_added_permissions u.admin_removed_permissions
            let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
            match cf2 with
            | core.ops.control_flow.ControlFlow.Continue _ =>
              ok (core.result.Result.Ok
                {
                  effective_role,
                  effective_is_admin,
                  needs_manage_member_permissions := true
                })
            | core.ops.control_flow.ControlFlow.Break residual =>
              core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                policy.MemberUpdatePlan (core.convert.FromSame
                policy.PolicyError) residual
        | core.ops.control_flow.ControlFlow.Break residual =>
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            policy.MemberUpdatePlan (core.convert.FromSame policy.PolicyError)
            residual
      else
        if u.has_role
        then
          let r1 ← policy.validate_role_can_be_assigned u.role
          let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
          match cf1 with
          | core.ops.control_flow.ControlFlow.Continue _ =>
            if room_exists
            then
              let r2 ←
                policy.validate_creator_member_role_update room_created_by
                  u.actor_id u.target_user_id
              let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
              match cf2 with
              | core.ops.control_flow.ControlFlow.Continue _ =>
                ok (core.result.Result.Ok
                  {
                    effective_role,
                    effective_is_admin,
                    needs_manage_member_permissions := false
                  })
              | core.ops.control_flow.ControlFlow.Break residual =>
                core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                  policy.MemberUpdatePlan (core.convert.FromSame
                  policy.PolicyError) residual
            else ok (core.result.Result.Err policy.PolicyError.NotFound)
          | core.ops.control_flow.ControlFlow.Break residual =>
            core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
              policy.MemberUpdatePlan (core.convert.FromSame
              policy.PolicyError) residual
        else
          ok (core.result.Result.Ok
            {
              effective_role,
              effective_is_admin,
              needs_manage_member_permissions := false
            })
    else ok (core.result.Result.Err policy.PolicyError.NotFound)
  | core.ops.control_flow.ControlFlow.Break residual =>
