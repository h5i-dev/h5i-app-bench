  | perms.Role.Creator => perms.all
  | perms.Role.Admin =>
    let i ← perms.admin_to_permissions m.admin_added_permissions
    let i1 ← lift (role_default ||| i)
    let i2 ← perms.admin_to_permissions m.admin_removed_permissions
    let i3 ← lift (~~~ i2)
    ok (i1 &&& i3)
  | perms.Role.Member =>
    let i ← perms.member_to_permissions m.added_permissions
    let i1 ← lift (role_default ||| i)
    let i2 ← perms.member_to_permissions m.removed_permissions
    let i3 ← lift (~~~ i2)
    ok (i1 &&& i3)
  | perms.Role.Guest =>
    let i ← perms.guest_assignable
    let i1 ← lift (role_default &&& i)
    let i2 ← perms.guest_to_permissions m.added_permissions
    let i3 ← lift (i1 ||| i2)
    let i4 ← perms.guest_to_permissions m.removed_permissions
    let i5 ← lift (~~~ i4)
    ok (i3 &&& i5)

