def registry_rows_model (active : List U8) (e : sidebar.Enabled) : List U8 :=
  row_1_model e.docker (decide (active = id_docker)) ++ row_2_model e.maven (decide (active = id_maven)) ++ row_3_model e.npm (decide (active = id_npm)) ++ row_4_model e.cargo (decide (active = id_cargo)) ++ row_5_model e.pypi (decide (active = id_pypi)) ++ row_6_model e.raw (decide (active = id_raw)) ++ row_7_model e.go (decide (active = id_go)) ++ row_8_model e.gems (decide (active = id_gems)) ++ row_9_model e.terraform (decide (active = id_terraform)) ++ row_10_model e.ansible (decide (active = id_ansible)) ++ row_11_model e.nuget (decide (active = id_nuget)) ++ row_12_model e.pub_dart (decide (active = id_pub)) ++ row_13_model e.conan (decide (active = id_conan)) ++ row_14_model e.rpm (decide (active = id_rpm)) ++ row_15_model e.deb (decide (active = id_deb)) ++ row_16_model e.cpan (decide (active = id_cpan))
def registry_section_model (active label : List U8) (e : sidebar.Enabled) : List U8 :=
  if any_enabled e then
    registry_heading_literal_0 ++ label ++ registry_heading_literal_2 ++ registry_rows_model active e ++ registry_tail_literal_0
  else []
private theorem rows_when_none (active : List U8) (e : sidebar.Enabled)
    (h : any_enabled e = false) : registry_rows_model active e = [] := by
  simp only [any_enabled, Bool.or_eq_false_iff, and_assoc] at h
  rcases h with ⟨h_docker, h_maven, h_npm, h_cargo, h_pypi, h_raw, h_go, h_gems, h_terraform, h_ansible, h_nuget, h_pub_dart, h_conan, h_rpm, h_deb, h_cpan⟩
  simp only [registry_rows_model, row_1_model, row_2_model, row_3_model, row_4_model, row_5_model, row_6_model, row_7_model, row_8_model, row_9_model, row_10_model, row_11_model, row_12_model, row_13_model, row_14_model, row_15_model, row_16_model, h_docker, h_maven, h_npm, h_cargo, h_pypi, h_raw, h_go, h_gems, h_terraform, h_ansible, h_nuget, h_pub_dart, h_conan, h_rpm, h_deb, h_cpan, Bool.false_eq_true, if_false, List.nil_append]
private theorem registry_composition (active label : List U8) (e : sidebar.Enabled) :
    registry_heading_model (any_enabled e) label ++ registry_rows_model active e ++ registry_tail_model (any_enabled e) = registry_section_model active label e := by
  cases h : any_enabled e with
  | false =>
    rw [rows_when_none active e h]
    simp [h, registry_heading_model, registry_tail_model, registry_section_model]
  | true =>
    simp [h, registry_heading_model, registry_tail_model, registry_section_model, List.append_assoc]
def decode (r : sidebar.Output) : List U8 :=
  (r.frame_0.val.flatMap alloc.vec.Vec.val) ++ (r.row_0.val.flatMap alloc.vec.Vec.val) ++ (r.frame_1.val.flatMap alloc.vec.Vec.val) ++ (r.registry_heading.val.flatMap alloc.vec.Vec.val) ++ (r.row_1.val.flatMap alloc.vec.Vec.val) ++ (r.row_2.val.flatMap alloc.vec.Vec.val) ++ (r.row_3.val.flatMap alloc.vec.Vec.val) ++ (r.row_4.val.flatMap alloc.vec.Vec.val) ++ (r.row_5.val.flatMap alloc.vec.Vec.val) ++ (r.row_6.val.flatMap alloc.vec.Vec.val) ++ (r.row_7.val.flatMap alloc.vec.Vec.val) ++ (r.row_8.val.flatMap alloc.vec.Vec.val) ++ (r.row_9.val.flatMap alloc.vec.Vec.val) ++ (r.row_10.val.flatMap alloc.vec.Vec.val) ++ (r.row_11.val.flatMap alloc.vec.Vec.val) ++ (r.row_12.val.flatMap alloc.vec.Vec.val) ++ (r.row_13.val.flatMap alloc.vec.Vec.val) ++ (r.row_14.val.flatMap alloc.vec.Vec.val) ++ (r.row_15.val.flatMap alloc.vec.Vec.val) ++ (r.row_16.val.flatMap alloc.vec.Vec.val) ++ (r.registry_tail.val.flatMap alloc.vec.Vec.val) ++ (r.frame_2.val.flatMap alloc.vec.Vec.val) ++ (r.admin.val.flatMap alloc.vec.Vec.val) ++ (r.frame_3.val.flatMap alloc.vec.Vec.val) ++ r.version.val ++ (r.frame_4.val.flatMap alloc.vec.Vec.val)
def sidebar_model (active : List U8) (t : sidebar.Translations) (auth : Bool) (e : sidebar.Enabled) (version : List U8) : List U8 :=
  frame_0_model true ++ row_0_model true (decide (active = id_dashboard)) t.nav_dashboard.val ++ frame_1_model true ++ registry_section_model active t.nav_registries.val e ++ frame_2_model true ++ admin_model auth (decide (active = id_tokens)) t.nav_tokens.val ++ frame_3_model true ++ version ++ frame_4_model true

attribute [local irreducible] frame_0_model frame_1_model frame_2_model frame_3_model frame_4_model row_0_model row_1_model row_2_model row_3_model row_4_model row_5_model row_6_model row_7_model row_8_model row_9_model row_10_model row_11_model row_12_model row_13_model row_14_model row_15_model row_16_model registry_heading_model registry_tail_model admin_model
@[step] theorem sidebar_complete (active : Slice U8) (t : sidebar.Translations) (auth : Bool)
    (e : sidebar.Enabled) (version : Slice U8) :
    sidebar.sidebar active t auth e version ⦃r => decode r = sidebar_model active.val t auth e version.val⦄ := by
  unfold sidebar.sidebar
  step* (grind := false) (threadGrindState := false) (assumTac := false) (inferGhostVars := false)
  all_goals simp_all only [decode, sidebar_model, Array.to_slice, Array.make_val,
    Slice.from_val, alloc.vec.Vec.deref, if_true]
  all_goals rw [← registry_composition active.val t.nav_registries.val e]
  all_goals simp only [registry_rows_model, List.append_assoc]
  all_goals rfl
