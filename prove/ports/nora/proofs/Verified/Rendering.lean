  if a = [67#u8,65#u8,67#u8,72#u8,69#u8] then [116#u8,101#u8,120#u8,116#u8,45#u8,121#u8,101#u8,108#u8,108#u8,111#u8,119#u8,45#u8,52#u8,48#u8,48#u8] else
