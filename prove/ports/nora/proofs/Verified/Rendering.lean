    (hbound : (render_activity_row_model timestamp.val action.val artifact.val registry.val source.val).length ≤ Usize.max) :
    rendering.render_activity_row timestamp action artifact registry source ⦃r => r.val = render_activity_row_model timestamp.val action.val artifact.val registry.val source.val⦄ := by
  all_goals unfold rendering.render_activity_row
  all_goals step* (grind := false) (threadGrindState := false)
  all_goals unfold render_activity_row_model at *
  all_goals simp_all [Array.make, Slice.eq_iff, alloc.vec.Vec.new, alloc.vec.Vec.from, alloc.vec.Vec.val, alloc.vec.Vec.deref, Slice.from_val, List.append_assoc]
