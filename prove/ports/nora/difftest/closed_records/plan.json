      "carrier_source": "#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\npub struct SigningConfig {\n    /// Sign rpm/deb repository indexes. On by default: with local storage a\n    /// key is generated at first boot; signed and unsigned clients both keep\n    /// working (unsigned clients simply don't fetch the signatures).\n    #[serde(default = \"default_signing_enabled\")]\n    pub enabled: bool,\n    /// Path of the armored OpenPGP secret key. Empty = derive\n    /// `<storage.path>/.signing/nora.key` for local storage; required for S3\n    /// (there is no local data directory to derive from).\n    #[serde(default)]\n    pub key_path: String,\n}",
      "fields": [
        [
          "enabled",
          "bool"
        ],
        [
          "key_path",
          "String"
        ]
      ],
      "enums": {},
      "initializers": [
        [
          "enabled",
          "true"
        ],
        [
          "key_path",
          "Vec::new()"
        ]
      ],
      "values": {
        "enabled": true,
        "key_path": []
      }
    },
