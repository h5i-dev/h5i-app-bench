/-- Steps through a generated `from_row`. -/
macro "row_tac" : tactic => `(tactic| (
  repeat (first
    | (step*; done)
    | (simp_all only [User.row, Token.row, Bookmark.row, Tag.row, Link.row, Bundle.row, Counter.row, List.getElem_cons_zero, List.getElem_cons_succ, Nat.zero_add, Nat.reduceAdd, bind_tc_ok, u64_from_val, bool_from_val, bytes_from_val]; step*))
  all_goals simp_all))

