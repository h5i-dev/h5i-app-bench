theorem Counter.from_one_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Counter)
    (hl : l.length ≤ 1) (h : rows.val.map (·.val) = l.map Counter.row) :
    Counter.from_one rows ⦃ o => o = some (l.headD Counter.zero) ⦄ := by
  unfold Counter.from_one
  match l, hl with
  | [], _ =>
    have hr : rows.val = [] := by simpa using h
    have h0 : rows.len = 0#usize := by scalar_tac
    rw [if_pos h0]; step*; simp_all [Counter.zero]
  | [x], _ =>
    obtain ⟨v, hv, hvv⟩ : ∃ v, rows.val = [v] ∧ v.val = Counter.row x := by
      simp only [List.map_cons, List.map_nil] at h
      obtain ⟨v, rest⟩ := List.map_eq_singleton_iff.1 h
      exact ⟨v, rest.1, rest.2⟩
    have h0 : ¬ rows.len = 0#usize := by scalar_tac
    have h1 : rows.len = 1#usize := by scalar_tac
    rw [if_neg h0, if_pos h1]
    step as ⟨ w, hw ⟩
    have : w.val = Counter.row x := by rw [hw]; simp [hv, hvv]
    step with Counter.from_row_spec x w this
    simp_all

/-! ## Tables -/

/-- Key length per table. -/
def kl : Nat → Nat
  | 0 => 1
  | 1 => 1
  | 2 => 3
  | 3 => 1
  | 4 => 2
  | 5 => 1
  | 6 => 0
  | _ => 0

@[simp] theorem kl_0 : kl 0 = 1 := rfl
@[simp] theorem kl_1 : kl 1 = 1 := rfl
@[simp] theorem kl_2 : kl 2 = 3 := rfl
@[simp] theorem kl_3 : kl 3 = 1 := rfl
@[simp] theorem kl_4 : kl 4 = 2 := rfl
@[simp] theorem kl_5 : kl 5 = 1 := rfl
@[simp] theorem kl_6 : kl 6 = 0 := rfl

/-- `row` encodes a value of table `t`'s row type. -/
def IsRow : Nat → List Val → Prop
  | 0 => fun r => ∃ x : User, r = User.row x
  | 1 => fun r => ∃ x : Token, r = Token.row x
  | 2 => fun r => ∃ x : Bookmark, r = Bookmark.row x
  | 3 => fun r => ∃ x : Tag, r = Tag.row x
  | 4 => fun r => ∃ x : Link, r = Link.row x
  | 5 => fun r => ∃ x : Bundle, r = Bundle.row x
  | 6 => fun r => ∃ x : Counter, r = Counter.row x
  | _ => fun _ => False

/-- Split a goal about table `t` into one goal per table. -/
macro "cases_table " t:ident : tactic => `(tactic| rcases $t:ident with _ | _ | _ | _ | _ | _ | _ | $t:ident)

/-- A write's table writes map a state's encoding to the next: `schema_step [enc, sqlA, applyWrite]`. -/
macro "schema_step" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro s w; funext t
  cases w <;> cases_table t <;>
    simp [applyAllW, applyW, upsert, User.putA, User.table, User.keyLen, User.delA, User.delWhereA, Token.putA, Token.table, Token.keyLen, Token.delA, Token.delWhereA, Bookmark.putA, Bookmark.table, Bookmark.keyLen, Bookmark.delA, Bookmark.delWhereA, Tag.putA, Tag.table, Tag.keyLen, Tag.delA, Tag.delWhereA, Link.putA, Link.table, Link.keyLen, Link.delA, Link.delWhereA, Bundle.putA, Bundle.table, Bundle.keyLen, Bundle.delA, Bundle.delWhereA, Counter.putA, Counter.table, Counter.keyLen, Counter.row, $ls,*] <;>
    first
      | exact map_filter_of _ _ _ _ (fun y => by simp [User.row, Token.row, Bookmark.row, Tag.row, Link.row, Bundle.row, Counter.row])
      | (congr 1; exact List.filter_congr (fun y _ => by simp [User.row, Token.row, Bookmark.row, Tag.row, Link.row, Bundle.row, Counter.row]))))

/-- Every table write is well formed: `schema_ok [sqlA]`. -/
macro "schema_ok" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro w; cases w <;>
    simp [WriteOk, RowOk, IsRow, User.putA, User.table, User.keyLen, User.delA, User.delWhereA, Token.putA, Token.table, Token.keyLen, Token.delA, Token.delWhereA, Bookmark.putA, Bookmark.table, Bookmark.keyLen, Bookmark.delA, Bookmark.delWhereA, Tag.putA, Tag.table, Tag.keyLen, Tag.delA, Tag.delWhereA, Link.putA, Link.table, Link.keyLen, Link.delA, Link.delWhereA, Bundle.putA, Bundle.table, Bundle.keyLen, Bundle.delA, Bundle.delWhereA, Counter.putA, Counter.table, Counter.keyLen, $ls,*]))

/-- A fresh tenant's tables: `schema_init [enc, init]`. -/
macro "schema_init" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro t; cases_table t <;> simp [InitOk, $ls,*]))

/-- A fresh tenant's rows are rows of their tables: `schema_rows [enc, init]`. -/
macro "schema_rows" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro t r h; cases_table t <;> simp [$ls,*] at h <;> subst h <;> first | exact ⟨Counter.zero, rfl⟩))

/-! ## The snapshot -/

/-- A snapshot's rows, table by table. -/
def Snapshot.enc (s : Snapshot) : Tables Val
  | 0 => s.users.val.map User.row
  | 1 => s.tokens.val.map Token.row
  | 2 => s.bookmarks.val.map Bookmark.row
  | 3 => s.tags.val.map Tag.row
  | 4 => s.links.val.map Link.row
  | 5 => s.bundles.val.map Bundle.row
  | 6 => [Counter.row s.counter]
  | _ => []

/-- A fresh tenant's snapshot. -/
def Snapshot.empty : Snapshot :=
  { counter := Counter.zero, users := alloc.vec.Vec.new User, tokens := alloc.vec.Vec.new Token, bookmarks := alloc.vec.Vec.new Bookmark, tags := alloc.vec.Vec.new Tag, links := alloc.vec.Vec.new Link, bundles := alloc.vec.Vec.new Bundle }

/-- Stored rows, table by table. -/
def Rows.tabs (r : Rows) : Tables Val
  | 0 => r.users.val.map (·.val)
  | 1 => r.tokens.val.map (·.val)
  | 2 => r.bookmarks.val.map (·.val)
  | 3 => r.tags.val.map (·.val)
  | 4 => r.links.val.map (·.val)
  | 5 => r.bundles.val.map (·.val)
  | 6 => r.counter.val.map (·.val)
  | _ => []

theorem Snapshot.clone_eq (s : Snapshot) : Snapshot.Insts.CoreCloneClone.clone s = ok s := by
  simp [Snapshot.Insts.CoreCloneClone.clone,
    Counter.clone_eq,
    vec_clone_eq User.Insts.CoreCloneClone s.users User.clone_eq,
    vec_clone_eq Token.Insts.CoreCloneClone s.tokens Token.clone_eq,
    vec_clone_eq Bookmark.Insts.CoreCloneClone s.bookmarks Bookmark.clone_eq,
    vec_clone_eq Tag.Insts.CoreCloneClone s.tags Tag.clone_eq,
    vec_clone_eq Link.Insts.CoreCloneClone s.links Link.clone_eq,
    vec_clone_eq Bundle.Insts.CoreCloneClone s.bundles Bundle.clone_eq]

/-- `decode` reads back tables `E` up to row order (an empty singleton table reads as its fresh row). -/
theorem decode_spec (r : Rows) (E : Tables Val)
    (hrow : ∀ t, ∀ row ∈ E t, IsRow t row)
    (hone6 : (E 6).length = 1)
    (hnil : ∀ t, 7 ≤ t → E t = [])
    (hR : ∀ t, (Rows.tabs r t).Perm (E t) ∨ (Rows.tabs r t = [] ∧ E t = Snapshot.enc Snapshot.empty t)) :
    decode r ⦃ o => ∃ s, o = some s ∧ ∀ t, (Snapshot.enc s t).Perm (E t) ⦄ := by
  obtain ⟨l6, n6, e6, f6⟩ := one_row Counter.row Counter.zero (Rows.tabs r 6) (E 6) hone6 (hrow 6) (hR 6)
  have h0 : (Rows.tabs r 0).Perm (E 0) := keyed_perm (hR 0)
  obtain ⟨l0, e0⟩ := exists_map User.row (Rows.tabs r 0) (fun row h => hrow 0 row (h0.subset h))
  have h1 : (Rows.tabs r 1).Perm (E 1) := keyed_perm (hR 1)
  obtain ⟨l1, e1⟩ := exists_map Token.row (Rows.tabs r 1) (fun row h => hrow 1 row (h1.subset h))
  have h2 : (Rows.tabs r 2).Perm (E 2) := keyed_perm (hR 2)
  obtain ⟨l2, e2⟩ := exists_map Bookmark.row (Rows.tabs r 2) (fun row h => hrow 2 row (h2.subset h))
  have h3 : (Rows.tabs r 3).Perm (E 3) := keyed_perm (hR 3)
  obtain ⟨l3, e3⟩ := exists_map Tag.row (Rows.tabs r 3) (fun row h => hrow 3 row (h3.subset h))
  have h4 : (Rows.tabs r 4).Perm (E 4) := keyed_perm (hR 4)
  obtain ⟨l4, e4⟩ := exists_map Link.row (Rows.tabs r 4) (fun row h => hrow 4 row (h4.subset h))
  have h5 : (Rows.tabs r 5).Perm (E 5) := keyed_perm (hR 5)
  obtain ⟨l5, e5⟩ := exists_map Bundle.row (Rows.tabs r 5) (fun row h => hrow 5 row (h5.subset h))
  unfold decode
  step with Counter.from_one_spec r.counter l6 n6 e6 as ⟨ o6, h6 ⟩
  subst h6; dsimp only
  step with User.from_rows_spec r.users l0 e0 as ⟨ o0, v0, ho0, hv0 ⟩
  subst ho0; dsimp only
  step with Token.from_rows_spec r.tokens l1 e1 as ⟨ o1, v1, ho1, hv1 ⟩
  subst ho1; dsimp only
  step with Bookmark.from_rows_spec r.bookmarks l2 e2 as ⟨ o2, v2, ho2, hv2 ⟩
  subst ho2; dsimp only
  step with Tag.from_rows_spec r.tags l3 e3 as ⟨ o3, v3, ho3, hv3 ⟩
  subst ho3; dsimp only
  step with Link.from_rows_spec r.links l4 e4 as ⟨ o4, v4, ho4, hv4 ⟩
  subst ho4; dsimp only
  step with Bundle.from_rows_spec r.bundles l5 e5 as ⟨ o5, v5, ho5, hv5 ⟩
  subst ho5; dsimp only
  refine ⟨_, rfl, fun t => ?_⟩
  match t with
  | 0 => simp only [Snapshot.enc, hv0]; rw [← e0]; exact h0
  | 1 => simp only [Snapshot.enc, hv1]; rw [← e1]; exact h1
  | 2 => simp only [Snapshot.enc, hv2]; rw [← e2]; exact h2
  | 3 => simp only [Snapshot.enc, hv3]; rw [← e3]; exact h3
  | 4 => simp only [Snapshot.enc, hv4]; rw [← e4]; exact h4
  | 5 => simp only [Snapshot.enc, hv5]; rw [← e5]; exact h5
  | 6 => simp only [Snapshot.enc, f6]; exact .refl _
  | t + 7 => simp only [Snapshot.enc, hnil (t + 7) (by omega)]; exact .refl _

/-! ## Partial loads

`Store::load_for` may load each table by one declarative read of a plan
(`schema_load_plan`). `Snapshot.load plan s` is what loading `plan` from the
tables of `s` decodes to (`decode_load`); an app's frame theorem shows
`transition` gives the same result on it as on `s`. Values compare by
classical equality, as everywhere in this file. -/

section PartialLoads
open H5iAppLib.Query

/-- A vector's rows that the plan loads. -/
noncomputable def pickVec {α : Type} (plan : List (Query.Read Val)) (tabs : Tables Val) (t : Nat) (row : α → List Val)
    (v : alloc.vec.Vec α) : alloc.vec.Vec α :=
  .from (pickRows plan tabs t row v.val) ((pickRows_length plan tabs t row v.val).trans v.len_ineq)

/-- What loading `plan` from the tables of `s` decodes to: each table's rows its read keeps, none if the plan
does not read it; a singleton table reads as fresh unless its read keeps its row. -/
noncomputable def Snapshot.load (plan : List (Query.Read Val)) (s : Snapshot) : Snapshot :=
  { counter := (pickRows plan (Snapshot.enc s) 6 Counter.row [s.counter]).headD Counter.zero, users := pickVec plan (Snapshot.enc s) 0 User.row s.users, tokens := pickVec plan (Snapshot.enc s) 1 Token.row s.tokens, bookmarks := pickVec plan (Snapshot.enc s) 2 Bookmark.row s.bookmarks, tags := pickVec plan (Snapshot.enc s) 3 Tag.row s.tags, links := pickVec plan (Snapshot.enc s) 4 Link.row s.links, bundles := pickVec plan (Snapshot.enc s) 5 Bundle.row s.bundles }

@[simp] theorem Snapshot.load_users (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).users.val = pickRows plan (Snapshot.enc s) 0 User.row s.users.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_tokens (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).tokens.val = pickRows plan (Snapshot.enc s) 1 Token.row s.tokens.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_bookmarks (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).bookmarks.val = pickRows plan (Snapshot.enc s) 2 Bookmark.row s.bookmarks.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_tags (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).tags.val = pickRows plan (Snapshot.enc s) 3 Tag.row s.tags.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_links (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).links.val = pickRows plan (Snapshot.enc s) 4 Link.row s.links.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_bundles (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).bundles.val = pickRows plan (Snapshot.enc s) 5 Bundle.row s.bundles.val :=
  alloc.vec.Vec.from_val _ _


/-- Rows holding, for each table, what `plan` loads from the tables of `s` decode to `Snapshot.load plan s`. -/
theorem decode_load (plan : List (Query.Read Val)) (s : Snapshot) (r : Rows)
    (h : ∀ t, t < 7 → Rows.tabs r t = load plan (Snapshot.enc s) t) :
    decode r = ok (some (Snapshot.load plan s)) := by
  have e6 := h 6 (by omega)
  rw [load_pick plan _ 6 Counter.row [s.counter] rfl] at e6
  have hl6 := pickRows_length plan (Snapshot.enc s) 6 Counter.row [s.counter]
  have e0 := h 0 (by omega)
  rw [load_pick plan _ 0 User.row s.users.val rfl] at e0
  have e1 := h 1 (by omega)
  rw [load_pick plan _ 1 Token.row s.tokens.val rfl] at e1
  have e2 := h 2 (by omega)
  rw [load_pick plan _ 2 Bookmark.row s.bookmarks.val rfl] at e2
  have e3 := h 3 (by omega)
  rw [load_pick plan _ 3 Tag.row s.tags.val rfl] at e3
  have e4 := h 4 (by omega)
  rw [load_pick plan _ 4 Link.row s.links.val rfl] at e4
  have e5 := h 5 (by omega)
  rw [load_pick plan _ 5 Bundle.row s.bundles.val rfl] at e5
  simp only [Rows.tabs] at *
  apply eq_ok_of_spec
  unfold decode
  step with Counter.from_one_spec r.counter _ hl6 e6 as ⟨ o6, h6 ⟩
  subst h6; dsimp only
  step with User.from_rows_spec r.users _ e0 as ⟨ o0, v0, ho0, hv0 ⟩
  subst ho0; dsimp only
  step with Token.from_rows_spec r.tokens _ e1 as ⟨ o1, v1, ho1, hv1 ⟩
  subst ho1; dsimp only
  step with Bookmark.from_rows_spec r.bookmarks _ e2 as ⟨ o2, v2, ho2, hv2 ⟩
  subst ho2; dsimp only
  step with Tag.from_rows_spec r.tags _ e3 as ⟨ o3, v3, ho3, hv3 ⟩
  subst ho3; dsimp only
  step with Link.from_rows_spec r.links _ e4 as ⟨ o4, v4, ho4, hv4 ⟩
  subst ho4; dsimp only
  step with Bundle.from_rows_spec r.bundles _ e5 as ⟨ o5, v5, ho5, hv5 ⟩
  subst ho5; dsimp only
  simp only [WP.spec_ok, Option.some.injEq, Snapshot.load]
  congr 1 <;> apply alloc.vec.Vec.ext <;> simp [pickVec, *]

/-- `IN` a column of a read of table 0, as a test on the snapshot's rows. -/
theorem holds_in_0 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 0 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.users.val).filter (fun y => p.holds (Snapshot.enc s) (User.row y)))).any
          (fun y => decide ((User.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 0) (j := j) (p := p) (w := w) (r := r) (f := User.row)
    (l := s.users.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 1, as a test on the snapshot's rows. -/
theorem holds_in_1 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 1 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.tokens.val).filter (fun y => p.holds (Snapshot.enc s) (Token.row y)))).any
          (fun y => decide ((Token.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 1) (j := j) (p := p) (w := w) (r := r) (f := Token.row)
    (l := s.tokens.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 2, as a test on the snapshot's rows. -/
theorem holds_in_2 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 2 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.bookmarks.val).filter (fun y => p.holds (Snapshot.enc s) (Bookmark.row y)))).any
          (fun y => decide ((Bookmark.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 2) (j := j) (p := p) (w := w) (r := r) (f := Bookmark.row)
    (l := s.bookmarks.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 3, as a test on the snapshot's rows. -/
theorem holds_in_3 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 3 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.tags.val).filter (fun y => p.holds (Snapshot.enc s) (Tag.row y)))).any
          (fun y => decide ((Tag.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 3) (j := j) (p := p) (w := w) (r := r) (f := Tag.row)
    (l := s.tags.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 4, as a test on the snapshot's rows. -/
theorem holds_in_4 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 4 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.links.val).filter (fun y => p.holds (Snapshot.enc s) (Link.row y)))).any
          (fun y => decide ((Link.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 4) (j := j) (p := p) (w := w) (r := r) (f := Link.row)
    (l := s.links.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 5, as a test on the snapshot's rows. -/
theorem holds_in_5 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 5 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.bundles.val).filter (fun y => p.holds (Snapshot.enc s) (Bundle.row y)))).any
          (fun y => decide ((Bundle.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 5) (j := j) (p := p) (w := w) (r := r) (f := Bundle.row)
    (l := s.bundles.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 6, as a test on the snapshot's rows. -/
theorem holds_in_6 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 6 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply (([s.counter]).filter (fun y => p.holds (Snapshot.enc s) (Counter.row y)))).any
          (fun y => decide ((Counter.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 6) (j := j) (p := p) (w := w) (r := r) (f := Counter.row)
    (l := [s.counter]) (h := rfl)]
  cases r[i]? <;> rfl


end PartialLoads

/-- Rows in a snapshot's keyed tables; a write adds at most one. -/
def Snapshot.size (s : Snapshot) : Nat := s.users.length + s.tokens.length + s.bookmarks.length + s.tags.length + s.links.length + s.bundles.length

/-! ## Loading

An app's `Storage.lean` gives an `H5iAppLib.Store.App` numbered like this schema. -/

section Load
variable {St W : Type} (A : App St W Val) (toSt : Snapshot → St)

/-- The app's storage matches this schema. -/
structure Fits : Prop where
  kl : A.kl = kl
  rows : A.IsRow = IsRow
  enc : ∀ s, A.enc (toSt s) = Snapshot.enc s
  init : A.enc A.init = Snapshot.enc Snapshot.empty
  nil : ∀ s t, 7 ≤ t → A.enc s t = []

variable {A toSt}

/-- Loading a served database decodes to the state it holds, up to row order. -/
theorem loaded (hf : Fits A toSt) {db : Db Val} {s : St} (h : A.Served db s) (r : Rows)
    (hl : Lists kl db (Rows.tabs r)) :
    decode r ⦃ o => ∃ snap, o = some snap ∧ A.Equiv (toSt snap) s ⦄ := by
  obtain ⟨-, hrow, hone⟩ := A.served_holds h
  have hR := A.served_lists h _ (by rw [hf.kl]; exact hl)
  rw [hf.rows] at hrow
  rw [hf.kl] at hone
  apply WP.spec_mono (decode_spec r (A.enc s) hrow (hone 6 rfl (by rw [hf.init]; rfl)) (hf.nil s)
    (fun t => by rw [← hf.init]; exact hR t))
  rintro o ⟨snap, rfl, hp⟩
  exact ⟨snap, rfl, fun t => by rw [hf.enc]; exact hp t⟩

end Load

/-! ## Committing and storing a write set -/

/-- `apply` folds `apply_write` (as `f` on `abs`), if no table overflows. -/
theorem apply_spec' {β : Type} (abs : Snapshot → β) (f : β → Write → β)
    (hw : ∀ s w, Snapshot.size s < Usize.max → apply_write s w ⦃ s' => abs s' = f (abs s) w ∧ Snapshot.size s' ≤ Snapshot.size s + 1 ⦄)
    (hc : ∀ w, Write.Insts.CoreCloneClone.clone w = ok w)
    (s : Snapshot) (ws : alloc.vec.Vec Write) (h : Snapshot.size s + ws.length < Usize.max) :
    apply s ws ⦃ s' => abs s' = ws.val.foldl f (abs s) ⦄ := by
  unfold apply apply_loop
  rw [Snapshot.clone_eq]
  simp only [bind_ok]
  apply WP.spec_mono (loop_fold ws.val abs f (fun t k => Snapshot.size t + (ws.length - k) < Usize.max)
    (fun x => apply_loop.body ws x.1 x.2) ?_ s 0#usize (by simp) (by simpa using h))
  · intro r hr; rw [hr]; simp
  · intro t j hj ht
    unfold apply_loop.body
    simp only [alloc.vec.Vec.length] at hj ht
    dsimp only
    split
    · rename_i hlt
      step as ⟨ w, hw1 ⟩
      rw [hc]
      simp only [bind_ok]
      step with hw t w (by scalar_tac) as ⟨ t', ht1, ht2 ⟩
      step*
      simp only [FoldStep]
      have := i2_post
      have : j.val < ws.val.length := by scalar_tac
      refine ⟨by scalar_tac, by rw [ht1, hw1], by scalar_tac, by simp only [alloc.vec.Vec.length] at *; omega⟩
    · simp only [WP.spec_ok, FoldStep, and_true]
      scalar_tac

/-- `sql_writes` concatenates `sql_write` over the write set. -/
theorem sql_writes_spec' (f : Write → List (AWrite Val))
    (hw : ∀ w out, out.length + (f w).length ≤ Usize.max →
      sql_write w out ⦃ out' => out'.val.map sqlW = out.val.map sqlW ++ f w ⦄)
    (ws : alloc.vec.Vec Write) (h : (ws.val.flatMap f).length ≤ Usize.max) :
    sql_writes ws ⦃ v => v.val.map sqlW = ws.val.flatMap f ⦄ := by
  unfold sql_writes sql_writes_loop
  apply WP.spec_mono (loop_fold ws.val (fun v : alloc.vec.Vec h5i_app_sql.Write => v.val.map sqlW)
    (fun acc w => acc ++ f w) (fun o k => o.length + ((ws.val.drop k).flatMap f).length ≤ Usize.max)
    (fun x => sql_writes_loop.body ws x.1 x.2) ?_ _ 0#usize (by simp) (by simpa using h))
  · intro r hr; rw [hr, foldl_append_flatMap]; simp
  · intro o j hj ho
    unfold sql_writes_loop.body
    dsimp only
    split
    · rename_i hlt
      have hj' : j.val < ws.val.length := by scalar_tac
      step as ⟨ w, hw1 ⟩
      have hd : ws.val.drop j.val = ws.val[j.val] :: ws.val.drop (j.val + 1) := List.drop_eq_getElem_cons hj'
      rw [hd, List.flatMap_cons, List.length_append] at ho
      step with hw w o (by rw [hw1]; omega) as ⟨ o', ho1 ⟩
      step*
      simp only [FoldStep]
      have hl : o'.length = o.length + (f w).length := by
        have := congrArg List.length ho1; simp at this; simpa [alloc.vec.Vec.length] using this
      refine ⟨hj', by rw [ho1, hw1], by scalar_tac, ?_⟩
      rw [i2_post, hl, hw1]; omega
    · simp only [WP.spec_ok, FoldStep, and_true]
      scalar_tac

section Store
variable {St : Type} (A : App St Write Val) (toSt : Snapshot → St)

/-- Databases the server reaches from an empty tenant, with the state each holds. -/
inductive Served : Db Val → St → Prop
  | fresh : Served (fun _ _ => none) A.init
  | commit {db : Db Val} {s : St} {r : Rows} {snap : Snapshot} {ws : alloc.vec.Vec Write}
      {v : alloc.vec.Vec h5i_app_sql.Write} :
      Served db s → Lists kl db (Rows.tabs r) → decode r = ok (some snap) →
      (ws.val.flatMap A.sql).length ≤ Usize.max → sql_writes ws = ok v →
      Served (execAll db ((v.val.map sqlW).map planA)) (ws.val.foldl A.step (toSt snap))

variable {A toSt}

/-- `sql_write` computes the app's table writes. -/
def SqlFits (A : App St Write Val) : Prop :=
  ∀ w out, out.length + (A.sql w).length ≤ Usize.max →
    sql_write w out ⦃ out' => out'.val.map sqlW = out.val.map sqlW ++ A.sql w ⦄

theorem served_app (hf : Fits A toSt) (hs : SqlFits A) {db : Db Val} {s : St} (h : Served A toSt db s) :
    A.Served db s := by
  induction h with
  | fresh => exact .fresh
  | commit _ hl hd hn hv ih =>
    obtain ⟨snap', he, hq⟩ := post_of_ok (loaded hf ih _ hl) hd
    cases he
    rw [post_of_ok (sql_writes_spec' A.sql hs _ hn) hv]
    exact .commit ih hq

/-- Every served database holds its state's rows and loads back to that state. -/
theorem stored (hf : Fits A toSt) (hs : SqlFits A) {db : Db Val} {s : St} (h : Served A toSt db s) :
    A.Holds db (A.enc s) ∧
      ∀ r, Lists kl db (Rows.tabs r) → decode r ⦃ o => ∃ snap, o = some snap ∧ A.Equiv (toSt snap) s ⦄ :=
  ⟨(A.served_holds (served_app hf hs h)).1, loaded hf (served_app hf hs h)⟩

end Store

/-! ## On PostgreSQL

`PgServed` is one tenant's history on a shared database; other tenants'
statements may run in between. SQL comes from the extracted `h5i_app_pgsql`
(`Pg.selectA`, `Pg.compileA`); the database model is `H5iAppLib.Pg`. `ts` is
`schema_spec()`, `tv` the tenant id. -/

section Pg
variable {St : Type} (A : App St Write Val) (toSt : Snapshot → St) (ts : List Pg.Tab) (tv : Val)
  (Step : Snapshot → alloc.vec.Vec Write → Prop)

/-- Rows the compiled `SELECT` of each table returns, in any order. -/
def Loads (db : Pg.PgDb Val) (r : Rows) : Prop :=
  ∀ t, t < 7 → ∃ q ps R0, Pg.selectA valKind ts tv t none = some (q, ps) ∧
    Pg.selected valKind db q ps = some R0 ∧ (Rows.tabs r t).Perm R0

inductive PgServed : Pg.PgDb Val → St → Prop
  | fresh {db : Pg.PgDb Val} :
      Pg.Matches valKind ts db → Pg.view ts tv db = (fun _ _ => none) → PgServed db A.init
  | commit {db db' : Pg.PgDb Val} {s : St} {r : Rows} {snap : Snapshot} {ws : alloc.vec.Vec Write}
      {v : alloc.vec.Vec h5i_app_sql.Write} {qs : List (Pg.Sql × List Val)} :
      PgServed db s → Loads ts tv db r → decode r = ok (some snap) → Step snap ws →
      (ws.val.flatMap A.sql).length ≤ Usize.max → sql_writes ws = ok v →
      ((v.val.map sqlW).map planA).mapM (Pg.compileA valKind ts tv) = some qs →
      Pg.runAll valKind db qs = some db' → PgServed db' (ws.val.foldl A.step (toSt snap))
  | other {db db' : Pg.PgDb Val} {s : St} {tv' : Val} {ss : List (AStmt Val)}
      {qs : List (Pg.Sql × List Val)} :
      PgServed db s → tv' ≠ tv → valKind tv' = some .int →
      ss.mapM (Pg.compileA valKind ts tv') = some qs → Pg.runAll valKind db qs = some db' → PgServed db' s

variable {A toSt ts tv Step}

theorem Rows.tabs_nil (r : Rows) (t : Nat) (h : 7 ≤ t) : Rows.tabs r t = [] := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' h
  simp only [Rows.tabs]

/-- The tenant's view of a `PgServed` database is `Served`, with the same state. -/
theorem pg_served (hs : SqlFits A) (hf : Fits A toSt) (hv : Pg.Valid ts) (htv : valKind tv = some .int)
    (hkl : Pg.klOf ts = kl) (hlen : ts.length = 7) {db : Pg.PgDb Val} {s : St}
    (h : PgServed A toSt ts tv Step db s) : Pg.Matches valKind ts db ∧ Served A toSt (Pg.view ts tv db) s := by
  induction h with
  | fresh hm he => exact ⟨hm, he ▸ .fresh⟩
  | @commit db db' s r snap ws v qs _ hsel hd _ hn hvw hq hr ih =>
    obtain ⟨hm, hS⟩ := ih
    have hl : Lists kl (Pg.view ts tv db) (Rows.tabs r) := by
      rw [← hkl]
      exact Pg.lists_of_selects valKind hv htv hm _ (fun t ht => Rows.tabs_nil _ t (hlen ▸ ht))
        (fun t ht => hsel t (hlen ▸ ht))
    obtain ⟨db2, hr2, hm2, hv2, -, -⟩ := Pg.compileAll_sound valKind hv htv _ _ _ hm hq
    rw [hr] at hr2
    cases hr2
    exact ⟨hm2, hv2 ▸ .commit hS hl hd hn hvw⟩
  | other _ hne htv' hq hr ih =>
    obtain ⟨hm, hS⟩ := ih
    obtain ⟨db2, hr2, hm2, -, ho, -⟩ := Pg.compileAll_sound valKind hv htv' _ _ _ hm hq
    rw [hr] at hr2
    cases hr2
    exact ⟨hm2, (ho _ (Ne.symm hne)) ▸ hS⟩

/-- An `Inv` kept by init, row reordering and every `Step` holds on PostgreSQL and on every load. -/
theorem pg_loaded_inv (hs : SqlFits A) (hf : Fits A toSt) (hv : Pg.Valid ts) (htv : valKind tv = some .int)
    (hkl : Pg.klOf ts = kl) (hlen : ts.length = 7) (Inv : St → Prop) (hinit : Inv A.init)
    (hequiv : ∀ snap s', A.Equiv (toSt snap) s' → Inv s' → Inv (toSt snap))
    (hstep : ∀ snap ws, Step snap ws → Inv (toSt snap) → Inv (ws.val.foldl A.step (toSt snap)))
    {db : Pg.PgDb Val} {s : St} (h : PgServed A toSt ts tv Step db s) :
    Inv s ∧ ∀ r, Loads ts tv db r → decode r ⦃ o => ∃ snap, o = some snap ∧ Inv (toSt snap) ⦄ := by
  have load : ∀ {db : Pg.PgDb Val} {s : St}, PgServed A toSt ts tv Step db s → Inv s →
      ∀ r, Loads ts tv db r → decode r ⦃ o => ∃ snap, o = some snap ∧ Inv (toSt snap) ⦄ := by
    intro db s h hi r hr
    obtain ⟨hm, hS⟩ := pg_served hs hf hv htv hkl hlen h
    have hl : Lists kl (Pg.view ts tv db) (Rows.tabs r) := by
      rw [← hkl]
      exact Pg.lists_of_selects valKind hv htv hm _ (fun t ht => Rows.tabs_nil _ t (hlen ▸ ht))
        (fun t ht => hr t (hlen ▸ ht))
    apply WP.spec_mono (loaded hf (served_app hf hs hS) r hl)
    rintro o ⟨snap, rfl, he⟩
    exact ⟨snap, rfl, hequiv snap _ he hi⟩
  have hinv : Inv s := by
    induction h with
    | fresh => exact hinit
    | commit h0 hsel hd hst _ _ _ _ ih =>
      obtain ⟨snap', e, hi'⟩ := post_of_ok (load h0 ih _ hsel) hd
      cases e
      exact hstep _ _ hst hi'
    | other _ _ _ _ _ ih => exact ih
  exact ⟨hinv, load h hinv⟩

end Pg

