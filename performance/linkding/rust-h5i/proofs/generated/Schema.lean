  unfold Bundle.sql_put; step*; simp_all [sqlW, Bundle.putA, Bundle.table, Bundle.keyLen, Bundle.TABLE, Bundle.KEY_LEN]

/-- Insert, or replace the row with the same key. -/
@[step] theorem Bundle.put_spec (v : alloc.vec.Vec Bundle) (x : Bundle) (h : v.length < Usize.max) :
    Bundle.put v x ⦃ v' => v'.val = upsert (fun y => y.id) x v.val ⦄ := by
  unfold Bundle.put Bundle.put_loop
  apply WP.spec_mono (loop_search v.val (fun q => decide (q.id = x.id))
    (fun y : alloc.vec.Vec Bundle => y.val) (fun j _ => v.val.set j x) (v.val ++ [x]) _ ?_ 0#usize (by simp))
  · intro r hr; rw [hr, show ((0#usize : Usize) : Nat) = 0 from rfl]
    exact upsert_loop_result (fun y => y.id) x _ 0 (Nat.zero_le _) (by simp)
  · intro j hj; unfold Bundle.put_loop.body; h5i_step

/-- The rows without this key. -/
@[step] theorem Bundle.del_spec (v : alloc.vec.Vec Bundle) (id : U64) :
    Bundle.del v id ⦃ v' => v'.val = v.val.filter (fun y => ¬(y.id = id)) ⦄ := by
  unfold Bundle.del Bundle.del_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Bundle => w.val)
    (fun acc y => if decide ¬(y.id = id) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Bundle.del_loop.body v id x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Bundle.del_loop.body; h5i_step

/-- The rows whose column `col` does not hold `val`. -/
@[step] theorem Bundle.del_where_spec (v : alloc.vec.Vec Bundle) (col : U32) (val : Val) :
    Bundle.del_where v col val ⦃ v' => v'.val = v.val.filter (fun y => ¬((Bundle.row y)[col.val]? = some val)) ⦄ := by
  unfold Bundle.del_where Bundle.del_where_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Bundle => w.val)
    (fun acc y => if decide ¬((Bundle.row y)[col.val]? = some val) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Bundle.del_where_loop.body v col val x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Bundle.del_where_loop.body; h5i_step

def Bundle.delA (id : U64) : AWrite Val := .del Bundle.table [int id.val]
def Bundle.delWhereA (col : Nat) (val : Val) : AWrite Val := .delWhere Bundle.table col val

@[step] theorem Bundle.sql_del_spec (id : U64) : Bundle.sql_del id ⦃ w => sqlW w = Bundle.delA id ⦄ := by
  unfold Bundle.sql_del; step* <;> simp_all [sqlW, Bundle.delA, Bundle.table, Bundle.TABLE] <;> scalar_tac

@[step] theorem Bundle.sql_del_where_spec (col : U32) (val : Val) :
    Bundle.sql_del_where col val ⦃ w => sqlW w = Bundle.delWhereA col.val val ⦄ := by
  unfold Bundle.sql_del_where; simp [sqlW, Bundle.delWhereA, Bundle.table, Bundle.TABLE]

/-! Row writes on the encoding match the list operations. -/

@[simp] theorem Bundle.map_put (x : Bundle) (l : List Bundle) :
    upsert (·.take 1) (Bundle.row x) (l.map Bundle.row) = (upsert (fun y => y.id) x l).map Bundle.row :=
  map_upsert _ _ _ _ _ (fun y => by simp [Bundle.row])

@[simp] theorem Bundle.map_del (id : U64) (l : List Bundle) :
    (l.map Bundle.row).filter (fun r => !decide (r.take 1 = [int id.val])) =
      (l.filter (fun y => !decide (y.id = id))).map Bundle.row :=
  map_filter_of _ _ _ _ (fun y => by simp [Bundle.row])

@[simp] theorem Bundle.map_del_where (col : Nat) (val : Val) (l : List Bundle) :
    (l.map Bundle.row).filter (fun r => !decide (r[col]? = some val)) =
      (l.filter (fun y => !decide ((Bundle.row y)[col]? = some val))).map Bundle.row := by
  rw [List.filter_map]; rfl

/-! ## `Counter` (table `linkding_counters`) -/

