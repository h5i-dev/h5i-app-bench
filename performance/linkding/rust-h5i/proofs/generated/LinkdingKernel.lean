def decode (r : Rows) : Result (Option Snapshot) := do
  let o ← Counter.from_one r.counter
  match o with
  | none => ok none
  | some x =>
    let o1 ← User.from_rows r.users
    match o1 with
    | none => ok none
    | some x1 =>
      let o2 ← Token.from_rows r.tokens
      match o2 with
      | none => ok none
      | some x2 =>
        let o3 ← Bookmark.from_rows r.bookmarks
        match o3 with
        | none => ok none
        | some x3 =>
          let o4 ← Tag.from_rows r.tags
          match o4 with
          | none => ok none
          | some x4 =>
            let o5 ← Link.from_rows r.links
            match o5 with
            | none => ok none
            | some x5 =>
              let o6 ← Bundle.from_rows r.bundles
              match o6 with
              | none => ok none
              | some x6 =>
                ok (some
                  {
                    counter := x,
                    users := x1,
                    tokens := x2,
                    bookmarks := x3,
                    tags := x4,
                    links := x5,
                    bundles := x6
                  })

