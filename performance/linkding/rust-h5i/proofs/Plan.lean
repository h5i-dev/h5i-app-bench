import Owner
/-!
# What a read plan loads

`reads a c` (extracted) names one declarative read per table; the server
loads each table by its read (`schema_load_plan`) and `decode`s. Here the
extracted reads are read as `H5iAppLib.Query` reads (`Read.abs`, `readsA`,
`reads_abs`), and `list_count` likewise (`countA`, `count_abs`). What loading
a plan decodes to, `Snapshot.load plan s`, and its `decode_load` are
generated by `schema!` (`generated/Schema.lean`). `Frame.lean` shows
`transition` gives the same result on `Snapshot.load (readsA a c) s` as on
`s`.

Trusted: PostgreSQL returns, for each read, `Read.rows` of the tables listed
in key order (the order `load` returns them in), which the differential tests
of `h5i_app_pgsql::compile_read` check.
-/
open Aeneas Aeneas.Std Result linkding_kernel linkding_kernel.Schema linkding_kernel.Helpers H5iAppLib

namespace linkding_kernel.Plan

open H5iAppLib.Query

def Window.abs (w : h5i_app_sql.Window) : Window := ⟨w.desc, w.offset.val, w.limit.map (·.val)⟩

def Pred.abs : h5i_app_sql.Pred → Pred Val
  | .All => .all
  | .Eq c v => .eq c.val v
  | .In c t p o w => .isIn c.val t.val (Pred.abs p) o.val (Window.abs w)
  | .And p q => .and (Pred.abs p) (Pred.abs q)
  | .Or p q => .or (Pred.abs p) (Pred.abs q)

def Read.abs (r : h5i_app_sql.Read) : Read Val := ⟨r.table.val, Pred.abs r.pred, Window.abs r.window⟩

/-- The plan of `reads a c`, if any, as `H5iAppLib.Query` reads. -/
def planOf (o : Option (alloc.vec.Vec h5i_app_sql.Read)) : Option (List (Read Val)) :=
  o.map (fun v => v.val.map Read.abs)

/-! ## Loops over a vector

A loop over the elements of a vector is a monadic fold of its step
(`loop_foldlM`); a fold over a filter of a list skips what the step leaves
unchanged (`foldlM_filter`). -/

theorem succ_ok (i : Usize) (n : Nat) (h : i.val < n) (hn : n ≤ Usize.max) :
    ∃ i2 : Usize, i + 1#usize = ok i2 ∧ i2.val = i.val + 1 := by
  obtain ⟨i2, h1, h2⟩ := (WP.spec_equiv_exists _ _).1 (Usize.add_spec (x := i) (y := 1#usize) (by scalar_tac))
  exact ⟨i2, h1, by scalar_tac⟩

/-- A loop that runs a step over each element of `v` from index `i`
computes the monadic fold of the step over the rest of `v`. -/
theorem loop_foldlM {α β γ σ : Type} (v : List α) (hv : v.length ≤ Usize.max) (step : β → α → Result β)
    (fin : β → γ) (mk : β → Usize → σ) (body : σ → Result (ControlFlow σ γ))
    (hbody : ∀ a (i : Usize), i.val ≤ v.length → body (mk a i) = if h : i.val < v.length then
      (do let a' ← step a v[i.val]; let i2 ← i + 1#usize; ok (ControlFlow.cont (mk a' i2)))
      else ok (ControlFlow.done (fin a))) :
    ∀ a (i : Usize), i.val ≤ v.length →
      loop body (mk a i) = (do let a' ← (v.drop i.val).foldlM step a; ok (fin a')) := by
  intro a i
  induction h : v.length - i.val using Nat.strong_induction_on generalizing a i with
  | _ n ih =>
    intro hi
    rw [loop, hbody a i hi]
    split
    · rename_i hlt
      rw [List.drop_eq_getElem_cons hlt, List.foldlM_cons]
      simp only [bind_tc_eq, Std.bind_assoc]
      congr 1; funext a'
      obtain ⟨i2, hi2, hv2⟩ := succ_ok i v.length hlt hv
      rw [hi2]; simp only [bind_ok]
      rw [ih (v.length - i2.val) (by omega) a' i2 rfl (by omega), hv2]
    · rename_i hge
      have : i.val = v.length := by omega
      simp only [this, List.drop_length, List.foldlM_nil, pure_tc_eq, bind_ok]

theorem foldlM_filter {α β : Type} (l : List α) (K : α → Bool) (step : β → α → Result β)
    (h : ∀ x ∈ l, K x = false → ∀ a, step a x = ok a) (a : β) :
    (l.filter K).foldlM step a = l.foldlM step a := by
  induction l generalizing a with
  | nil => rfl
  | cons x xs ih =>
    have ih' := fun a => ih (fun y hy => h y (List.mem_cons_of_mem _ hy)) a
    by_cases hk : K x = true
    · simp only [List.filter_cons, hk, if_true, List.foldlM_cons]
      congr 1; funext a'; exact ih' a'
    · simp only [Bool.not_eq_true] at hk
      simp only [List.filter_cons, hk, List.foldlM_cons, h x (by simp) hk a, bind_tc_ok]
      exact ih' a

theorem foldlM_congr {α β : Type} (l : List α) (step step' : β → α → Result β)
    (h : ∀ x ∈ l, ∀ a, step' a x = step a x) (a : β) : l.foldlM step' a = l.foldlM step a := by
  induction l generalizing a with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.foldlM_cons, h x (by simp) a]
    congr 1; funext a'; exact ih (fun y hy => h y (List.mem_cons_of_mem _ hy)) a'

theorem vec_index_eq {α : Type} (v : alloc.vec.Vec α) (i : Usize) (h : i.val < v.val.length) :
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice α) v i = ok v.val[i.val] := by
  rw [alloc.vec.Vec.index_slice_index]; unfold alloc.vec.Vec.index_usize
  simp [h]

theorem lt_len_iff {α : Type} (v : alloc.vec.Vec α) (i : Usize) : i < alloc.vec.Vec.len v ↔ i.val < v.val.length := by
  simp [alloc.vec.Vec.len]

/-- Binds that agree on every value the first computation returns. (A
`Result` that is not `ok` is a failure, which has no continuation, or
divergence.) -/
theorem bind_congr_ok {α β : Type} (m : Result α) (f g : α → Result β) (h : ∀ x, m = ok x → f x = g x) :
    (do let x ← m; f x) = (do let x ← m; g x) := by
  change Std.bind m f = Std.bind m g
  cases m using Result.cases with
  | ret a => exact (bind_ok a f).trans ((h a rfl).trans (bind_ok a g).symm)
  | vis e k =>
    cases e with
    | fail err =>
      rw [bind_vis, bind_vis]
      congr 1; funext y; exact y.elim
  | div => simp

/-- A fold over the rows a slice keeps, by a step that agrees on them,
gives the fold over all rows when the step leaves the others unchanged. -/
theorem foldlM_slice {α β : Type} (l : List α) (K : α → Bool) (step step' : β → α → Result β) (a : β)
    (hskip : ∀ x ∈ l, K x = false → ∀ a, step a x = ok a)
    (hsame : ∀ x ∈ l, K x = true → ∀ a, step' a x = step a x) :
    (l.filter K).foldlM step' a = l.foldlM step a := by
  rw [foldlM_congr (l.filter K) step step' (fun x hx a => by
    obtain ⟨hm, hk⟩ := List.mem_filter.1 hx; exact hsame x hm hk a), foldlM_filter l K step hskip a]

theorem foldlM_total {α β : Type} (step : β → α → Result β) (h : ∀ a x, ∃ r, step a x = ok r) :
    ∀ (l : List α) (a : β), ∃ r, l.foldlM step a = ok r := by
  intro l
  induction l with
  | nil => intro a; exact ⟨a, rfl⟩
  | cons x xs ih =>
    intro a
    obtain ⟨a1, h1⟩ := h a x
    obtain ⟨r, hr⟩ := ih a1
    exact ⟨r, by simp only [List.foldlM_cons, h1, bind_tc_ok]; exact hr⟩

/-- Unfolds a loop body over `v` to the shape `loop_foldlM` takes. -/
macro "body_shape" v:term:max : tactic => `(tactic| (
  by_cases hlt : (‹Usize›).val < ($v).val.length
  · simp only [(lt_len_iff _ _).2 hlt, vec_index_eq _ _ hlt, dif_pos hlt, if_true, bind_tc_eq, bind_ok, Std.bind_assoc]
    try rfl
  · simp only [mt (lt_len_iff _ _).1 hlt, dif_neg hlt, if_false]
    try rfl))


/-! ## Lowercasing -/

theorem lower_ascii_eq (c : U8) : search.lower_ascii c = ok (lowerB c) := by
  unfold search.lower_ascii lowerB
  split
  all_goals first | rfl | skip
  simp only [H5iAppLib.u8_eq_iff] at *
  rw [dif_neg]
  rintro ⟨h1, h2⟩
  simp only [UScalar.val] at *
  generalize c.bv.toNat = n at *
  simp at *
  omega


/-- `lower_text`: ASCII letters lowercased. -/
def lowerT (t : alloc.vec.Vec U8) : alloc.vec.Vec U8 :=
  .from (t.val.map lowerB) (by simp)

theorem lower_text_eq (t : alloc.vec.Vec U8) :
    lower_text t = (do let a ← (t.val.foldlM (fun (out : alloc.vec.Vec U8) c => do let x ← search.lower_ascii c; out.push x)
      (alloc.vec.Vec.new U8)); ok a) := by
  unfold lower_text lower_text_loop
  have := loop_foldlM t.val t.len_ineq (fun (out : alloc.vec.Vec U8) c => do let x ← search.lower_ascii c; out.push x) id
    (fun a i => (a, i)) (fun x => lower_text_loop.body t x.1 x.2) ?_ (alloc.vec.Vec.new U8) 0#usize (by simp)
  · simpa using this
  · intro a i hi
    unfold lower_text_loop.body
    body_shape t

theorem lower_text_ok (t v : alloc.vec.Vec U8) (h : lower_text t = ok v) : v = lowerT t := by
  rw [lower_text_eq] at h
  simp only [lower_ascii_eq, bind_ok] at h
  have key : ∀ (l : List U8) (out w : alloc.vec.Vec U8),
      l.foldlM (fun (out : alloc.vec.Vec U8) c => out.push (lowerB c)) out = ok w → w.val = out.val ++ l.map lowerB := by
    intro l
    induction l with
    | nil => intro out w h; simp only [List.foldlM_nil, pure_tc_eq, ok.injEq] at h; subst h; simp
    | cons c cs ih =>
      intro out w h
      simp only [List.foldlM_cons] at h
      obtain ⟨o1, h1, h2⟩ := bind_tc_eq_ok.1 h
      rw [ih _ _ h2, push_ok h1]; simp
  obtain ⟨a, ha, h'⟩ := bind_tc_eq_ok.1 h
  simp only [ok.injEq] at h'; subst h'
  apply alloc.vec.Vec.ext
  rw [key _ _ _ ha]; simp [lowerT, alloc.vec.Vec.from_val]


theorem lower_text_total (t : alloc.vec.Vec U8) : lower_text t = ok (lowerT t) := by
  rw [lower_text_eq]
  simp only [lower_ascii_eq, bind_ok]
  have key : ∀ (l : List U8) (out : alloc.vec.Vec U8), out.val.length + l.length ≤ Usize.max →
      ∃ w : alloc.vec.Vec U8, l.foldlM (fun (out : alloc.vec.Vec U8) c => out.push (lowerB c)) out = ok w ∧
        w.val = out.val ++ l.map lowerB := by
    intro l
    induction l with
    | nil => intro out _; exact ⟨out, rfl, by simp⟩
    | cons c cs ih =>
      intro out hl
      simp only [List.length_cons] at hl
      obtain ⟨o1, h1, h2⟩ := (WP.spec_equiv_exists _ _).1 (alloc.vec.Vec.push_spec out (lowerB c) (by omega))
      obtain ⟨w, hw, hwv⟩ := ih o1 (by rw [h2]; simp; omega)
      exact ⟨w, by simp only [List.foldlM_cons, h1, bind_tc_ok]; exact hw, by rw [hwv, h2]; simp⟩
  obtain ⟨w, hw, hwv⟩ := key t.val (alloc.vec.Vec.new U8) (by simp)
  rw [hw]; simp only [bind_tc_ok, bind_ok]
  congr 1; apply alloc.vec.Vec.ext; rw [hwv]; simp [lowerT, vec_new_val, alloc.vec.Vec.from_val]

/-! ## The plans, written out

`readsA` is `reads` read as `H5iAppLib.Query` reads (`reads_abs`); the
frame theorem is stated over it. Tables and columns are numbered as in
`schema!`: users 0 (id, username, ..., sharing 7), tokens 1 (key, user),
bookmarks 2 (owner, added, id, url, url_norm, ..., unread 8, archived 9,
shared 10), tags 3 (id, owner, name, name_lower), links 4 (bookmark, tag),
bundles 5 (id, owner, ...), the counter 6. -/

abbrev Text := alloc.vec.Vec U8

def eqU (c : Nat) (u : U64) : Pred Val := .eq c (int u.val)
def eqB (c : Nat) (t : Text) : Pred Val := .eq c (.Bytes t)
def eqT (c : Nat) (b : Bool) : Pred Val := .eq c (.Bool b)

/-- Column `c` is the user of token `t`. -/
def mineA (c : Nat) (t : Text) : Pred Val := .isIn c 1 (eqB 0 t) 1 {}

/-- The caller's token row and user row (`extra` names more users). -/
def callerA (t : Text) : List (Read Val) := [⟨1, eqB 0 t, {}⟩, ⟨0, mineA 0 t, {}⟩]
def callerAndA (t : Text) (extra : Pred Val) : List (Read Val) := [⟨1, eqB 0 t, {}⟩, ⟨0, .or (mineA 0 t) extra, {}⟩]

/-- The links of the bookmarks `p` and `w` keep, and their tags. -/
def tagReadsA (p : Pred Val) (w : Window) : List (Read Val) :=
  [⟨4, .isIn 0 2 p 2 w, {}⟩, ⟨3, .isIn 0 4 (.isIn 0 2 p 2 w) 1 {}, {}⟩]

def scopeA (t : Text) (scope : U8) : Pred Val := .and (mineA 0 t) (eqT 9 (decide (scope = SCOPE_ARCHIVED)))
def sharedA : Pred Val := .and (eqT 10 true) (.isIn 0 0 (eqT 7 true) 0 {})
def urlA (t url norm : Text) : Pred Val :=
  .and (mineA 0 t) (.or (eqB 4 norm) (.and (eqB 4 (alloc.vec.Vec.new U8)) (eqB 3 url)))
def byIdA (id : U64) : Pred Val := eqU 2 id

/-- The caller's tags with one of these names, any case. -/
def namedA (t : Text) (names : List Text) : Pred Val :=
  .and (mineA 1 t) (names.foldl (fun p n => .or p (eqB 3 (lowerT n))) (.and (eqU 0 0#u64) (eqU 0 1#u64)))

/-- Bookmarks with a tag of lowercased name `lower`. -/
def taggedA (lower : Text) : Pred Val := .isIn 2 4 (.isIn 1 3 (eqB 3 lower) 0 {}) 0 {}

/-- What a `simple_query` selects. -/
def simpleA (tags : List Text) (unread : Bool) : Pred Val :=
  tags.foldl (fun p x => .and p (taggedA (lowerT x))) (if unread then eqT 8 true else .all)

def searchA (q : Text) : Pred Val :=
  match (simple_query q).match with
  | .ok (some (tags, unread)) => simpleA tags.val unread
  | _ => .all

def flagA (col : Nat) (rule : U8) (base : Pred Val) : Pred Val :=
  if rule = FLAG_YES then .and base (eqT col true) else if rule = FLAG_NO then .and base (eqT col false) else base

def pagedPredA (t : Text) (scope : U8) (q : Text) (unread shared : U8) : Pred Val :=
  flagA 10 shared (flagA 8 unread (.and (scopeA t scope) (searchA q)))

/-- The newest `offset + limit` rows. -/
def newestW (off lim : U64) : Window :=
  ⟨true, 0, if lim.val > U64.rMax - off.val then none else some (off.val + lim.val)⟩

/-- Whether `paged` holds of a listing's filter. -/
def pagedOf (flt : Filter) : Bool :=
  match (paged flt).match with
  | .ok b => b
  | _ => false

def bundleReadA (t : Text) : Option U64 → List (Read Val)
  | none => []
  | some id => [⟨5, .and (eqU 0 id) (mineA 1 t), {}⟩]

/-- The users a shared listing reads besides the caller: those who share,
and `?user=`. -/
def sharersA : Option Text → Pred Val
  | none => eqT 7 true
  | some n => .or (eqT 7 true) (eqB 1 n)

def listA (t : Text) (flt : Filter) (lim off : U64) : List (Read Val) :=
  if flt.scope = SCOPE_SHARED then
    callerAndA t (sharersA flt.user) ++
      [⟨2, sharedA, {}⟩] ++ tagReadsA sharedA {} ++ bundleReadA t flt.bundle
  else if pagedOf flt then
    callerA t ++ [⟨2, pagedPredA t flt.scope flt.q flt.unread flt.shared, newestW off lim⟩] ++
      tagReadsA (pagedPredA t flt.scope flt.q flt.unread flt.shared) (newestW off lim)
  else
    callerA t ++ [⟨2, scopeA t flt.scope, {}⟩] ++ tagReadsA (scopeA t flt.scope) {} ++ bundleReadA t flt.bundle

def orE (o : Option Text) : Text := o.getD (alloc.vec.Vec.new U8)
def namesOf (o : Option (alloc.vec.Vec Text)) : List Text := (o.getD (alloc.vec.Vec.new Text)).val

def readsA (a : Principal) : Command → Option (List (Read Val))
  | .Profile => some (callerA a.token)
  | .List flt lim off => some (listA a.token flt lim off)
  | .Check url norm => some (callerA a.token ++ [⟨2, urlA a.token url norm, {}⟩] ++ tagReadsA (urlA a.token url norm) {})
  | .GetBookmark id => some (callerA a.token ++ [⟨2, byIdA id, {}⟩] ++ tagReadsA (byIdA id) {})
  | .CreateBookmark f _ =>
    some (callerA a.token ++ [⟨2, urlA a.token (orE f.url) (orE f.url_norm), {}⟩,
      ⟨3, namedA a.token (namesOf f.tags), {}⟩, ⟨6, .all, {}⟩])
  | .UpdateBookmark id f _ =>
    some (callerA a.token ++
      [⟨2, (match f.url with | none => byIdA id | some u => .or (byIdA id) (.and (mineA 0 a.token) (eqB 3 u))), {}⟩,
       ⟨4, eqU 0 id, {}⟩, ⟨3, .or (.isIn 0 4 (eqU 0 id) 1 {}) (namedA a.token (namesOf f.tags)), {}⟩, ⟨6, .all, {}⟩])
  | .DeleteBookmark id => some (callerA a.token ++ [⟨2, byIdA id, {}⟩])
  | .Archive id _ _ => some (callerA a.token ++ [⟨2, byIdA id, {}⟩])
  | .ListTags lim off =>
    some (callerA a.token ++
      [⟨3, mineA 1 a.token, ⟨false, 0, if lim.val > U64.rMax - off.val then none else some (off.val + lim.val)⟩⟩])
  | .CreateTag n _ => some (callerA a.token ++ [⟨3, namedA a.token [n], {}⟩, ⟨6, .all, {}⟩])
  | .GetTag id => some (callerA a.token ++ [⟨3, eqU 0 id, {}⟩])
  | .DeleteTag id => some (callerA a.token ++ [⟨3, eqU 0 id, {}⟩])
  | .ListBundles _ _ => some (callerA a.token ++ [⟨5, mineA 1 a.token, {}⟩])
  | .CreateBundle _ _ => some (callerA a.token ++ [⟨5, mineA 1 a.token, {}⟩, ⟨6, .all, {}⟩])
  | .GetBundle _ => some (callerA a.token ++ [⟨5, mineA 1 a.token, {}⟩])
  | .UpdateBundle _ _ _ => some (callerA a.token ++ [⟨5, mineA 1 a.token, {}⟩])
  | .DeleteBundle _ => some (callerA a.token ++ [⟨5, mineA 1 a.token, {}⟩])

/-- What `list_count` counts, as an `H5iAppLib.Query` read: a paged
listing's selection without the page, or the caller's tags. -/
def countA (a : Principal) : Command → Option (Read Val)
  | .List flt _ _ => if pagedOf flt then some ⟨2, pagedPredA a.token flt.scope flt.q flt.unread flt.shared, {}⟩ else none
  | .ListTags _ _ => some ⟨3, mineA 1 a.token, {}⟩
  | _ => none

theorem bytes_eq (v : alloc.vec.Vec U8) : alloc.vec.VecU8.Insts.H5i_app_sqlColumn.to_val v = ok (.Bytes v) :=
  eq_ok_of_spec (bytes_to_val v)

theorem bool_eq (b : Bool) : Bool.Insts.H5i_app_sqlColumn.to_val b = ok (.Bool b) :=
  eq_ok_of_spec (bool_to_val b)

theorem or_empty_eq (o : Option Text) : or_empty o = ok (orE o) := by
  cases o <;> simp [or_empty, orE, Schema.u8vec_clone]

/-- Unfolds the plan builders. -/
macro "plan_simp" l:(Lean.Parser.Tactic.location)? : tactic => `(tactic| simp [reads, caller_reads, caller_reads_and, rd, mine, by_id, url_pred,
  tag_reads, sel_pred,
  v_int, v_bool, v_bytes, p_eq, p_in, p_or, p_and, whole, h5i_app_sql.whole, bytes_eq, bool_eq, u64_to_val_eq,
  or_empty_eq, Schema.u8vec_clone, alloc.vec.Vec.push, alloc.vec.Vec.from_val, U32.max, U32.numBits,
  planOf, readsA, Read.abs, Pred.abs, Window.abs, callerA, tagReadsA, urlA, byIdA, mineA, eqU, eqB, eqT,
  T_USERS, T_TOKENS, T_BOOKMARKS, T_TAGS, T_LINKS, T_BUNDLES, T_COUNTER, USER_ID, TOKEN_KEY, TOKEN_USER,
  BM_OWNER, BM_ID, BM_URL, BM_URL_NORM, TAG_ID, TAG_OWNER, TAG_LOWER, LINK_BOOKMARK, LINK_TAG, BUNDLE_ID,
  BUNDLE_OWNER] $[$l]?)

theorem foldlM_abs {α β γ : Type} (step : β → α → Result β) (F : β → γ) (g : γ → α → γ)
    (hs : ∀ a x r, step a x = ok r → F r = g (F a) x) :
    ∀ (l : List α) (a r : β), l.foldlM step a = ok r → F r = l.foldl g (F a) := by
  intro l
  induction l with
  | nil => intro a r h; simp only [List.foldlM_nil, pure_tc_eq, ok.injEq] at h; subst h; rfl
  | cons x xs ih =>
    intro a r h
    simp only [List.foldlM_cons] at h
    obtain ⟨a1, h1, h2⟩ := bind_tc_eq_ok.1 h
    rw [ih _ _ h2, hs _ _ _ h1]; rfl

theorem named_tags_ok (t : Text) (names : alloc.vec.Vec Text) (res : h5i_app_sql.Pred)
    (h : named_tags t names = ok res) : Pred.abs res = namedA t names.val := by
  have hs : ∀ (a : h5i_app_sql.Pred) (x : Text) r0,
      (do let v1 ← lower_text x; let v2 ← v_bytes v1; let p ← p_eq TAG_LOWER v2; p_or a p) = ok r0 →
        Pred.abs r0 = (fun p n => .or p (eqB 3 (lowerT n))) (Pred.abs a) x := by
    intro a x r0 hr
    h5i_invert hr
    rw [lower_text_ok _ _ hv1] at hv2
    simp only [v_bytes, bytes_eq, ok.injEq] at hv2; subst hv2
    simp only [p_or, p_eq, ok.injEq] at hr hp; subst hp; subst hr
    simp [Pred.abs, eqB, TAG_LOWER]
  unfold named_tags at h
  h5i_invert h
  have hl : named_tags_loop names any 0#usize = (do let a ← (names.val.foldlM (fun (any : h5i_app_sql.Pred) n =>
      do let v1 ← lower_text n; let v2 ← v_bytes v1; let p ← p_eq TAG_LOWER v2; p_or any p) any); ok a) := by
    unfold named_tags_loop
    have := loop_foldlM names.val names.len_ineq (fun (any : h5i_app_sql.Pred) n =>
      do let v1 ← lower_text n; let v2 ← v_bytes v1; let p ← p_eq TAG_LOWER v2; p_or any p) id
      (fun a i => (a, i)) (fun x => named_tags_loop.body names x.1 x.2) ?_ any 0#usize (by simp)
    · simpa using this
    · intro a i hi
      unfold named_tags_loop.body
      body_shape names
  rw [hl] at hany1
  obtain ⟨a1, ha1, e⟩ := bind_tc_eq_ok.1 hany1
  simp only [ok.injEq] at e; subst e
  have := foldlM_abs _ Pred.abs (fun p n => .or p (eqB 3 (lowerT n))) hs _ _ _ ha1
  simp only [p_and, ok.injEq] at h; subst h
  simp only [mine, v_bytes, bytes_eq, p_eq, whole, h5i_app_sql.whole, p_in, bind_tc_ok, bind_ok, ok.injEq] at hp
  subst hp
  simp only [p_none_tag, v_int, u64_to_val_eq, p_eq, p_and, bind_tc_ok, bind_ok, ok.injEq] at hany
  subst hany
  simp [Pred.abs, namedA, this, mineA, eqU, eqB, Window.abs, TAG_OWNER, TOKEN_KEY, TOKEN_USER, T_TOKENS, TAG_ID]

theorem search_pred_ok (q : Text) (res : h5i_app_sql.Pred) (h : search_pred q = ok res) :
    Pred.abs res = searchA q := by
  have hs : ∀ (a : h5i_app_sql.Pred) (x : Text) r0,
      (do let v1 ← lower_text x; let p1 ← tagged v1; p_and a p1) = ok r0 →
        Pred.abs r0 = (fun p x => .and p (taggedA (lowerT x))) (Pred.abs a) x := by
    intro a x r0 hr
    h5i_invert hr
    rw [lower_text_ok _ _ hv1] at hp1
    simp only [tagged, v_bytes, bytes_eq, p_eq, whole, h5i_app_sql.whole, p_in, bind_ok, ok.injEq] at hp1
    subst hp1
    simp only [p_and, ok.injEq] at hr; subst hr
    simp [Pred.abs, taggedA, eqB, Window.abs, TAG_LOWER, LINK_TAG, T_TAGS, TAG_ID, BM_ID, T_LINKS, LINK_BOOKMARK]
  unfold search_pred at h
  h5i_invert h
  · have hm : (simple_query q).match = .ok none := by rw [ho]; rfl
    simp [searchA, hm, Pred.abs]
  · obtain ⟨tags, unread⟩ := p
    have hl : ∀ p1, search_pred_loop tags p1 0#usize =
        (do let a ← (tags.val.foldlM (fun (p : h5i_app_sql.Pred) x => do let v1 ← lower_text x; let p1 ← tagged v1; p_and p p1) p1); ok a) := by
      intro p1
      unfold search_pred_loop
      have := loop_foldlM tags.val tags.len_ineq (fun (p : h5i_app_sql.Pred) x =>
        do let v1 ← lower_text x; let p1 ← tagged v1; p_and p p1) id
        (fun a i => (a, i)) (fun x => search_pred_loop.body tags x.1 x.2) ?_ p1 0#usize (by simp)
      · simpa using this
      · intro a i hi
        unfold search_pred_loop.body
        body_shape tags
    change (do let p1 ← (if unread then (do let v ← v_bool true; p_eq BM_UNREAD v) else ok h5i_app_sql.Pred.All); search_pred_loop tags p1 0#usize) = ok res at h
    obtain ⟨p1, hp1, h2⟩ := bind_tc_eq_ok.1 h
    rw [hl] at h2
    obtain ⟨a1, ha1, e⟩ := bind_tc_eq_ok.1 h2
    simp only [ok.injEq] at e; subst e
    rw [foldlM_abs _ Pred.abs (fun p x => .and p (taggedA (lowerT x))) hs _ _ _ ha1]
    have hm : (simple_query q).match = .ok (some (tags, unread)) := by rw [ho]; rfl
    simp only [searchA, hm, simpleA]
    congr 1
    cases unread <;> simp [v_bool, bool_eq, p_eq] at hp1 <;> subst hp1 <;> simp [Pred.abs, eqT, BM_UNREAD]

theorem flag_pred_ok (col : U32) (rule : U8) (base res : h5i_app_sql.Pred) (h : flag_pred col rule base = ok res) :
    Pred.abs res = flagA col.val rule (Pred.abs base) := by
  unfold flag_pred at h
  split at h
  · simp [v_bool, bool_eq, p_eq, p_and] at h; subst h; simp [flagA, *, Pred.abs, eqT]
  · split at h
    · simp [v_bool, bool_eq, p_eq, p_and] at h; subst h; simp [flagA, *, Pred.abs, eqT, FLAG_NO, FLAG_YES]
    · simp at h; subst h; simp [flagA, *]

theorem scope_pred_eq (t : Text) (scope : U8) : ∃ p, scope_pred t scope = ok p ∧ Pred.abs p = scopeA t scope := by
  simp [scope_pred, mine, v_bytes, bytes_eq, v_bool, bool_eq, p_eq, whole, h5i_app_sql.whole, p_in, p_and,
    Pred.abs, scopeA, mineA, eqB, eqT, Window.abs, BM_OWNER, BM_ARCHIVED, TOKEN_KEY, TOKEN_USER, T_TOKENS]

theorem paged_pred_ok (t : Text) (scope : U8) (q : Text) (u sh : U8) (res : h5i_app_sql.Pred)
    (h : paged_pred t scope q u sh = ok res) : Pred.abs res = pagedPredA t scope q u sh := by
  unfold paged_pred at h
  h5i_invert h
  obtain ⟨p0, hp0, ha0⟩ := scope_pred_eq t scope
  rw [hp0] at hp; simp only [ok.injEq] at hp; subst hp
  simp only [p_and, ok.injEq] at hbase; subst hbase
  rw [flag_pred_ok _ _ _ _ h, flag_pred_ok _ _ _ _ hp2]
  simp [pagedPredA, Pred.abs, ha0, search_pred_ok _ _ hp1, BM_SHARED, BM_UNREAD]

theorem caller_reads_eq (t : Text) : ∃ v, caller_reads t = ok v ∧ v.val.map Read.abs = callerA t := by
  plan_simp

theorem caller_reads_and_eq (t : Text) (extra : h5i_app_sql.Pred) :
    ∃ v, caller_reads_and t extra = ok v ∧ v.val.map Read.abs = callerAndA t (Pred.abs extra) := by
  plan_simp
  simp [callerAndA, mineA, eqB]

theorem push_abs (v w : alloc.vec.Vec h5i_app_sql.Read) (r : h5i_app_sql.Read) (h : v.push r = ok w) :
    w.val.map Read.abs = v.val.map Read.abs ++ [Read.abs r] := by
  rw [push_ok h]; simp

theorem tag_reads_ok (sel : Sel) (w : h5i_app_sql.Window) (out v : alloc.vec.Vec h5i_app_sql.Read)
    (p : h5i_app_sql.Pred) (hp : sel_pred sel = ok p) (h : tag_reads sel w out = ok v) :
    v.val.map Read.abs = out.val.map Read.abs ++ tagReadsA (Pred.abs p) (Window.abs w) := by
  unfold tag_reads at h
  rw [hp] at h
  h5i_invert h
  rw [push_abs _ _ _ h, push_abs _ _ _ hout1]
  simp only [p_in, rd, whole, h5i_app_sql.whole, ok.injEq, bind_ok, bind_tc_ok] at hp1 hr hp2 hw1 hp3 hr1
  subst_vars
  simp [Read.abs, Pred.abs, tagReadsA, Window.abs, T_LINKS, T_TAGS, T_BOOKMARKS, LINK_BOOKMARK, LINK_TAG, BM_ID,
    TAG_ID]

theorem bundle_read_ok (t : Text) (flt : Filter) (out res : alloc.vec.Vec h5i_app_sql.Read)
    (h : bundle_read t flt out = ok res) : res.val.map Read.abs = out.val.map Read.abs ++ bundleReadA t flt.bundle := by
  unfold bundle_read at h
  split at h
  · rename_i hb; simp only [ok.injEq] at h; subst h; simp [hb, bundleReadA]
  · rename_i id hb
    h5i_invert h
    rw [push_abs _ _ _ h]
    simp only [v_int, u64_to_val_eq, p_eq, mine, v_bytes, bytes_eq, whole, h5i_app_sql.whole, p_in, p_and, rd,
      ok.injEq, bind_ok, bind_tc_ok] at hv hp hp1 hp2 hr
    subst_vars
    simp [hb, bundleReadA, Read.abs, Pred.abs, Window.abs, eqU, mineA, eqB, T_BUNDLES, BUNDLE_ID, BUNDLE_OWNER,
      TOKEN_KEY, TOKEN_USER, T_TOKENS]

theorem newest_ok (off lim : U64) (w : h5i_app_sql.Window) (h : newest off lim = ok w) :
    Window.abs w = newestW off lim := by
  unfold newest at h
  h5i_invert h
  · have : lim.val > U64.rMax - off.val := by
      have h1 : (core.num.U64.MAX).val = U64.rMax := by simp [core.num.U64.MAX]
      h5i_arith
    simp [Window.abs, newestW, this]
  · have : ¬ lim.val > U64.rMax - off.val := by
      have h1 : (core.num.U64.MAX).val = U64.rMax := by simp [core.num.U64.MAX]
      h5i_arith
    simp only [newestW, this, if_false, Window.abs]
    simp only [Option.map_some, Window.mk.injEq, true_and]
    h5i_arith

theorem pagedOf_eq {flt : Filter} {b : Bool} (h : paged flt = ok b) : pagedOf flt = b := by
  have hm : (paged flt).match = .ok b := by rw [h]; rfl
  simp [pagedOf, hm]

theorem list_reads_ok (t : Text) (flt : Filter) (lim off : U64) (v : alloc.vec.Vec h5i_app_sql.Read)
    (h : list_reads t flt lim off = ok v) : v.val.map Read.abs = listA t flt lim off := by
  unfold list_reads at h
  h5i_invert h
  · obtain ⟨o, extra⟩ := x
    change (do let out ← caller_reads_and t extra; let p ← shared_pred; let r ← rd T_BOOKMARKS p; let out1 ← out.push r; let w ← whole; let out2 ← tag_reads Sel.Shared w out1; bundle_read t { flt with user := o } out2) = ok v at h
    h5i_invert h
    obtain ⟨out0, hc0, ha0⟩ := caller_reads_and_eq t extra
    rw [hc0] at hout; simp only [ok.injEq] at hout; subst hout
    have hsp : shared_pred = ok (.And (.Eq BM_SHARED (.Bool true)) (.In BM_OWNER T_USERS (.Eq USER_SHARING (.Bool true)) USER_ID
        { desc := false, offset := 0#u64, limit := none })) := by
      simp [shared_pred, v_bool, bool_eq, p_eq, whole, h5i_app_sql.whole, p_in, p_and]
    rw [hsp] at hp; simp only [ok.injEq] at hp; subst hp
    have htr := tag_reads_ok Sel.Shared w out1 out2 _ (by simp only [sel_pred]; exact hsp) hout2
    rw [bundle_read_ok _ _ _ _ h, htr, push_abs _ _ _ hout1, ha0]
    simp only [rd, whole, h5i_app_sql.whole, ok.injEq, bind_ok, bind_tc_ok] at hr hw; subst hr hw
    have hx' : Pred.abs extra = sharersA flt.user := by
      cases hu : flt.user <;> simp only [hu] at hx <;>
        simp [v_bool, bool_eq, p_eq, v_bytes, bytes_eq, p_or] at hx <;> obtain ⟨-, rfl⟩ := hx <;>
        simp [Pred.abs, sharersA, eqT, eqB, USER_SHARING, USER_NAME]
    simp [listA, hc, hx', Read.abs, Pred.abs, Window.abs, sharedA, eqT, T_BOOKMARKS, BM_SHARED, BM_OWNER, T_USERS,
      USER_SHARING, USER_ID]
  · obtain ⟨out0, hc0, ha0⟩ := caller_reads_eq t
    rw [hc0] at hout; simp only [ok.injEq] at hout; subst hout
    simp only [Schema.u8vec_clone, ok.injEq] at hv_1 hv1; subst hv_1 hv1
    rw [tag_reads_ok _ _ _ _ _ hp h, push_abs _ _ _ hout1, ha0]
    simp only [sel_pred] at hp
    simp [listA, hc, pagedOf_eq hb, hc_1, Read.abs, paged_pred_ok _ _ _ _ _ _ hp, newest_ok _ _ _ hw, T_BOOKMARKS]
  · obtain ⟨out0, hc0, ha0⟩ := caller_reads_eq t
    rw [hc0] at hout; simp only [ok.injEq] at hout; subst hout
    simp only [Schema.u8vec_clone, ok.injEq] at hv_1; subst hv_1
    rw [bundle_read_ok _ _ _ _ h, tag_reads_ok _ _ _ _ _ hp hout2, push_abs _ _ _ hout1, ha0]
    obtain ⟨p0, hp0, ha⟩ := scope_pred_eq t flt.scope
    simp only [sel_pred, hp0, ok.injEq] at hp; subst hp
    simp only [rd, whole, h5i_app_sql.whole, ok.injEq, bind_ok, bind_tc_ok] at hr hw; subst hr hw
    simp [listA, hc, pagedOf_eq hb, hc_1, Read.abs, ha, Window.abs, T_BOOKMARKS]

theorem names_clone (n : alloc.vec.Vec Text) :
    alloc.vec.CloneVec.clone (core.clone.CloneallocvecVec core.clone.CloneU8) n = ok n :=
  vec_clone_eq _ n (fun x => Schema.u8vec_clone x)

/-- The tag names of a request, cloned: one goal per case of `o`. -/
macro "names_of" h:ident o:term:max ht:ident : tactic => `(tactic| (
  cases $ht:ident : $o <;> simp only [$ht:ident, names_clone, ok.injEq] at $h:ident <;> subst $h:ident))

theorem lim_ok (off lim : U64) (l : Option U64)
    (h : (do let i ← core.num.U64.MAX - off; if lim > i then ok none else (do let i1 ← off + lim; ok (some i1))) = ok l) :
    l.map (·.val) = if lim.val > U64.rMax - off.val then none else some (off.val + lim.val) := by
  h5i_invert h
  · have : lim.val > U64.rMax - off.val := by
      have h1 : (core.num.U64.MAX).val = U64.rMax := by simp [core.num.U64.MAX]
      h5i_arith
    simp [this]
  · have : ¬ lim.val > U64.rMax - off.val := by
      have h1 : (core.num.U64.MAX).val = U64.rMax := by simp [core.num.U64.MAX]
      h5i_arith
    simp only [this, if_false, Option.map_some, Option.some.injEq]
    h5i_arith

/-- The extracted `reads` computes `readsA`. -/
theorem reads_abs (a : Principal) (c : Command) (o : Option (alloc.vec.Vec h5i_app_sql.Read))
    (h : reads a c = ok o) : planOf o = readsA a c := by
  obtain ⟨cr, hcr, hca⟩ := caller_reads_eq a.token
  cases c
  case List flt lim off =>
    simp only [reads] at h
    h5i_invert h
    simp [planOf, readsA, list_reads_ok _ _ _ _ _ hv]
  case CreateBookmark f now =>
    simp only [reads, or_empty_eq, hcr] at h
    h5i_invert h
    names_of hnames f.tags ht
    all_goals
      have hn := named_tags_ok _ _ _ hp1
      plan_simp at hp hr hr1 hr2
      subst_vars
      simp only [planOf, Option.map_some, Option.some.injEq]
      rw [push_abs _ _ _ hout3, push_abs _ _ _ hout2, push_abs _ _ _ hout1, hca]
      simp [planOf, readsA, Read.abs, hn, namesOf, ht, urlA, mineA, eqB, T_BOOKMARKS, T_TAGS, T_COUNTER, Window.abs,
        BM_OWNER, BM_URL, BM_URL_NORM, TOKEN_KEY, TOKEN_USER, T_TOKENS, Pred.abs]
  case UpdateBookmark id f now =>
    simp only [reads, hcr] at h
    h5i_invert h
    all_goals names_of hnames f.tags ht
    all_goals
      have hn := named_tags_ok _ _ _ hp3
      plan_simp at hdup hr hv hp hr1 hp1 hw hp2 hr2 hr3
      subst_vars
      simp only [p_or, ok.injEq] at hp4; subst hp4
      simp only [planOf, Option.map_some, Option.some.injEq]
      rw [push_abs _ _ _ hout4, push_abs _ _ _ hout3, push_abs _ _ _ hout2, push_abs _ _ _ hout1, hca]
      cases hu : f.url <;> simp only [hu, ok.injEq] at hdup <;> subst hdup <;>
      simp [readsA, Read.abs, hn, namesOf, ht, hu, byIdA, mineA, eqB, eqU, T_BOOKMARKS, T_TAGS, T_COUNTER, T_LINKS,
        Window.abs, BM_OWNER, BM_URL, BM_ID, TOKEN_KEY, TOKEN_USER, T_TOKENS, Pred.abs, LINK_BOOKMARK, LINK_TAG, TAG_ID]
  case CreateTag n now =>
    simp only [reads, hcr, Schema.u8vec_clone, bind_tc_ok, bind_ok] at h
    h5i_invert h
    have hn := named_tags_ok _ _ _ hp
    rw [push_ok hnames] at hn
    plan_simp at hr hr1
    subst_vars
    simp only [planOf, Option.map_some, Option.some.injEq]
    rw [push_abs _ _ _ hout2, push_abs _ _ _ hout1, hca]
    simp [readsA, Read.abs, hn, T_TAGS, T_COUNTER, Window.abs, Pred.abs, vec_new_val]
  case ListTags lim off =>
    simp only [reads, hcr] at h
    h5i_invert h
    all_goals
      plan_simp at hp
      subst hp
      simp only [planOf, Option.map_some, Option.some.injEq]
      rw [push_abs _ _ _ hout1, hca]
    have hl := lim_ok off lim lim_1 (by rw [hi]; simpa using hlim_1)
    simp [readsA, Read.abs, Window.abs, hl, Pred.abs, mineA, eqB, T_TAGS, TAG_OWNER, TOKEN_KEY, TOKEN_USER, T_TOKENS]
  all_goals (plan_simp at h; subst h; plan_simp)

/-- The extracted `list_count` computes `countA`. -/
theorem count_abs (a : Principal) (c : Command) (o : Option h5i_app_sql.Read) (h : list_count a c = ok o) :
    o.map Read.abs = countA a c := by
  cases c
  case List flt lim off =>
    simp only [list_count] at h
    h5i_invert h
    · simp only [rd, whole, h5i_app_sql.whole, bind_ok, bind_tc_ok, ok.injEq] at hr; subst hr
      simp [countA, pagedOf_eq hb, hc, Read.abs, paged_pred_ok _ _ _ _ _ _ hp, Window.abs, T_BOOKMARKS]
    · simp [countA, pagedOf_eq hb, hc]
  case ListTags lim off =>
    simp [list_count, rd, mine, v_bytes, bytes_eq, p_eq, whole, h5i_app_sql.whole, p_in] at h
    subst h
    simp [countA, Read.abs, Pred.abs, Window.abs, mineA, eqB, T_TAGS, TAG_OWNER, TOKEN_KEY, TOKEN_USER, T_TOKENS]
  all_goals (simp [list_count] at h; subst h; rfl)

end linkding_kernel.Plan
