diff --git a/server/lib/src/server/access/h5i.rs b/server/lib/src/server/access/h5i.rs
new file mode 100644
index 0000000..968a134
--- /dev/null
+++ b/server/lib/src/server/access/h5i.rs
@@ -0,0 +1,252 @@
+//! The shell around kanidm's verified access-control kernel (`kanidm-kernel`,
+//! proven in Lean in h5i-app-bench). Profiles, identities, entries, filters
+//! and modify lists are converted to the kernel's types; the kernel decides.
+//! Values of syntaxes the kernel has no form for keep their attribute (so
+//! presence and attribute names are exact) with no values; a filter or
+//! profile that compares such a value has no kernel form, and the caller
+//! falls back to the upstream evaluation.
+
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+use hashbrown::HashMap;
+use uuid::Uuid;
+
+pub(crate) use kanidm_kernel as k;
+
+use super::profiles::{
+    AccessControlCreate, AccessControlDelete, AccessControlModify, AccessControlProfile,
+    AccessControlReceiver, AccessControlSearch, AccessControlTarget,
+};
+use super::{Access, AccessClass, AccessEffectivePermission};
+use crate::prelude::*;
+use crate::server::identity::{AccessScope, IdentType, InternalRole};
+use crate::value::SyntaxType;
+
+pub(crate) fn attr(a: &Attribute) -> Vec<u8> {
+    a.as_str().as_bytes().to_vec()
+}
+
+pub(crate) fn attrs<'a>(it: impl IntoIterator<Item = &'a Attribute>) -> Vec<Vec<u8>> {
+    it.into_iter().map(attr).collect()
+}
+
+fn attr_back(b: &[u8]) -> Attribute {
+    Attribute::from(String::from_utf8_lossy(b).as_ref())
+}
+
+fn uuid(u: &Uuid) -> k::Uuid {
+    u.as_u128()
+}
+
+/// `None` for a value the kernel has no form for.
+pub(crate) fn pv(v: &PartialValue) -> Option<k::PartialValue> {
+    Some(match v {
+        PartialValue::Utf8(s) => k::PartialValue::Utf8(s.as_bytes().to_vec()),
+        PartialValue::Iutf8(s) => k::PartialValue::Iutf8(s.as_bytes().to_vec()),
+        PartialValue::Iname(s) => k::PartialValue::Iname(s.as_bytes().to_vec()),
+        PartialValue::Uuid(u) => k::PartialValue::Uuid(uuid(u)),
+        PartialValue::Refer(u) => k::PartialValue::Refer(uuid(u)),
+        PartialValue::Uint32(n) => k::PartialValue::Uint32(*n),
+        _ => return None,
+    })
+}
+
+/// A modify-list value. Only `class` values are compared by the kernel; other
+/// values of unsupported syntaxes stand in as an empty string.
+fn value(a: &Attribute, v: &Value) -> Option<k::Value> {
+    Some(match v {
+        Value::Utf8(s) => k::PartialValue::Utf8(s.as_bytes().to_vec()),
+        Value::Iutf8(s) => k::PartialValue::Iutf8(s.as_bytes().to_vec()),
+        Value::Iname(s) => k::PartialValue::Iname(s.as_bytes().to_vec()),
+        Value::Uuid(u) => k::PartialValue::Uuid(uuid(u)),
+        Value::Refer(u) => k::PartialValue::Refer(uuid(u)),
+        Value::Uint32(n) => k::PartialValue::Uint32(*n),
+        _ if *a == Attribute::Class => return None,
+        _ => k::PartialValue::Utf8(Vec::new()),
+    })
+}
+
+fn mod_pv(a: &Attribute, p: &PartialValue) -> Option<k::PartialValue> {
+    match pv(p) {
+        Some(x) => Some(x),
+        None if *a == Attribute::Class => None,
+        None => Some(k::PartialValue::Utf8(Vec::new())),
+    }
+}
+
+fn strings(it: impl Iterator<Item = impl AsRef<str>>) -> Vec<Vec<u8>> {
+    it.map(|s| s.as_ref().as_bytes().to_vec()).collect()
+}
+
+pub(crate) fn valueset(vs: &ValueSet) -> k::ValueSet {
+    let empty = || k::ValueSet::Utf8(Vec::new());
+    match vs.syntax() {
+        SyntaxType::Utf8String => vs.as_utf8_set().map(|s| k::ValueSet::Utf8(strings(s.iter()))),
+        SyntaxType::Utf8StringInsensitive => vs.as_iutf8_set().map(|s| k::ValueSet::Iutf8(strings(s.iter()))),
+        SyntaxType::Utf8StringIname => vs.as_iname_set().map(|s| k::ValueSet::Iname(strings(s.iter()))),
+        SyntaxType::Uuid => vs.as_uuid_set().map(|s| k::ValueSet::Uuid(s.iter().map(uuid).collect())),
+        SyntaxType::ReferenceUuid => vs.as_refer_set().map(|s| k::ValueSet::Refer(s.iter().map(uuid).collect())),
+        SyntaxType::Uint32 => vs.as_uint32_set().map(|s| k::ValueSet::Uint32(s.iter().copied().collect())),
+        SyntaxType::OauthScopeMap => {
+            vs.as_oauthscopemap().map(|m| k::ValueSet::OauthScopeMap(m.keys().map(uuid).collect()))
+        }
+        _ => None,
+    }
+    .unwrap_or_else(empty)
+}
+
+pub(crate) fn entry<V, S>(e: &Entry<V, S>, id: Option<Uuid>) -> k::Entry {
+    let attrs = e
+        .get_ava_names()
+        .filter_map(|name| {
+            let a = Attribute::from(name);
+            e.get_ava_set(&a).map(|vs| k::Ava { attr: attr(&a), vs: valueset(vs) })
+        })
+        .collect();
+    k::Entry { uuid: id.map(|u| uuid(&u)).unwrap_or(0), attrs }
+}
+
+pub(crate) fn sealed(e: &Arc<EntrySealedCommitted>) -> k::Entry {
+    entry(e.as_ref(), Some(e.get_uuid()))
+}
+
+pub(crate) fn identity(i: &Identity) -> k::Identity {
+    let origin = match &i.origin {
+        IdentType::User(u) => k::IdentType::User(k::IdentUser { entry: sealed(&u.entry) }),
+        IdentType::Synch(u) => k::IdentType::Synch(uuid(u)),
+        IdentType::Internal(r) => k::IdentType::Internal(match r {
+            InternalRole::System => k::InternalRole::System,
+            InternalRole::Migration => k::InternalRole::Migration,
+            InternalRole::AccountRequest => k::InternalRole::AccountRequest,
+            InternalRole::MessageQueue => k::InternalRole::MessageQueue,
+        }),
+    };
+    let scope = match i.scope {
+        AccessScope::ReadOnly => k::AccessScope::ReadOnly,
+        AccessScope::ReadWrite => k::AccessScope::ReadWrite,
+        AccessScope::Synchronise => k::AccessScope::Synchronise,
+    };
+    k::Identity { origin, scope }
+}
+
+fn profile(p: &AccessControlProfile) -> Option<k::profiles::AccessControlProfile> {
+    let receiver = match &p.receiver {
+        AccessControlReceiver::None => k::profiles::AccessControlReceiver::None,
+        AccessControlReceiver::Group(g) => k::profiles::AccessControlReceiver::Group(g.iter().map(uuid).collect()),
+        AccessControlReceiver::EntryManager => k::profiles::AccessControlReceiver::EntryManager,
+    };
+    let target = match &p.target {
+        AccessControlTarget::None => k::profiles::AccessControlTarget::None,
+        AccessControlTarget::Scope(f) => k::profiles::AccessControlTarget::Scope(f.to_h5i()?),
+    };
+    Some(k::profiles::AccessControlProfile { receiver, target })
+}
+
+/// The loaded profiles and sync agreements; `None` when a profile has no
+/// kernel form.
+pub(crate) fn inner(
+    search: &[AccessControlSearch],
+    create: &[AccessControlCreate],
+    modify: &[AccessControlModify],
+    delete: &[AccessControlDelete],
+    sync: &HashMap<Uuid, BTreeSet<Attribute>>,
+) -> Option<k::AccessControlsInner> {
+    Some(k::AccessControlsInner {
+        acps_search: search
+            .iter()
+            .map(|a| Some(k::profiles::AccessControlSearch { acp: profile(&a.acp)?, attrs: attrs(&a.attrs) }))
+            .collect::<Option<_>>()?,
+        acps_create: create
+            .iter()
+            .map(|a| {
+                Some(k::profiles::AccessControlCreate {
+                    acp: profile(&a.acp)?,
+                    classes: strings(a.classes.iter()),
+                    attrs: attrs(&a.attrs),
+                })
+            })
+            .collect::<Option<_>>()?,
+        acps_modify: modify
+            .iter()
+            .map(|a| {
+                Some(k::profiles::AccessControlModify {
+                    acp: profile(&a.acp)?,
+                    presattrs: attrs(&a.presattrs),
+                    remattrs: attrs(&a.remattrs),
+                    pres_classes: strings(a.pres_classes.iter()),
+                    rem_classes: strings(a.rem_classes.iter()),
+                })
+            })
+            .collect::<Option<_>>()?,
+        acps_delete: delete
+            .iter()
+            .map(|a| Some(k::profiles::AccessControlDelete { acp: profile(&a.acp)? }))
+            .collect::<Option<_>>()?,
+        sync_agreements: sync
+            .iter()
+            .map(|(u, a)| k::SyncAgreement { uuid: uuid(u), attrs: attrs(a) })
+            .collect(),
+    })
+}
+
+pub(crate) fn modlist(ml: &ModifyList<ModifyValid>) -> Option<Vec<k::Modify>> {
+    ml.iter()
+        .map(|m| {
+            Some(match m {
+                Modify::Present(a, v) => k::Modify::Present(attr(a), value(a, v)?),
+                Modify::Removed(a, p) => k::Modify::Removed(attr(a), mod_pv(a, p)?),
+                Modify::Purged(a) => k::Modify::Purged(attr(a)),
+                Modify::Assert(a, p) => k::Modify::Assert(attr(a), mod_pv(a, p)?),
+                Modify::Set(a, vs) => {
+                    if *a == Attribute::Class && vs.as_iutf8_set().is_none() {
+                        return None;
+                    }
+                    k::Modify::Set(attr(a), valueset(vs))
+                }
+            })
+        })
+        .collect()
+}
+
+fn access(a: k::Access) -> Access {
+    match a {
+        k::Access::Grant => Access::Grant,
+        k::Access::Deny => Access::Deny,
+        k::Access::Allow(v) => Access::Allow(v.iter().map(|x| attr_back(x)).collect()),
+    }
+}
+
+fn access_class(a: k::AccessClass) -> AccessClass {
+    match a {
+        k::AccessClass::Grant => AccessClass::Grant,
+        k::AccessClass::Deny => AccessClass::Deny,
+        k::AccessClass::Allow(v) => {
+            AccessClass::Allow(v.into_iter().map(|c| String::from_utf8_lossy(&c).into_owned().into()).collect())
+        }
+    }
+}
+
+pub(crate) fn effective(p: k::AccessEffectivePermission) -> AccessEffectivePermission {
+    AccessEffectivePermission {
+        ident: Uuid::from_u128(p.ident),
+        target: Uuid::from_u128(p.target),
+        delete: p.delete,
+        search: access(p.search),
+        modify_pres: access(p.modify_pres),
+        modify_rem: access(p.modify_rem),
+        modify_pres_class: access_class(p.modify_pres_class),
+        modify_rem_class: access_class(p.modify_rem_class),
+    }
+}
+
+/// The attribute set of a kernel-reduced entry, for upstream's projection.
+pub(crate) fn reduced_attrs(e: &k::EntryReduced) -> BTreeSet<Attribute> {
+    e.attrs.iter().map(|a| attr_back(&a.attr)).collect()
+}
+
+/// An operation the kernel could not take: a profile or modify list compares
+/// a value it has no form for.
+pub(crate) fn fallback(op: &str) {
+    debug!(op, "access decision without a kernel form, upstream evaluation");
+}
