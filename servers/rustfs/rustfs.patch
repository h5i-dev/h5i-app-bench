diff --git a/crates/policy/src/policy/h5i.rs b/crates/policy/src/policy/h5i.rs
new file mode 100644
index 0000000..e31a6a1
--- /dev/null
+++ b/crates/policy/src/policy/h5i.rs
@@ -0,0 +1,205 @@
+//! The shell around rustfs's verified kernel (`rustfs-kernel`, proven in Lean
+//! in h5i-app-bench). Parsed policies and request arguments are converted to
+//! the kernel's types and the kernel decides. Parsing, IP addresses and the
+//! clock stay here.
+
+use std::collections::HashMap;
+use std::convert::Infallible;
+
+use h5i_app::{Kernel, TenantId};
+use rustfs_kernel as k;
+use serde_json::Value;
+use time::OffsetDateTime;
+
+use super::action::Action;
+use super::resource::Resource;
+use super::statement::BPStatement;
+use super::{Args, BucketPolicyArgs, Effect, ResourceSet, Statement};
+
+pub(crate) fn ip(a: std::net::IpAddr) -> k::condfuncs::IpAddr {
+    match a {
+        std::net::IpAddr::V4(v) => k::condfuncs::IpAddr::V4(u32::from(v)),
+        std::net::IpAddr::V6(v) => k::condfuncs::IpAddr::V6(u128::from(v)),
+    }
+}
+
+fn b(s: &str) -> Vec<u8> {
+    s.as_bytes().to_vec()
+}
+
+pub(crate) fn action(a: &Action) -> k::acts::Action {
+    let family = match a {
+        Action::S3Action(_) => k::acts::Family::S3,
+        Action::AdminAction(_) => k::acts::Family::Admin,
+        Action::StsAction(_) => k::acts::Family::Sts,
+        Action::KmsAction(_) => k::acts::Family::Kms,
+        Action::None => k::acts::Family::None,
+    };
+    k::acts::Action {
+        family,
+        name: b(<&str>::from(a)),
+    }
+}
+
+fn actions(set: &[Action]) -> Vec<k::acts::Action> {
+    set.iter().map(action).collect()
+}
+
+fn resources(set: &ResourceSet) -> Vec<k::rsrc::Resource> {
+    set.iter()
+        .map(|r| match r {
+            Resource::S3(p) => k::rsrc::Resource::S3(b(p)),
+            Resource::Kms(p) => k::rsrc::Resource::Kms(b(p)),
+        })
+        .collect()
+}
+
+fn effect(e: &Effect) -> k::stmts::Effect {
+    match e {
+        Effect::Allow => k::stmts::Effect::Allow,
+        Effect::Deny => k::stmts::Effect::Deny,
+    }
+}
+
+/// `None` when a condition has no kernel form.
+pub(crate) fn statement(s: &Statement) -> Option<k::stmts::Statement> {
+    Some(k::stmts::Statement {
+        effect: effect(&s.effect),
+        actions: actions(&s.actions),
+        not_actions: actions(&s.not_actions),
+        resources: resources(&s.resources),
+        not_resources: resources(&s.not_resources),
+        conditions: s.conditions.to_kernel()?,
+    })
+}
+
+pub(crate) fn bp_statement(s: &BPStatement) -> Option<k::stmts::BPStatement> {
+    Some(k::stmts::BPStatement {
+        effect: effect(&s.effect),
+        principal: s.principal.to_kernel(),
+        actions: actions(&s.actions),
+        not_actions: actions(&s.not_actions),
+        resources: resources(&s.resources),
+        not_resources: resources(&s.not_resources),
+        conditions: s.conditions.to_kernel()?,
+    })
+}
+
+fn conditions(m: &HashMap<String, Vec<String>>) -> k::condfuncs::CondValues {
+    m.iter().map(|(k, v)| (b(k), v.iter().map(|x| b(x)).collect())).collect()
+}
+
+/// `VariableResolver::get_claim_as_strings`.
+fn claim_strings(v: Option<&Value>) -> Option<Vec<Vec<u8>>> {
+    let scalar = |v: &Value| match v {
+        Value::String(s) => Some(b(s)),
+        Value::Number(n) => Some(b(&n.to_string())),
+        Value::Bool(x) => Some(b(&x.to_string())),
+        _ => None,
+    };
+    match v? {
+        Value::Array(arr) => Some(arr.iter().filter_map(scalar).collect()),
+        other => scalar(other).map(|s| vec![s]),
+    }
+}
+
+pub(crate) fn args(a: &Args<'_>) -> k::stmts::Args {
+    k::stmts::Args {
+        account: b(a.account),
+        action: action(&a.action),
+        bucket: b(a.bucket),
+        conditions: conditions(a.conditions),
+        is_owner: a.is_owner,
+        object: b(a.object),
+        claims: k::awsvars::ClaimStrings {
+            sub: claim_strings(a.claims.get("sub")),
+            parent: claim_strings(a.claims.get("parent")),
+            parent_str: a.claims.get("parent").and_then(|v| v.as_str()).map(b),
+            has_parent: a.claims.contains_key("parent"),
+            has_role_arn: a.claims.contains_key("roleArn"),
+            has_sa_policy: a.claims.contains_key("sa-policy"),
+        },
+        deny_only: a.deny_only,
+    }
+}
+
+pub(crate) fn bp_args(a: &BucketPolicyArgs<'_>) -> k::stmts::BucketPolicyArgs {
+    k::stmts::BucketPolicyArgs {
+        account: b(a.account),
+        action: action(&a.action),
+        bucket: b(a.bucket),
+        conditions: conditions(a.conditions),
+        is_owner: a.is_owner,
+        object: b(a.object),
+    }
+}
+
+/// Every request value parsed as an address (std's parser), and the clock.
+pub(crate) fn env(m: &HashMap<String, Vec<String>>) -> k::condfuncs::Env {
+    let now = OffsetDateTime::now_utc();
+    k::condfuncs::Env {
+        ips: m
+            .values()
+            .flatten()
+            .map(|s| (b(s), s.parse::<std::net::IpAddr>().ok().map(ip)))
+            .collect(),
+        now_rfc3339: b(&now.format(&time::format_description::well_known::Rfc3339).unwrap_or_default()),
+        now_epoch: b(&now.unix_timestamp().to_string()),
+    }
+}
+
+/// `Policy::is_allowed` as an h5i-app kernel: the snapshot is the policy's
+/// statements, the command one request. Nothing is written.
+pub(crate) struct IdentityPolicy;
+
+impl Kernel for IdentityPolicy {
+    type Principal = ();
+    type Snapshot = Vec<k::stmts::Statement>;
+    type Command = (k::stmts::Args, k::condfuncs::Env);
+    type WriteSet = ();
+    type Reply = bool;
+    type Error = Infallible;
+
+    fn tenant(_: &()) -> TenantId {
+        TenantId(0)
+    }
+
+    fn transition(_: &(), snap: &Self::Snapshot, cmd: &Self::Command) -> Result<((), bool), Infallible> {
+        Ok(((), k::policies::policy_is_allowed(snap, &cmd.0, &cmd.1)))
+    }
+
+    fn apply(snap: &Self::Snapshot, _: &()) -> Self::Snapshot {
+        snap.clone()
+    }
+}
+
+/// `BucketPolicy::is_allowed` as an h5i-app kernel.
+pub(crate) struct BucketPolicyKernel;
+
+impl Kernel for BucketPolicyKernel {
+    type Principal = ();
+    type Snapshot = Vec<k::stmts::BPStatement>;
+    type Command = (k::stmts::BucketPolicyArgs, k::condfuncs::Env);
+    type WriteSet = ();
+    type Reply = bool;
+    type Error = Infallible;
+
+    fn tenant(_: &()) -> TenantId {
+        TenantId(0)
+    }
+
+    fn transition(_: &(), snap: &Self::Snapshot, cmd: &Self::Command) -> Result<((), bool), Infallible> {
+        Ok(((), k::policies::bucket_policy_is_allowed(snap, &cmd.0, &cmd.1)))
+    }
+
+    fn apply(snap: &Self::Snapshot, _: &()) -> Self::Snapshot {
+        snap.clone()
+    }
+}
+
+pub(crate) fn decide<K: Kernel<Principal = (), Reply = bool, Error = Infallible>>(snap: &K::Snapshot, cmd: &K::Command) -> bool {
+    match K::transition(&(), snap, cmd) {
+        Ok((_, allowed)) => allowed,
+        Err(never) => match never {},
+    }
+}
