+/// The response for a kernel refusal.
+fn kernel_response(r: h5i::k::middleware::Response, unavailable: Option<String>) -> Response {
+    use h5i::k::middleware::{Deny, Response as R};
+    match r {
+        R::NotFound => not_found_response(),
+        R::Unauthorized { challenge_basic } => challenge_unauthorized_response(challenge_basic),
+        R::ServiceUnavailable => service_unavailable_response(),
+        R::PermissionServiceUnavailable => Response::builder()
+            .status(StatusCode::SERVICE_UNAVAILABLE)
+            .body(axum::body::Body::from("permission service temporarily unavailable"))
+            .unwrap(),
+        R::AuthServiceUnavailable => (
+            StatusCode::SERVICE_UNAVAILABLE,
+            [(axum::http::header::RETRY_AFTER, "1")],
+            unavailable.unwrap_or_default(),
+        )
+            .into_response(),
+        R::ForbiddenRepo => forbidden_repo_response(),
+        R::ForbiddenPermission => forbidden_permission_response(),
+        R::CsrfForbidden => csrf_forbidden_response(),
+        R::MustChangePassword => must_change_password_response(),
+        R::AdminRequired => (StatusCode::FORBIDDEN, "Admin access required").into_response(),
+        R::Plain401(d) => {
+            let msg = match d {
+                Deny::InvalidOrExpiredToken => "Invalid or expired token",
+                Deny::InvalidOrExpiredApiToken => "Invalid or expired API token",
+                Deny::InvalidBasic => "Invalid Basic auth credentials",
+                Deny::InvalidCredentials => "Invalid credentials",
+                Deny::MissingHeader => "Missing authorization header",
+                Deny::InvalidHeaderFormat => "Invalid authorization header format",
+                Deny::InvalidTicket => "Invalid or expired download ticket",
             };
+            (StatusCode::UNAUTHORIZED, msg).into_response()
+        }
+        R::GuestUnauthorized { .. } | R::OciUnauthorized => {
+            // Built by `guest_access_guard`, which has the OCI base URL.
+            unauthorized_response()
+        }
+    }
+}
 
