diff --git a/backend/src/h5i.rs b/backend/src/h5i.rs
new file mode 100644
index 0000000..78ff272
--- /dev/null
+++ b/backend/src/h5i.rs
@@ -0,0 +1,210 @@
+//! The shell around artifact-keeper's verified kernel
+//! (`artifactkeeper-kernel`, proven in Lean in h5i-app-bench). Requests,
+//! headers and principals are converted to the kernel's types; repository and
+//! user ids become `u64`s for one decision. JWT verification, API-token and
+//! password lookups, base64 and IP parsing are the kernel's oracle inputs and
+//! stay here.
+
+use std::collections::HashMap;
+
+use axum::http::{HeaderMap, Method};
+use uuid::Uuid;
+
+pub(crate) use artifactkeeper_kernel as k;
+
+use crate::api::middleware::auth::AuthExtension;
+use crate::models::access_scope::AccessScope;
+use crate::models::repository::RepositoryVisibility;
+
+/// Uuids as the kernel's `u64` ids, for one decision. 0 is never issued.
+#[derive(Default)]
+pub(crate) struct Ids {
+    to: HashMap<Uuid, u64>,
+    from: Vec<Uuid>,
+}
+
+impl Ids {
+    pub(crate) fn id(&mut self, u: Uuid) -> u64 {
+        if let Some(&i) = self.to.get(&u) {
+            return i;
+        }
+        self.from.push(u);
+        let i = self.from.len() as u64;
+        self.to.insert(u, i);
+        i
+    }
+
+    pub(crate) fn uuid(&self, i: u64) -> Uuid {
+        self.from[(i - 1) as usize]
+    }
+}
+
+pub(crate) fn method(m: &Method) -> k::Method {
+    match *m {
+        Method::GET => k::Method::Get,
+        Method::HEAD => k::Method::Head,
+        Method::POST => k::Method::Post,
+        Method::PUT => k::Method::Put,
+        Method::DELETE => k::Method::Delete,
+        Method::PATCH => k::Method::Patch,
+        Method::OPTIONS => k::Method::Options,
+        _ => k::Method::Other,
+    }
+}
+
+/// `(lowercase name, raw value)` pairs, in the map's order.
+pub(crate) fn headers(h: &HeaderMap) -> Vec<(Vec<u8>, Vec<u8>)> {
+    h.iter()
+        .map(|(n, v)| (n.as_str().as_bytes().to_vec(), v.as_bytes().to_vec()))
+        .collect()
+}
+
+pub(crate) fn request(method_: &Method, path: &str, query: Option<&str>, h: &HeaderMap) -> k::http::Request {
+    k::http::Request {
+        method: method(method_),
+        path: path.as_bytes().to_vec(),
+        query: query.map(|q| q.as_bytes().to_vec()),
+        headers: headers(h),
+    }
+}
+
+pub(crate) fn visibility(v: RepositoryVisibility) -> k::Visibility {
+    match v {
+        RepositoryVisibility::Public => k::Visibility::Public,
+        RepositoryVisibility::Internal => k::Visibility::Internal,
+        RepositoryVisibility::Private => k::Visibility::Private,
+    }
+}
+
+/// Kernel output that is a copy of text from a `&str` input is UTF-8.
+pub(crate) fn string(b: Vec<u8>) -> String {
+    String::from_utf8(b).unwrap_or_else(|e| String::from_utf8_lossy(e.as_bytes()).into_owned())
+}
+
+pub(crate) fn strings(v: &[String]) -> Vec<Vec<u8>> {
+    v.iter().map(|s| s.as_bytes().to_vec()).collect()
+}
+
+/// The part of `hay` the kernel returned: its first occurrence, which has
+/// the same text.
+pub(crate) fn within<'a>(hay: &'a str, part: &[u8]) -> &'a str {
+    let n = part.len();
+    if n == 0 {
+        return &hay[hay.len()..];
+    }
+    let bytes = hay.as_bytes();
+    let mut i = 0;
+    while i + n <= bytes.len() {
+        if &bytes[i..i + n] == part && hay.is_char_boundary(i) && hay.is_char_boundary(i + n) {
+            return &hay[i..i + n];
+        }
+        i += 1;
+    }
+    // Unreachable for the kernel functions that return a slice of their input.
+    &hay[hay.len()..]
+}
+
+pub(crate) fn access_scope(a: &AccessScope, ids: &mut Ids) -> k::AccessScope {
+    match a {
+        AccessScope::Admin => k::AccessScope::Admin,
+        AccessScope::Restricted(v) => k::AccessScope::Restricted(v.iter().map(|u| ids.id(*u)).collect()),
+    }
+}
+
+pub(crate) fn from_access_scope(a: k::AccessScope, ids: &Ids) -> AccessScope {
+    match a {
+        k::AccessScope::Admin => AccessScope::Admin,
+        k::AccessScope::Restricted(v) => AccessScope::Restricted(v.into_iter().map(|i| ids.uuid(i)).collect()),
+    }
+}
+
+pub(crate) fn auth_ext(e: &AuthExtension, ids: &mut Ids) -> k::AuthExtension {
+    k::AuthExtension {
+        user_id: ids.id(e.user_id),
+        username: e.username.as_bytes().to_vec(),
+        email: e.email.as_bytes().to_vec(),
+        is_admin: e.is_admin,
+        is_api_token: e.is_api_token,
+        is_service_account: e.is_service_account,
+        scopes: e.scopes.as_deref().map(strings),
+        allowed_repo_ids: access_scope(&e.allowed_repo_ids, ids),
+        iat_ms: e.iat_ms,
+    }
+}
+
+pub(crate) fn from_auth_ext(e: k::AuthExtension, ids: &Ids) -> AuthExtension {
+    AuthExtension {
+        user_id: ids.uuid(e.user_id),
+        username: string(e.username),
+        email: string(e.email),
+        is_admin: e.is_admin,
+        is_api_token: e.is_api_token,
+        is_service_account: e.is_service_account,
+        scopes: e.scopes.map(|v| v.into_iter().map(string).collect()),
+        allowed_repo_ids: from_access_scope(e.allowed_repo_ids, ids),
+        iat_ms: e.iat_ms,
+    }
+}
+
+pub(crate) fn empty_oracle() -> k::trusted::Oracle {
+    k::trusted::Oracle {
+        jwt: Vec::new(),
+        api_tokens: Vec::new(),
+        passwords: Vec::new(),
+        base64: Vec::new(),
+        ip: Vec::new(),
+    }
+}
+
+/// `STANDARD.decode(input)`, as the kernel's base64 table.
+pub(crate) fn add_base64(o: &mut k::trusted::Oracle, input: &str) {
+    use base64::Engine;
+    let decoded = base64::engine::general_purpose::STANDARD.decode(input).ok();
+    o.base64.push((input.as_bytes().to_vec(), decoded));
+}
+
+pub(crate) fn ip(a: std::net::IpAddr) -> k::net::IpAddr {
+    match a {
+        std::net::IpAddr::V4(v) => k::net::IpAddr::V4(u32::from(v)),
+        std::net::IpAddr::V6(v) => k::net::IpAddr::V6(u128::from(v)),
+    }
+}
+
+pub(crate) fn std_ip(a: k::net::IpAddr) -> std::net::IpAddr {
+    match a {
+        k::net::IpAddr::V4(v) => std::net::IpAddr::V4(v.into()),
+        k::net::IpAddr::V6(v) => std::net::IpAddr::V6(v.into()),
+    }
+}
+
+/// `str::parse::<IpAddr>` for `s`, as the kernel's table.
+pub(crate) fn add_ip(o: &mut k::trusted::Oracle, s: &[u8]) {
+    if let Some(a) = std::str::from_utf8(s).ok().and_then(|t| t.parse::<std::net::IpAddr>().ok()) {
+        o.ip.push((s.to_vec(), ip(a)));
+    }
+}
+
+pub(crate) fn claims(c: &crate::services::auth_service::Claims, ids: &mut Ids) -> k::Claims {
+    k::Claims {
+        sub: ids.id(c.sub),
+        username: c.username.as_bytes().to_vec(),
+        email: c.email.as_bytes().to_vec(),
+        is_admin: c.is_admin,
+        allowed_repo_ids: c.allowed_repo_ids.as_ref().map(|v| v.iter().map(|u| ids.id(*u)).collect()),
+        iat: c.iat,
+        iat_ms: c.iat_ms,
+        scopes: c.scopes.as_deref().map(strings),
+    }
+}
+
+pub(crate) fn user(u: &crate::models::user::User, ids: &mut Ids) -> k::User {
+    k::User {
+        id: ids.id(u.id),
+        username: u.username.as_bytes().to_vec(),
+        email: u.email.as_bytes().to_vec(),
+        is_active: u.is_active,
+        is_admin: u.is_admin,
+        is_service_account: u.is_service_account,
+        must_change_password: u.must_change_password,
+    }
+}
