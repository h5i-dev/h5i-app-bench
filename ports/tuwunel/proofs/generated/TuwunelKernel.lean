    | Membership.Invite => ok true
    | Membership.Leave => ok false
    | Membership.Ban => ok false
    | Membership.Knock => ok false
    | Membership.Custom _ => ok false
  | Membership.Leave =>
    match b with
    | Membership.Join => ok false
    | Membership.Invite => ok false
    | Membership.Leave => ok true
    | Membership.Ban => ok false
    | Membership.Knock => ok false
    | Membership.Custom _ => ok false
  | Membership.Ban =>
    match b with
    | Membership.Join => ok false
    | Membership.Invite => ok false
    | Membership.Leave => ok false
    | Membership.Ban => ok true
    | Membership.Knock => ok false
    | Membership.Custom _ => ok false
  | Membership.Knock =>
    match b with
    | Membership.Join => ok false
    | Membership.Invite => ok false
    | Membership.Leave => ok false
    | Membership.Ban => ok false
