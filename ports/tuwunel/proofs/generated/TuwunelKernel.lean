def api_threads.get_threads_route
  (s : Snapshot) (user : Std.U64) (room : Std.U64) («from» : Token)
  (limit : Option Std.U64) (participated : Bool) :
  Result (core.result.Result Reply Error)
  := do
  let b ← svc_timeline.exists s room
  if b
  then
    let b1 ← svc_accessor.user_can_see_room s user room
    if b1
    then
      let limit1 ←
        match limit with
        | none => ok 10#u64
        | some l => if l < 100#u64
                    then ok l
                    else ok 100#u64
      match «from» with
      | Token.Absent =>
        let r ← svc_threads.threads_until s user room COUNT_MAX participated
        match r with
        | core.result.Result.Ok v =>
          let (s1, threads) ←
            api_threads.get_threads_route_loop0 s user room limit1 v
              (alloc.vec.Vec.new (Std.I64 × Std.Usize)) 0#usize
          let i := alloc.vec.Vec.len threads
          let i1 ← lift (UScalar.cast .U64 i)
          let s2 := alloc.vec.Vec.deref threads
          let threads1 ← api_threads.truncate s2 limit1
          let next_batch ←
            if i1 > limit1
            then
              let s3 := alloc.vec.Vec.deref threads1
              api_message.last_count s3
            else ok none
          let s3 := alloc.vec.Vec.deref threads1
          let v1 ← api_message.event_ids s1 s3
          ok (core.result.Result.Ok (Reply.Threads v1 next_batch))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
      | Token.At c =>
        let r ← svc_threads.threads_until s user room c participated
        match r with
        | core.result.Result.Ok v =>
          let (s1, threads) ←
            api_threads.get_threads_route_loop1 s user room limit1 v
              (alloc.vec.Vec.new (Std.I64 × Std.Usize)) 0#usize
          let i := alloc.vec.Vec.len threads
          let i1 ← lift (UScalar.cast .U64 i)
          let s2 := alloc.vec.Vec.deref threads
          let threads1 ← api_threads.truncate s2 limit1
          let next_batch ←
            if i1 > limit1
            then
              let s3 := alloc.vec.Vec.deref threads1
              api_message.last_count s3
            else ok none
          let s3 := alloc.vec.Vec.deref threads1
          let v1 ← api_message.event_ids s1 s3
          ok (core.result.Result.Ok (Reply.Threads v1 next_batch))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
      | Token.Invalid => ok (core.result.Result.Err Error.Parse)
    else ok (core.result.Result.Err Error.Forbidden)
  else ok (core.result.Result.Err Error.Forbidden)

