          let s4 := alloc.vec.Vec.deref token
          let (ws, r) ← tokens.verify_token store crypto s4 req.now req.mono
          match r with
          | core.result.Result.Ok p =>
            let (user, role) := p
            let v ← middleware.token_writes ws
            ok (v, middleware.Outcome.Next NamespaceAuthority.Unrestricted user
              (some role))
          | core.result.Result.Err _ =>
            let v ← middleware.anonymous
            ok (alloc.vec.Vec.new middleware.Write, middleware.Outcome.Next
              NamespaceAuthority.Unrestricted v none)
