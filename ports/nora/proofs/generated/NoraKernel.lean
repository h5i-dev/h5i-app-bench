    | none =>
      let s2 := alloc.vec.Vec.deref auth_val
      let s3 ←
        lift (Array.to_slice
          (Array.make 7#usize [
            66#u8, 101#u8, 97#u8, 114#u8, 101#u8, 114#u8, 32#u8
            ]))
      let o1 ← middleware.strip_prefix s2 s3
      match o1 with
      | none =>
        let v ← middleware.anonymous
        ok (alloc.vec.Vec.new middleware.Write, middleware.Outcome.Next
          NamespaceAuthority.Unrestricted v none)
      | some token =>
        match cfg.tokens with
        | none =>
          let v ← middleware.anonymous
          ok (alloc.vec.Vec.new middleware.Write, middleware.Outcome.Next
            NamespaceAuthority.Unrestricted v none)
