def middleware.open_path
  (cfg : middleware.Config) (crypto : oracle.Crypto) (req : middleware.Request)
  :
  Result ((alloc.vec.Vec middleware.Write) × middleware.Outcome)
  := do
  match req.auth_header with
  | none =>
    let v ← middleware.anonymous
    ok (alloc.vec.Vec.new middleware.Write, middleware.Outcome.Next
      NamespaceAuthority.Unrestricted v none)
  | some auth_val =>
    let s := alloc.vec.Vec.deref auth_val
    let s1 ←
      lift (Array.to_slice
        (Array.make 6#usize [ 66#u8, 97#u8, 115#u8, 105#u8, 99#u8, 32#u8 ]))
    let o ← middleware.strip_prefix s s1
