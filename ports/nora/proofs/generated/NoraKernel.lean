def middleware.token_identity
  (writes : alloc.vec.Vec middleware.Write) (client_ip : Option net.IpAddr)
  (method : middleware.HttpMethod) (is_admin : Bool)
  (user : alloc.vec.Vec Std.U8) (role : Role) :
  Result ((alloc.vec.Vec middleware.Write) × middleware.Outcome)
  := do
  let writes1 ← middleware.record_success writes client_ip
  let b ← middleware.is_write_method method
  if b
  then
    let b1 ← Role.can_write role
    if b1
    then
      if is_admin
      then
        let b2 ← Role.can_admin role
        if b2
        then
          ok (writes1, middleware.Outcome.Next NamespaceAuthority.Unrestricted
            user (some role))
        else
          ok (writes1, middleware.Outcome.Deny middleware.Deny.AdminRequired)
      else
        ok (writes1, middleware.Outcome.Next NamespaceAuthority.Unrestricted
          user (some role))
    else ok (writes1, middleware.Outcome.Deny middleware.Deny.ReadOnlyToken)
  else
    if is_admin
    then
      let b1 ← Role.can_admin role
      if b1
      then
        ok (writes1, middleware.Outcome.Next NamespaceAuthority.Unrestricted
          user (some role))
      else ok (writes1, middleware.Outcome.Deny middleware.Deny.AdminRequired)
    else
      ok (writes1, middleware.Outcome.Next NamespaceAuthority.Unrestricted user
        (some role))

