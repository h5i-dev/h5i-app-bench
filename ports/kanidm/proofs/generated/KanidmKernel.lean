def delete_acc.delete_filter_entry
  (ident : Identity) (related_acp : Slice profiles.AccessControlDeleteResolved)
  (entry : Entry) :
  Result delete_acc.IResult
  := do
  match ident.origin with
  | IdentType.User _ =>
    let «as» ← identity_impl.access_scope ident
    match «as» with
    | AccessScope.ReadOnly => ok delete_acc.IResult.Deny
    | AccessScope.ReadWrite =>
      let ident_memberof ← identity_impl.get_memberof ident
      let ident_uuid ← identity_impl.get_uuid ident
      let allow ←
        delete_acc.delete_any_acp related_acp ident_memberof ident_uuid entry
      if allow
      then ok delete_acc.IResult.Grant
      else ok delete_acc.IResult.Ignore
    | AccessScope.Synchronise => ok delete_acc.IResult.Deny
  | IdentType.Synch _ => ok delete_acc.IResult.Deny
  | IdentType.Internal ir =>
    match ir with
    | InternalRole.System => ok delete_acc.IResult.Grant
    | InternalRole.Migration =>
      let valid_migration_class ← search_acc.valid_migration_class entry
      if valid_migration_class
      then ok delete_acc.IResult.Grant
      else ok delete_acc.IResult.Deny
    | InternalRole.AccountRequest => ok delete_acc.IResult.Deny
    | InternalRole.MessageQueue => ok delete_acc.IResult.Deny

