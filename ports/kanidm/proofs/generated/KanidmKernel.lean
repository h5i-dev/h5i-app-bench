        if b
        then ok delete_acc.IResult.Ignore
        else ok delete_acc.IResult.Deny
  | IdentType.Synch _ => ok delete_acc.IResult.Deny
  | IdentType.Internal ir =>
    match ir with
    | InternalRole.System => ok delete_acc.IResult.Ignore
    | InternalRole.Migration =>
      if entry.uuid <= UUID_ANONYMOUS
      then ok delete_acc.IResult.Deny
      else
        let s ←
