  (modlist : Slice Modify) :
  Result Bool
  := do
  let disallow ← access.modlist_purges_class modlist
  if disallow
  then ok false
  else
    let requested_pres ← access.requested_pres modlist
    let requested_rem ← access.requested_rem modlist
    let o ← access.requested_classes entry modlist
    match o with
    | none => ok false
    | some c =>
      let (requested_pres_classes, requested_rem_classes) := c
      let i := alloc.vec.Vec.len requested_pres
      if i = 0#usize
      then
        let i1 := alloc.vec.Vec.len requested_rem
        if i1 = 0#usize
        then ok false
        else
          let s := alloc.vec.Vec.deref ctl.sync_agreements
          let mr ← modify_acc.apply_modify_access ident related_acp s entry
          match mr with
          | modify_acc.ModifyResult.Deny => ok false
          | modify_acc.ModifyResult.Grant => ok true
          | modify_acc.ModifyResult.Allow pres rem pres_cls rem_cls =>
            let s1 := alloc.vec.Vec.deref requested_pres
            let s2 := alloc.vec.Vec.deref pres
            let b ← bset.is_subset s1 s2
            let decision ← if b
                             then ok true
                             else ok false
            let s3 := alloc.vec.Vec.deref requested_rem
            let s4 := alloc.vec.Vec.deref rem
            let b1 ← bset.is_subset s3 s4
            let decision1 ← if b1
                              then ok decision
                              else ok false
            let s5 := alloc.vec.Vec.deref requested_pres_classes
            let s6 := alloc.vec.Vec.deref pres_cls
            let b2 ← bset.is_subset s5 s6
            let decision2 ← if b2
                              then ok decision1
                              else ok false
            let s7 := alloc.vec.Vec.deref requested_rem_classes
            let s8 := alloc.vec.Vec.deref rem_cls
            let b3 ← bset.is_subset s7 s8
            if b3
            then ok decision2
            else ok false
      else
        let s := alloc.vec.Vec.deref ctl.sync_agreements
        let mr ← modify_acc.apply_modify_access ident related_acp s entry
