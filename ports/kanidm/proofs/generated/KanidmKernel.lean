def access.create_allow_entry
  (ident : Identity) (related_acp : Slice profiles.AccessControlCreateResolved)
  (e : Entry) :
  Result Bool
  := do
  let requested_pres ← entry_impl.get_ava_names e
  let s ←
    lift (Array.to_slice
      (Array.make 5#usize [ 99#u8, 108#u8, 97#u8, 115#u8, 115#u8 ]))
  let o ← entry_impl.get_ava_as_iutf8 e s
  match o with
  | none => ok false
  | some set =>
    let cr ← create_acc.apply_create_access ident related_acp e
    match cr with
    | create_acc.CreateResult.Deny => ok false
    | create_acc.CreateResult.Grant => ok true
    | create_acc.CreateResult.Allow pres pres_cls =>
      let s1 := alloc.vec.Vec.deref requested_pres
      let s2 := alloc.vec.Vec.deref pres
      let b ← bset.is_subset s1 s2
      let decision ← if b
                       then ok true
                       else ok false
      let s3 := alloc.vec.Vec.deref set
      let s4 := alloc.vec.Vec.deref pres_cls
      let b1 ← bset.is_subset s3 s4
      if b1
      then ok decision
      else ok false

