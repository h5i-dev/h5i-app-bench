def grantapi.set_member_role
  (db : model.Db) (env : grantapi.Env) (caller : Std.U64) (drive_id : Std.U64)
  (s : model.Subject) (role : model.Role) (expires_at : Option Std.I64) :
  Result (model.Db × (core.result.Result grantapi.Reply model.ErrorKind))
  := do
  let r ←
    grantapi.require db env (model.Subject.User caller) model.Permission.Manage
      (model.Resource.Drive drive_id)
  let gates ←
    match r with
    | core.result.Result.Ok _ =>
      do
      let r1 ← grantapi.refuse_if_personal db drive_id
      match r1 with
      | core.result.Result.Ok _ =>
        let r2 ← grantapi.refuse_if_forbid_external_sharing db drive_id s
        match r2 with
        | core.result.Result.Ok _ =>
          let r3 ←
            grantapi.refuse_if_forbid_owner_role_change db drive_id s (some
              role)
          match r3 with
          | core.result.Result.Ok _ =>
            let b ←
              core.cmp.PartialEq.ne.trait_default
                model.Role.Insts.CoreCmpPartialEqRole role model.Role.Owner
            if b
            then grantapi.refuse_if_last_owner_change db drive_id s
            else ok (core.result.Result.Ok ())
          | core.result.Result.Err _ => ok r3
        | core.result.Result.Err _ => ok r2
      | core.result.Result.Err _ => ok r1
    | core.result.Result.Err _ => ok r
  match gates with
  | core.result.Result.Ok _ =>
    let s1 := alloc.vec.Vec.deref db.grants
    let (grants, g) ←
      acl.set_role s1 caller s role (model.Resource.Drive drive_id) expires_at
        env.fresh
    let d ← grantapi.with_grants db grants
    ok (d, core.result.Result.Ok (grantapi.Reply.Granted g))
