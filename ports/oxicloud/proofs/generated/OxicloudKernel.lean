        | core.result.Result.Ok _ =>
          let s := alloc.vec.Vec.deref db.grants
          let after ← grantapi.revoke s grant_id
          let s1 := alloc.vec.Vec.deref after
          let after1 ← acl.clear_role s1 g.subject g.resource
          let d ← grantapi.with_grants db after1
          ok (d, core.result.Result.Ok grantapi.Reply.NoContent)
