  match s.status with
  | magiclink.MagicLinkStatus.Pending =>
    let b ← magiclink.is_expired s now
    ok (¬ b)
  | magiclink.MagicLinkStatus.Used => ok false
  | magiclink.MagicLinkStatus.Expired => ok false

