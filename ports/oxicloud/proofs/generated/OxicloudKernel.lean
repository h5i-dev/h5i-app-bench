            let dp ← acl.drive_policies db d
            if dp.read_only
            then ok false
            else
              let o1 ← acl.caller_role_on_drive db s d now
              let b1 ← acl.role_has o1 p
              if b1
              then ok true
              else
                match r with
                | model.Resource.Folder _ => acl.cascade_grant db s r p now
                | model.Resource.File _ => acl.cascade_grant db s r p now
                | model.Resource.Drive id =>
                  if b
                  then
                    let dp1 ← acl.drive_policies db id
                    if dp1.read_only
                    then ok false
                    else
                      let o2 ← acl.caller_role_on_drive db s id now
                      acl.role_has o2 p
                  else
                    let o2 ← acl.caller_role_on_drive db s id now
