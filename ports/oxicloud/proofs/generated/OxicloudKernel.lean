                | model.Subject.Token _ => ok (core.result.Result.Ok ())
            else ok (core.result.Result.Ok ())
      else
        if val.forbid_external_sharing
        then
          if b
          then ok (core.result.Result.Ok ())
          else
            match s with
            | model.Subject.User uid =>
              let r2 ← grantapi.user_is_external db uid
              let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r2
              match cf1 with
              | core.ops.control_flow.ControlFlow.Continue val1 =>
                grantapi.refuse_external_sharing val s val1
              | core.ops.control_flow.ControlFlow.Break residual =>
                core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                  Unit (core.convert.FromSame model.ErrorKind) residual
            | model.Subject.Group _ => ok (core.result.Result.Ok ())
            | model.Subject.Token _ => ok (core.result.Result.Ok ())
        else ok (core.result.Result.Ok ())
    else
      if val.forbid_sharing
      then ok (core.result.Result.Err model.ErrorKind.OperationNotSupported)
      else
        let token ←
          match s with
          | model.Subject.User _ => ok false
          | model.Subject.Group _ => ok false
          | model.Subject.Token _ => ok true
        if token
        then
          if val.forbid_public_links
          then
            ok (core.result.Result.Err model.ErrorKind.OperationNotSupported)
          else
            if val.forbid_external_sharing
            then
              if b
              then ok (core.result.Result.Ok ())
              else
                match s with
                | model.Subject.User uid =>
                  let r2 ← grantapi.user_is_external db uid
                  let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r2
                  match cf1 with
                  | core.ops.control_flow.ControlFlow.Continue val1 =>
                    grantapi.refuse_external_sharing val s val1
                  | core.ops.control_flow.ControlFlow.Break residual =>
                    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                      Unit (core.convert.FromSame model.ErrorKind) residual
                | model.Subject.Group _ => ok (core.result.Result.Ok ())
                | model.Subject.Token _ => ok (core.result.Result.Ok ())
            else ok (core.result.Result.Ok ())
        else
          if val.forbid_external_sharing
          then
            if b
            then ok (core.result.Result.Ok ())
            else
              match s with
              | model.Subject.User uid =>
                let r2 ← grantapi.user_is_external db uid
                let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r2
                match cf1 with
                | core.ops.control_flow.ControlFlow.Continue val1 =>
                  grantapi.refuse_external_sharing val s val1
                | core.ops.control_flow.ControlFlow.Break residual =>
                  core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                    Unit (core.convert.FromSame model.ErrorKind) residual
              | model.Subject.Group _ => ok (core.result.Result.Ok ())
              | model.Subject.Token _ => ok (core.result.Result.Ok ())
          else ok (core.result.Result.Ok ())
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
      Unit (core.convert.FromSame model.ErrorKind) residual

