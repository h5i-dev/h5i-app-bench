  (s : magiclink.MagicLinkToken) (now : session.Timestamp) : Result Bool := do
  if now.seconds > s.expires_at.seconds
  then ok true
  else
    if now.seconds = s.expires_at.seconds
    then ok (now.nanoseconds > s.expires_at.nanoseconds)
    else ok false

