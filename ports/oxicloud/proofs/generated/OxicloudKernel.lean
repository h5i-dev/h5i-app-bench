def subjectgroup.name_byte (b : Std.U8) : Result Bool := do
  let b1 ← subjectgroup.alphanumeric b
  if b1
  then ok true
  else
    if b = 46#u8
    then ok true
    else if b = 45#u8
         then ok true
         else ok (b = 95#u8)

