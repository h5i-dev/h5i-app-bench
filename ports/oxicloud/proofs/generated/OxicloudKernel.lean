        match r with
        | model.Resource.Folder _ => ok true
        | model.Resource.File _ => ok true
        | model.Resource.Drive _ => ok false
        | model.Resource.Calendar _ => ok false
        | model.Resource.AddressBook _ => ok false
        | model.Resource.Playlist _ => ok false
