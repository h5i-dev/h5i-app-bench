import Lake
open Lake DSL

-- Pinned to the Aeneas commit that generated DocsKernel.lean.
require aeneas from git
  "https://github.com/AeneasVerif/aeneas" @ "b86120db3183b0107eb5f2637b11c424cd06ef1c" / "backends/lean"

package docs_proofs

-- DocsKernel.lean is generated by scripts/extract.sh. Do not edit it.
@[default_target] lean_lib Proofs where
  roots := #[`DocsKernel, `Spec, `Lemmas, `Apply, `Transition, `Theorems, `Invariants, `Noninterference]

-- Runs the extracted kernel for differential tests (scripts/difftest.sh).
lean_exe difftest where
  root := `DiffTest
