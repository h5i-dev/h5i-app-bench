/-- [docs_kernel::apply_write]:
    Source: 'examples/docs/kernel/src/lib.rs', lines 669:0-681:1
    Visibility: public -/
def apply_write (s : Snapshot) (w : Write) : Result Snapshot := do
  match w with
  | Write.PutProject p =>
    let v ← put_project s.projects p
    ok { s with projects := v }
  | Write.PutMember m =>
    let v ← put_member s.members m
    ok { s with members := v }
  | Write.DelMember p u =>
    let v ← del_member s.members p u
    ok { s with members := v }
  | Write.PutDocument d =>
    let v ← put_document s.documents d
    ok { s with documents := v }
  | Write.DelDocument id =>
    let v ← del_document s.documents id
    ok { s with documents := v }
  | Write.SetCounter c => ok { s with counter := c }
  | Write.PutWebhook w1 =>
    let v ← put_webhook s.webhooks w1
    ok { s with webhooks := v }
  | Write.DelWebhook p =>
    let v ← del_webhook s.webhooks p
    ok { s with webhooks := v }
  | Write.Emit _ => ok s

