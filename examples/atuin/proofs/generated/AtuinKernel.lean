/-- [atuin_kernel::step]:
    Source: 'examples/atuin/kernel/src/lib.rs', lines 285:0-406:1 -/
def step
  (actor : Principal) (snap : Snapshot) (cmd : Command) (require_reauth : Bool)
  :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.Register username password token =>
    if snap.settings.open_registration
    then
      let b ← username_ok username
      if b
      then
        let b1 ← username_taken snap.users username
        if b1
        then ok (core.result.Result.Err Error.UsernameTaken)
        else
          if snap.counter.next_id = core.num.U64.MAX
          then ok (core.result.Result.Err Error.Overflow)
          else
            let i ← snap.counter.next_id + 1#u64
            let ws ←
              alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.SetCounter
                { next_id := i })
            let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 username
            let v1 ← alloc.vec.CloneVec.clone core.clone.CloneU8 password
            let ws1 ←
              alloc.vec.Vec.push ws (Write.PutUser
                { id := snap.counter.next_id, username := v, password := v1 })
            let v2 ← alloc.vec.CloneVec.clone core.clone.CloneU8 token
            let ws2 ←
              alloc.vec.Vec.push ws1 (Write.PutSession
                { user := snap.counter.next_id, token := v2 })
            ok (core.result.Result.Ok (ws2, Reply.Registered
              snap.counter.next_id))
      else ok (core.result.Result.Err Error.BadUsername)
    else ok (core.result.Result.Err Error.RegistrationClosed)
  | Command.ChangePassword current_ok new_password =>
    let o ← signed_in snap actor
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some u =>
      if current_ok
      then
        let o1 ← find_user snap.users u
        match o1 with
        | none => ok (core.result.Result.Err Error.Unauthenticated)
        | some u1 =>
          let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 new_password
          let v1 ← one (Write.PutUser { u1 with password := v })
          ok (core.result.Result.Ok (v1, Reply.Done))
      else ok (core.result.Result.Err Error.WrongPassword)
  | Command.DeleteAccount password_ok =>
    let o ← signed_in snap actor
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some u =>
      if require_reauth
      then
        if password_ok
        then
          let ws ←
            alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.DelSession u)
          let ws1 ← alloc.vec.Vec.push ws (Write.DelRecordsOf u)
          let ws2 ← alloc.vec.Vec.push ws1 (Write.DelUser u)
          ok (core.result.Result.Ok (ws2, Reply.Done))
        else ok (core.result.Result.Err Error.WrongPassword)
      else
        let ws ←
          alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.DelSession u)
        let ws1 ← alloc.vec.Vec.push ws (Write.DelRecordsOf u)
        let ws2 ← alloc.vec.Vec.push ws1 (Write.DelUser u)
        ok (core.result.Result.Ok (ws2, Reply.Done))
  | Command.AddRecords records =>
    let o ← signed_in snap actor
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some u =>
      let b ← all_fit snap.settings.max_record_size records
      if b
      then
        let v ← to_writes u records
        ok (core.result.Result.Ok (v, Reply.Done))
      else ok (core.result.Result.Err Error.RecordTooLarge)
  | Command.NextRecords host tag start count =>
    let o ← signed_in snap actor
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some u =>
      let v ← next_records snap.records u host tag start count
      ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Records v))
  | Command.Status =>
    let o ← signed_in snap actor
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some u =>
      let v ← status_of snap.records u
      ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Status v))
  | Command.DeleteStore =>
    let o ← signed_in snap actor
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some u =>
      let v ← one (Write.DelRecordsOf u)
      ok (core.result.Result.Ok (v, Reply.Done))

