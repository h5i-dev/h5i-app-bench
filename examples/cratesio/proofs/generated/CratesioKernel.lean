def crate_ok (t : Token) (krate : Option Std.U64) : Result Bool := do
  if t.legacy
  then ok true
  else
    match t.krate with
    | none => ok true
    | some k => match krate with
                | none => ok false
                | some c => ok (k = c)

/-- [cratesio_kernel::check_scope]:
    Source: 'examples/cratesio/kernel/src/lib.rs', lines 532:0-545:1
