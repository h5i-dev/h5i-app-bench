def check_scope
  (token : Option Token) (allow_token : Bool) (e : Endpoint)
  (krate : Option Std.U64) :
  Result (core.result.Result Unit Error)
  := do
  match token with
  | none => ok (core.result.Result.Ok ())
  | some t =>
    if allow_token
    then
      let b ← endpoint_ok t e
      if b
      then
        let b1 ← crate_ok t krate
        if b1
        then ok (core.result.Result.Ok ())
        else ok (core.result.Result.Err Error.ScopeMismatch)
      else ok (core.result.Result.Err Error.ScopeMismatch)
    else ok (core.result.Result.Err Error.TokenNotAllowed)

