    match e with
    | Endpoint.Unscoped => ok false
    | Endpoint.PublishNew => ok t.publish_new
    | Endpoint.PublishUpdate => ok t.publish_update
    | Endpoint.Yank => ok t.yank
    | Endpoint.ChangeOwners => ok t.change_owners

