def signed_in
  (s : Snapshot) (p : Principal) (token : Option Token) :
  Result (core.result.Result Login Error)
  := do
  let o ← find_user s.users p.user
  match o with
  | none => ok (core.result.Result.Err Error.Unauthenticated)
  | some u =>
    let b ← is_locked u p.now
